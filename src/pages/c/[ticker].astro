---
import BaseLayout from "../../layouts/BaseLayout.astro";
import fundamentals from "../../data/fundamentals.json";
import proxyComp from "../../data/proxyComp.json";
import voteResults from "../../data/voteResults.json";
import Scorecard from "../../components/Scorecard.astro";
import Portrait from "../../components/Portrait.astro";
import TenYear from "../../components/TenYear.astro";
import SectionBar from "../../components/SectionBar.astro";
import CapitalAllocation from "../../components/CapitalAllocation.astro";
import CurrentPosition from "../../components/CurrentPosition.astro";
import Peers from "../../components/Peers.astro";
import BusinessRead from "../../components/BusinessRead.astro";
import Segments from "../../components/Segments.astro";
import OwnersRead from "../../components/OwnersRead.astro";
import Capital from "../../components/Capital.astro";
import ActHeader from "../../components/ActHeader.astro";
import Comp from "../../components/Comp.astro";
import Valuation from "../../components/Valuation.astro";
import CompareLink from "../../components/CompareLink.astro";
import OwnerEarningsBridge from "../../components/OwnerEarningsBridge.astro";
import DebtMaturity from "../../components/DebtMaturity.astro";
import Drivers from "../../components/Drivers.astro";
import LeaseObligations from "../../components/LeaseObligations.astro";
import Acquisitions from "../../components/Acquisitions.astro";
import FollowButton from "../../components/FollowButton.astro";
import Cite from "../../components/Cite.astro";
import language from "../../data/language.json";
import segmentsData from "../../data/segments.json";
import { classify } from "../../lib/archetype.mjs";
import { businessPhrase, weakLede, pickNote } from "../../lib/business.mjs";
import { compositionSentence } from "../../lib/segments.mjs";
import { selectPeers } from "../../lib/peers.mjs";
import notes from "../../data/notes.json";
import adrFundamentals from "../../data/fundamentals.adr.json";
import jpFundamentals from "../../data/fundamentals.jp.json";
import euFundamentals from "../../data/fundamentals.eu.json";
import { manualOrder, manualHref } from "../../lib/manual.mjs";
import { industryOrder, chapterMemberHref } from "../../lib/chapters.mjs";
import { getCollection } from "astro:content";
import { ORG, SITE_URL, companyDataset, corporationNode, breadcrumbList } from "../../lib/seo.mjs";
import { dataAsOf } from "../../lib/freshness.mjs";
import adrRatios from "../../data/adrRatios.json";
import ogImages from "../../data/ogImages.json";
import wire from "../../data/wire.json";
import { perfLine, perfNote } from "../../lib/wirePerf.mjs";

// ADRs (foreign 20-F filers) carry US-style tickers and the same record shape, so they get the same
// /c/[ticker] page as a US company; only the data source and currency differ. The two pools are
// merged for path generation (inline below, since getStaticPaths runs isolated from the frontmatter
// body) and for the lookup.
export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  const companies = [...(fundamentals.companies || []), ...(adrFundamentals.companies || [])];
  const tickers = new Set([
    ...companies.map((c) => String(c.ticker || "").toUpperCase()),
    ...articles.flatMap((a) => a.data.tickers.map((t) => t.toUpperCase())),
  ]);
  tickers.delete("");
  return Array.from(tickers).map((ticker) => ({ params: { ticker } }));
}

const allCompanies = [...(fundamentals.companies || []), ...(adrFundamentals.companies || [])];

const ticker = String(Astro.params.ticker || "").toUpperCase();

const fund =
  allCompanies.find((c) => String(c.ticker || "").toUpperCase() === ticker) || null;

// Peers, found once and shared: both the peer table and the scorecard's peer context read the same set,
// and the universe scan runs a single time per page rather than once per component.
//
// THE UNIVERSE IS EVERY POOL (owner ruling, 2026-07-27: "it's okay for peers groups to cross borders,
// these companies compete in real life"). It used to be fundamentals.companies alone — the US pool —
// while line 63 above merged US and ADR to build the PAGES. So 742 foreign filers got a bench drawn
// from a universe their own competitors were not in, under a heading linking to a /groupings table
// that holds all four pools: Taiwan Semiconductor's peer table could not contain ASML, and ASML's
// could not contain Tokyo Electron. A pool is a fact about which regulator a company files with, and
// a reader comparing chipmakers does not care.
const PEER_UNIVERSE = [
  ...(fundamentals.companies || []),
  ...(adrFundamentals.companies || []),
  ...(jpFundamentals.companies || []),
  ...(euFundamentals.companies || []),
];
const peerResult = fund ? selectPeers(fund, PEER_UNIVERSE) : { peers: [], basis: "model" };

const related = (
  await getCollection("articles", ({ data }) =>
    (import.meta.env.PROD ? !data.draft : true) &&
    data.tickers.some((t) => t.toUpperCase() === ticker)
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const name = fund?.name || "";
const cls = fund ? classify(fund) : null;
const isFin = !!cls && ["financial", "reit"].includes(cls.sector.key);
// Lede priority, so the hero always opens with the most concrete accurate thing: a reviewed,
// model-drafted note (the names a human has written up, governed by docs/qualitative-doctrine.md)
// first; else the filing's own description when it actually describes the business; else the
// company's own revenue mix (so a giant that opens on a mission statement — Amazon, Apple — still
// says what it does, from its reportable segments); else the computed one-line industry
// characterization. BusinessRead recomputes the same chain to show the complement, never a repeat.
const note = fund ? pickNote(notes, ticker) : null;
const rawBiz = language?.companies?.[ticker]?.business || null;
const seg = fund ? segmentsData?.companies?.[ticker] : null;
const bizLine = fund
  ? (note?.whatItIs || (rawBiz && !weakLede(rawBiz) ? rawBiz : (compositionSentence(seg) || businessPhrase(fund))))
  : rawBiz;
// The company's own "in brief": up to two more verbatim sentences naming what it sells, kept
// distinct from the lede by the detector (businessBrief). Sits under the lede so the whole opening
// reads in the company's own voice. Empty, and so absent, until the filings re-fetch populates it.
// Each sentence runs the same guards the lede does (weakLede folds in the truncation-artifact
// guard), so a splitter fragment ("Morgan and Chase brands, the Firm serves..."), a regulatory
// boilerplate line or a product spec list is dropped rather than rendered broken; the stored data
// itself is repaired at the next filings re-fetch.
const brief = fund ? (language?.companies?.[ticker]?.brief || []).filter((s) => s && s !== bizLine && !weakLede(s)) : [];

const fmtDate = (d) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });

// The most recent quarterly filing (10-Q) the wire holds for this company: the interim read the ten-year
// annual record below cannot carry. A quarter always covers a period past the last annual, so it never
// restates the record. wire.json is joined here at build (442 items, keyed by ticker). Its figures and the
// company's own MD&A sentence are shown exactly as /wire renders them (the same perfLine helper); where a
// 10-Q carried no comparable XBRL, the filing and its EDGAR source stand alone. Absent, nothing renders.
const recentFiling = fund
  ? ((wire?.items || [])
      .filter((it) => String(it.ticker || "").toUpperCase() === ticker && /^10-Q/.test(it.form || ""))
      .sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0))[0] || null)
  : null;
const recentLine = recentFiling ? perfLine(recentFiling.performance) : null;
// The filed date links the day's wire page — the entry sits among that day's filers — but only
// when the day page exists (the wire archive starts 2026-02-17; an older date would link a 404).
const wireDayFiles = import.meta.glob("../../data/wire-days/*.json");
const wireDayHref = recentFiling?.date && Object.keys(wireDayFiles).some((p) => p.endsWith(`/${recentFiling.date}.json`)) ? `/wire/${recentFiling.date}` : null;


// This company's place in the Manual (docs/discovery-design.md feature 2): the previous and next
// ticker in its own volume, so a reader can proceed page to page the way the manuals were read.
// Same memoized order the manual pages render; article-only tickers have no entry and no links.
const man = manualOrder(fundamentals.companies || [], adrFundamentals.companies || [], jpFundamentals.companies || []);
const manEntry = fund ? man.neighbors[`us:${ticker}`] || man.neighbors[`adr:${ticker}`] || null : null;
const manPlace = manEntry ? manualHref(manEntry.volKey, ticker) : null;

// And its place in its industry chapter (feature 3): the previous and next ticker in the same
// industry, A to Z across all three pools (a neighbor can be a Japanese name), plus the chapter
// the hero's industry chip links to. Same memoized order the chapter pages render.
const indOrder = industryOrder(fundamentals.companies || [], adrFundamentals.companies || [], jpFundamentals.companies || []);
const indEntry = fund ? indOrder.neighbors[`us:${ticker}`] || indOrder.neighbors[`adr:${ticker}`] || null : null;
const chapterHref = indEntry ? `/industries/${indEntry.slug}` : null;

// Machine-readable identity for the scorecard: what the page is (a record, not a rating) and which
// corporation it is about, so a search or answer engine can connect the ticker to this page directly.
const pageDescription = fund
  ? `${name} (${ticker}): the ten-year owner's record. Revenue, margins, returns on capital, owner earnings, buybacks, and debt, every figure traced to the company's own filings.`
  : undefined;
// The record's fiscal-year span, for the Dataset's temporalCoverage.
const histYears = fund ? (fund.history || []).map((h) => h.fy).filter(Boolean) : [];
const spanFrom = histYears.length ? Math.min(...histYears) : fund?.fy || null;
const spanTo = histYears.length ? Math.max(...histYears) : fund?.fy || null;
const pageUrl = `${SITE_URL}/c/${ticker}`;

// Three machine-readable blocks: the WebPage (what this is — a record, not a rating, and which
// corporation it is about, anchored to the SEC CIK); the Dataset (the ten-year record, free and
// licensed to the site's terms, with its JSON twin as the distribution — the shape Google Dataset
// Search indexes); and the BreadcrumbList (the industry-chapter lattice the page already builds).
const pageJsonLd = fund
  ? [
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: `${name} (${ticker}), the owner's record`,
        description: pageDescription,
        about: corporationNode({ name, ticker, cik: fund.cik, url: pageUrl }),
        publisher: ORG,
        // Freshness from the pipeline's own stamp, never the build clock: crawlers learn to trust
        // (or distrust) lastmod-style signals fast, and 3,550 pages "updated today" every deploy
        // would poison the signal.
        ...(dataAsOf ? { dateModified: dataAsOf } : {}),
        ...(fund.fy ? { temporalCoverage: `FY${fund.fy}` } : {}),
      },
      companyDataset({
        ticker,
        name,
        cik: fund.cik,
        pageUrl,
        jsonUrl: `${pageUrl}.json`,
        spanFrom: spanFrom ? `${spanFrom}` : null,
        spanTo: spanTo ? `${spanTo}` : null,
        asOf: dataAsOf || null,
        sourceUrl: fund.sourceUrl || null,
      }),
      breadcrumbList([
        { name: "Owner Scorecard", url: "/" },
        indEntry ? { name: indEntry.label, url: chapterHref } : null,
        { name: `${name} (${ticker})`, url: pageUrl },
      ].filter(Boolean)),
    ].filter(Boolean)
  : null;

// The link preview (docs/marketing-plan.md, build-list item 2): the most-shared names carry their
// own card — ticker, name, the record's sparkline, drawn at build by scripts/buildOgImages.mjs and
// listed in the committed manifest. Every other page keeps the site default via the layout's
// fallback, so a missing card can never point at a missing file.
const ogImage = fund && ogImages.tickers.includes(ticker) ? `/og/${ticker}.png` : undefined;
const ogImageAlt = ogImage ? `${name} (${ticker}): the owner's record at a glance.` : undefined;
---

<BaseLayout title={`${ticker}, Owner Scorecard`} description={pageDescription} jsonLd={pageJsonLd} ogImage={ogImage} ogImageAlt={ogImageAlt}>
  <p class="back">
    {/* 2026-07-26 (UX audit, docs/ux-audit-findings.md): this pointed at "/", which is the day's
        front page and lists no companies beyond the day's filers. The page that IS all companies
        is /catalog, so the label now matches the destination. */}
    <a href="/catalog">← All companies</a>
    {manEntry ? (
      <span class="manNav">
        {manEntry.prev ? <a href={`/c/${manEntry.prev}`}>← {manEntry.prev}</a> : null}
        <a class="manIn" href={manPlace}>Manual</a>
        {manEntry.next ? <a href={`/c/${manEntry.next}`}>{manEntry.next} →</a> : null}
      </span>
    ) : null}
    {indEntry ? (
      <span class="manNav">
        {indEntry.prev ? (
          <a href={chapterMemberHref(indEntry.prev)} title={`Previous in ${indEntry.label}`}>← {indEntry.prev.ticker}</a>
        ) : null}
        <a class="manIn" href={chapterHref} title={`The ${indEntry.label} chapter`}>{indEntry.label}</a>
        {indEntry.next ? (
          <a href={chapterMemberHref(indEntry.next)} title={`Next in ${indEntry.label}`}>{indEntry.next.ticker} →</a>
        ) : null}
      </span>
    ) : null}
  </p>

  <header class="hero" id="top">
    <h1>{ticker}{name ? `, ${name}` : ""}</h1>
    {cls ? (
      <div class="ident">
        {chapterHref ? (
          <a class="ichip" href={chapterHref} title={`The ${cls.industry.label} chapter`}>{cls.industry.label}</a>
        ) : (
          <span class="ichip">{cls.industry.label}</span>
        )}
        <span class="model">{cls.sector.adj}</span>
        {cls.overlays.map((o) => <span class="ov">{o.label}</span>)}
      </div>
    ) : null}
    {bizLine ? <p class="lede">{bizLine}</p> : null}
    {brief.length ? <div class="leadMore">{brief.map((s) => <p>{s}</p>)}</div> : null}
    {fund ? (
      <div class="meta">
        Latest annual: FY{fund.fy} {fund.form}
        {fund.market === "ADR" ? (
          <span class="adrBasisMeta">
            {fund.currency && fund.currency !== "USD" ? ` · figures as filed, in ${fund.currency}` : ""}
            {((r) => (r?.basis === "ads" && r.ratio ? ` · 1 ADS = ${r.ratio} ordinary share${r.ratio === 1 ? "" : "s"}` : r?.basis === "direct" ? " · US listing is the ordinary share" : ""))(adrRatios?.companies?.[ticker])}
          </span>
        ) : null}
        <FollowButton ticker={ticker} />
      </div>
    ) : null}
    {!fund && related.length ? <p class="lede">Not yet in the catalog. The Notes below discuss it.</p> : null}
    {fund && related.length ? (
      <p class="noteFlag">
        Read in Notes: <a href={`/notes/${related[0].id}`}>{related[0].data.title}</a>, {fmtDate(related[0].data.date)}
      </p>
    ) : null}
  </header>

  {fund ? (
    <SectionBar
      id="top"
      label={ticker}
      sub={name || ""}
      links={[
        { href: "#act-what", label: "The business" },
        { href: "#act-record", label: "The record" },
        { href: "#act-quality", label: "Quality" },
        { href: "#act-price", label: "Price" },
        ...(related.length ? [{ href: "#sec-writing", label: "Notes" }] : []),
      ]}
    />
  ) : null}

  {fund ? (
    <section id="act-what" class="actGroup">
      <ActHeader n="I" title="The business" lede="What it sells, where the money comes from, the kind of company it is." />
      <div id="sec-snapshot" class="sec"><Portrait company={fund} /></div>
      <div id="sec-business" class="sec"><BusinessRead company={fund} /></div>
      <div id="sec-mix" class="sec"><Segments company={fund} /></div>
    </section>
  ) : null}

  {fund ? (
    <section id="act-record" class="actGroup">
      <ActHeader n="II" title="The record" lede="Ten years of arithmetic, read across the cycle." />
      {recentFiling && (recentLine || recentFiling.performance?.driver) ? (
        <div id="sec-recent" class="sec recent">
          <div class="recentHead">
            <span class="recentTag">Most recent quarterly filing</span>
            <span class="recentForm">{recentFiling.form}</span>
            <span class="recentWhen">filed {wireDayHref ? <a href={wireDayHref}>{fmtDate(new Date(recentFiling.date + "T00:00:00Z"))}</a> : fmtDate(new Date(recentFiling.date + "T00:00:00Z"))}</span>
            {recentFiling.url ? (
              <a class="recentSrc" href={recentFiling.url} target="_blank" rel="noopener noreferrer">Source at SEC EDGAR &rarr;</a>
            ) : null}
          </div>
          {recentLine ? <p class="recentLine">{recentLine}</p> : null}
          {recentFiling.performance?.driver ? (
            <p class="recentQuote">&ldquo;{recentFiling.performance.driver}&rdquo;</p>
          ) : null}
          <p class="recentNote">
            {recentLine
              ? perfNote(!!recentFiling.performance?.driver)
              : "No comparable figures were tagged in this filing's XBRL."}
          </p>
        </div>
      ) : null}
      <div id="sec-record" class="sec"><TenYear company={fund} /></div>
      <div id="sec-drivers" class="sec"><Drivers company={fund} /></div>
      {/* CUT 2026-07-25 (UX audit, docs/ux-audit-findings.md): RecordCharts and
          OwnerEarningsVsIncome redrew rows of the ten-year table immediately above as pictures. A
          reader who has just read the numbers does not need them plotted, and a page that says
          everything says nothing.
          KEPT, against the audit's recommendation: CapitalAllocation, which the audit grouped with
          them. It is not a redrawing — it carries the average price paid for stock across the
          record, which appears nowhere in the table — and a published note cites it as evidence
          (the-moat-and-the-multiple links /c/ADBE#sec-capalloc for Adobe's $357.36 average).
          Cutting it would have broken a live argument in the ledger.
          OwnerEarningsBridge stays for the same reason: it shows the derivation line by line. */}
      {!isFin ? <div id="sec-capalloc" class="sec"><CapitalAllocation company={fund} /></div> : null}
      {!isFin ? <div id="sec-bridge" class="sec"><OwnerEarningsBridge company={fund} /></div> : null}
    </section>
  ) : null}

  {fund ? (
    <section id="act-quality" class="actGroup">
      <ActHeader n="III" title="Quality &amp; stewardship" lede="Returns, the balance sheet, capital allocation, and pay." />
      <div id="sec-scorecard" class="sec"><Scorecard company={fund} sample={fundamentals.sample} peers={peerResult.peers} /></div>
      <div id="sec-current" class="sec"><CurrentPosition company={fund} /></div>
      <div id="sec-debt" class="sec"><DebtMaturity company={fund} /></div>
      <div id="sec-leases" class="sec"><LeaseObligations company={fund} /></div>
      {!isFin ? <div id="sec-capital" class="sec"><Capital company={fund} /></div> : null}
      <div id="sec-acq" class="sec"><Acquisitions company={fund} /></div>
      <div id="sec-pay" class="sec"><Comp company={fund} pay={proxyComp.companies?.[ticker] ?? null} /></div>
      {/* CUT 2026-07-25 (UX audit): Inversion ran six disconfirming tests and reported the result.
          Across the built site it rendered on 2,139 pages and on 2,112 of them — 98.7 percent —
          the entire output was that nothing had been found. A section whose usual message is its
          own emptiness teaches a reader to scroll past it, which is exactly the wrong training for
          the one page in eighty where a test does fire. The disconfirming tests are worth keeping;
          they belong beside the figure they concern, not in a panel of their own. */}
      <div id="sec-changes" class="sec"><OwnersRead company={fund} /></div>
      <div id="sec-peers" class="sec"><Peers company={fund} peers={peerResult.peers} basis={peerResult.basis} subsector={peerResult.subsector} shelfNoun={peerResult.shelfNoun} sector={peerResult.sector} /></div>
    </section>
  ) : null}

  {fund ? (
    <section id="act-price" class="actGroup">
      <ActHeader n="IV" title="The price" lede="What a price has to assume." />
      <div id="sec-price" class="sec"><Valuation company={fund} /><CompareLink company={fund} />
        {voteResults.companies?.[ticker] ? (
          <p class="ownersLink"><a href={`/owners/${ticker}`}>The owners of {ticker}: the meeting and the votes →</a></p>
        ) : null}
      </div>
    </section>
  ) : null}

  {related.length ? (
    <section id="sec-writing" class="sec">
      <h2>Notes</h2>
      <ul class="history">
        {related.map((a) => (
          <li>
            <span class="hDate">{fmtDate(a.data.date)}</span>
            <span class="hLinks"><a href={`/notes/${a.id}`}>{a.data.title}</a></span>
          </li>
        ))}
      </ul>
    </section>
  ) : null}

  {!fund && !related.length ? <p>Nothing here for {ticker} yet.</p> : null}

  {fund ? (
    <Cite citation={`Owner Scorecard, "${name} (${ticker}), the owner's record," ${new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, "")}${dataAsOf ? `, data as of ${dataAsOf}` : ""}.`} />
  ) : null}

  {manEntry ? (
    <p class="manFoot">
      Manual order: {manEntry.prev ? <a href={`/c/${manEntry.prev}`}>← {manEntry.prev}</a> : null}
      <a href={manPlace}>its page in the Manual</a>
      {manEntry.next ? <a href={`/c/${manEntry.next}`}>{manEntry.next} →</a> : null}
    </p>
  ) : null}

  {indEntry ? (
    <p class="manFoot indFoot">
      Industry order: {indEntry.prev ? (
        <a href={chapterMemberHref(indEntry.prev)} title={`Previous in ${indEntry.label}`}>← {indEntry.prev.ticker}</a>
      ) : null}
      <a href={chapterHref}>the {indEntry.label} chapter</a>
      {indEntry.next ? (
        <a href={chapterMemberHref(indEntry.next)} title={`Next in ${indEntry.label}`}>{indEntry.next.ticker} →</a>
      ) : null}
    </p>
  ) : null}

  <style>
    .ownersLink { margin: 14px 0 0; padding-top: 10px; border-top: 1px solid var(--rule); }
    .ownersLink a { font-family: var(--sans); font-weight: 600; font-size: 14px; }
    .back { margin: 0 0 10px; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .manNav { display: inline-flex; gap: 12px; align-items: baseline; font-size: 12.5px; }
    .manNav a { font-family: var(--sans); font-weight: 600; }
    .manNav .manIn { font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
    .manNav .manIn:hover { color: var(--accent); }
    .manFoot { display: flex; gap: 14px; align-items: baseline; justify-content: center; font-size: 12.5px; border-top: 1px solid var(--rule); margin-top: 20px; padding-top: 12px; flex-wrap: wrap; }
    .manFoot a { font-family: var(--sans); font-weight: 600; }
    .indFoot { border-top: 0; margin-top: 6px; padding-top: 0; }
    .hero h1 { margin: 0; }
    .ident { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: 8px 0 0; }
    .ichip { font-family: var(--sans); font-size: 11.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); border: 1px solid var(--rule-strong); padding: 2px 8px; }
    a.ichip { text-decoration: none; }
    a.ichip:hover { color: var(--accent); border-color: var(--accent); }
    .model { font-family: var(--sans); font-size: 11.5px; letter-spacing: 0.03em; color: var(--muted); }
    .ident .ov { font-family: var(--sans); font-size: 10px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--warn); border: 1px solid var(--warn); padding: 1px 6px; }
    .lede { font-family: var(--serif); font-size: clamp(16px, 2.4vw, 19px); line-height: 1.5; color: var(--ink-soft); margin: 12px 0 0; max-width: 70ch; }
    /* The "in brief" continuation: the company's own follow-on sentences, set quieter than the lede
       so the one-line characterization still leads. */
    .leadMore { margin: 8px 0 0; max-width: 72ch; }
    .leadMore p { font-family: var(--serif); font-size: 14.5px; line-height: 1.55; color: var(--muted); margin: 6px 0 0; }
    .meta { color: var(--ink-dim); font-size: 13px; margin-top: 8px; }
    .noteFlag { font-family: var(--serif); font-size: 14.5px; color: var(--ink-soft); margin: 10px 0 0; }
    .noteFlag a { font-weight: 600; }


    /* The sticky company bar lives in SectionBar.astro (extracted 2026-07-31, UX survey item
       16, so the JP and EU pages share it); the scroll margins its height implies stay here. */
    .sec { scroll-margin-top: 52px; }
    .actGroup { scroll-margin-top: 46px; }
    /* The first act follows the sticky bar directly, so it needs no big top gap; later acts
       keep the divider the component draws. */
    .actGroup:first-of-type :global(.actHead) { margin-top: 14px; }

    h2 { border-bottom: 1px solid var(--rule); padding-bottom: 4px; margin-top: 24px; }
    .history { list-style: none; padding-left: 0; margin: 0; }
    .history li { padding: 10px 0; display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--rule); }
    .hDate { color: var(--muted); flex: 0 0 auto; }
    .hLinks { flex: 1 1 auto; text-align: right; }

    /* The freshest filing, sitting above the ten-year record it cannot yet be part of. A quiet card,
       not a callout: the record is the point, this is the note that a quarter has since been filed. */
    .recent { border: 1px solid var(--rule-strong); border-left: 3px solid var(--accent); padding: 12px 14px; margin: 4px 0 22px; }
    .recentHead { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; }
    .recentTag { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
    .recentForm { font-family: var(--sans); font-weight: 700; font-size: 12.5px; letter-spacing: 0.02em; color: var(--ink); }
    .recentWhen { font-size: 12.5px; color: var(--muted); }
    .recentSrc { font-family: var(--sans); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; margin-left: auto; flex: 0 0 auto; }
    .recentLine { font-family: var(--serif); font-size: 15px; line-height: 1.5; color: var(--ink); margin: 9px 0 0; }
    .recentQuote { font-family: var(--serif); font-style: italic; font-size: 14px; line-height: 1.6; color: var(--ink-dim); margin: 8px 0 0; max-width: 72ch; }
    .recentNote { font-size: 11.5px; color: var(--muted); margin: 8px 0 0; }
    @media (max-width: 560px) { .recentSrc { margin-left: 0; } }
  </style>

</BaseLayout>
