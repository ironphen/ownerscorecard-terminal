---
// One sector as ONE comparative table (owner directive, 2026-07-25): the whole of Financials, or
// the whole of Industrials, every member of every industry in it, across the US, ADR and Japanese
// pools, on the columns that sector's members can answer as a whole.
//
// A SECTOR TABLE IS A DIFFERENT INSTRUMENT FROM AN INDUSTRY TABLE, NOT A BIGGER ONE. At this scale
// the reader is asking how big, how profitable, how much capital, how much debt, across many kinds
// of business at once, and those are the only lines that can be asked of all of them honestly. The
// specialist columns a kind of business is really read on (what is contracted for next year in
// software, inventory days in semiconductors, deposits in banks, the medical loss ratio in a health
// plan) appear when the reader narrows to that industry. That is why the second control is a change
// of instrument rather than a convenience, and the prose below says so plainly.
//
// The column sets are frozen in lib/groupingColumns.mjs with the measurement that chose them, and a
// drift check in `npm test` fails if a data refresh moves the answer, so a published page's columns
// can never change without a person deciding they should.
//
// Everything else is the industry table verbatim: the same frozen-pane markup, the same sticky
// header, the same sort script and its ?sort= URL contract, the same compare picker, the same
// currency doctrine. Nothing here is a second table.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GroupingPicker from "../../../components/GroupingPicker.astro";
import fundamentals from "../../../data/fundamentals.json";
import adrData from "../../../data/fundamentals.adr.json";
import jpData from "../../../data/fundamentals.jp.json";
import adrRatios from "../../../data/adrRatios.json";
import rates from "../../../data/rates.json";
import { industryLabelOf } from "../../../lib/shelves.mjs";
import { secondaryListings } from "../../../lib/listings.mjs";
import { usdTerms, groupingCells, revenueSortUsd, groupLine } from "../../../lib/groupingColumns.mjs";
import { SECTOR_INDEX, sectorIndexBySlug } from "../../../lib/groupingsIndex.mjs";
import { FAMILIES, groupingBySlug } from "../../../lib/groupingColumns.mjs";
import { dataAsOf, fmtAsOf } from "../../../lib/freshness.mjs";

export function getStaticPaths() {
  return SECTOR_INDEX.map((s) => ({ params: { slug: s.slug } }));
}

const slug = String(Astro.params.slug || "");
const sector = sectorIndexBySlug.get(slug);
if (!sector) throw new Error(`groupings/sector: no sector for slug "${slug}"`);
const columns = sector.columns;

// Which industries in this sector are actually read on a DIFFERENT instrument. The page used to
// promise that narrowing brings specialist columns, full stop, and the verifier measured that
// false for 63 of 101 industries holding 52% of the library: most industries use the general
// family and their table shows exactly these columns over fewer companies. Narrowing is still
// worth doing there, but it changes the company list rather than the instrument, and the prose
// now says which of the two a reader is getting. A page that promises an instrument it does not
// deliver teaches a reader to stop believing the ones it does.
const sectorKeys = new Set(columns.map((c) => c.key));
const specialistIndustries = (sector.industries || [])
  .map((ind) => {
    const g = groupingBySlug.get(ind.slug);
    const fam = g && FAMILIES[g.family];
    if (!fam) return null;
    const extra = fam.columns.filter((c) => !sectorKeys.has(c.key));
    return extra.length ? { noun: g.noun, slug: ind.slug, extra: extra.length } : null;
  })
  .filter(Boolean)
  .sort((a, b) => b.extra - a.extra);

// The industry a row belongs to is its spine on this page, so the label carries its own table's
// address: the natural next step down is that industry's table, not its reading chapter, and the
// chapter stays one hop from there. This also makes the Industry column a working second select for
// a reader with no JavaScript.
const industryByLabel = new Map(sector.industries.map((ind) => [ind.noun, ind]));

// Members across the three pools; presence on a shelf in this sector is the only criterion, exactly
// the criterion the industry tables use.
const pools = [
  ["us", fundamentals.companies || []],
  ["adr", adrData.companies || []],
  ["jp", jpData.companies || []],
];
// Secondary listings are excluded from every comparative surface: a preferred series, a baby bond
// or a warrant shares its issuer's CIK and would otherwise appear as another row beside the common
// stock, so a shelf of 40 businesses reads as 47 and the same company is compared with itself. They
// keep their pages; they stop counting. See lib/listings.mjs for why the test is the CIK and never
// the ticker shape.
const secondaryByPool = new Map(pools.map(([k, pool]) => [k, secondaryListings(pool)]));
const rows = [];
let convertedCount = 0;
let asFiledCount = 0;
for (const [poolKey, pool] of pools) {
  for (const c of pool) {
    const label = industryLabelOf(c);
    const ind = industryByLabel.get(label);
    if (!ind) continue;
    const ticker = String(c.ticker || "").toUpperCase();
    if (!ticker) continue;
    if (secondaryByPool.get(poolKey)?.has(ticker)) continue;
    const terms = usdTerms(c, adrRatios, rates);
    if (terms.converted) convertedCount++;
    if (terms.asFiled) asFiledCount++;
    rows.push({
      ticker,
      name: c.name || ticker,
      href: (poolKey === "jp" ? "/jp/" : "/c/") + ticker,
      industry: label,
      industryHref: `/groupings/${ind.slug}`,
      // The column list comes from the TABLE; the withholding always comes from the ROW's own kind
      // of business, which is why the row's own family is what goes in here and never a synthetic
      // sector one. That is what keeps a property trust's net debt readable on a table it shares
      // with companies that are not property trusts.
      cells: groupingCells(c, ind.family, terms, columns),
      revSort: revenueSortUsd(c, terms),
    });
  }
}

// The default order: latest-year revenue in USD, largest first. Size is an objective fact, and it
// is the only order this page arrives in. A member without a sortable revenue goes to the back,
// alphabetical by ticker there like every tie.
rows.sort((a, b) => {
  const ra = a.revSort == null ? -Infinity : a.revSort;
  const rb = b.revSort == null ? -Infinity : b.revSort;
  return rb - ra || (a.ticker < b.ticker ? -1 : a.ticker > b.ticker ? 1 : 0);
});

const hasForeign = convertedCount > 0 || asFiledCount > 0;
const revenueColIdx = columns.findIndex((col) => col.key === "revenue"); // always 0: every sector set opens on revenue
const refreshed = fmtAsOf(dataAsOf);

// The group line, with the members each fragment was read on. A median over a mixed sector is a
// weaker statement than one over a single industry, and the count is what keeps it honest.
const groupSentence = groupLine(columns, rows.map((r) => r.cells), { readCounts: true });
const colList = columns.map((c) => c.label).join(", ");
const description = `${sector.name}: all ${rows.length.toLocaleString()} companies the library holds across ${sector.industries.length} industries, in one comparative table on ${colList}. Every column sortable, largest first by revenue.`;
---

<BaseLayout title={`${sector.name}, a sector table, Owner Scorecard`} description={description}>
  <p class="back"><a href="/groupings">The groupings</a> <span class="sep">/</span> <span class="crumbHere">{sector.name}</span></p>

  <GroupingPicker view="sector" sector={sector.name} />

  <header class="hero">
    <span class="kicker">A sector · a comparative table</span>
    <h1>{sector.name}</h1>
    <p class="range">
      Every company the library holds in this sector, {rows.length.toLocaleString()} of them across
      {sector.industries.length} industries and the library&rsquo;s three pools, one row each.
      The columns are the lines this sector&rsquo;s members can all answer, so a bank and an exchange,
      or a chipmaker and a software company, can be read down the same column without either being
      flattered.
      {specialistIndustries.length ? (
        <>
          {" "}Some kinds of business are read on instruments this table cannot carry, and those appear
          when you narrow to them: {specialistIndustries.map((n, i) => (
            <>{i > 0 ? (i === specialistIndustries.length - 1 ? " and " : ", ") : ""}<a href={`/groupings/${n.slug}`}>{n.noun}</a></>
          ))}. Pick one in the second control above, or follow any Industry cell in the table.
          Elsewhere in this sector the industry table shows these same columns over fewer companies.
        </>
      ) : (
        <> The industry tables in this sector show these same columns over fewer companies: narrowing
        changes the company list rather than the instrument.</>
      )}
    </p>
    <p class="range">
      Rows open largest first by latest-year revenue, and every column sorts both ways; a sorted view
      keeps its order in the address bar. Sorting by Industry gathers the sector into contiguous
      blocks, one industry at a time, if that is how you want to read it. Margins and returns are
      medians over each company&rsquo;s readable record, the through-cycle level rather than one
      year&rsquo;s print. A dash is a figure that could not be read; n/a is one that does not apply to
      that member, which is a refusal rather than a gap, and whole industries here will read n/a where
      a sector column is a category error for the way they earn. Both sit at the back of a sorted
      column.
    </p>
    {refreshed ? <p class="dateline">From the latest filings · data as of {refreshed}.</p> : null}
  </header>

  {groupSentence ? (
    <p class="groupLine">
      {groupSentence}
      <span class="glNote"> Medians of this table&rsquo;s own columns, over the members each applies to{refreshed ? ` · data as of ${refreshed}` : ""}.</span>
    </p>
  ) : null}

  <div class="pickBar">
    <span class="pickHint" id="pickHint">Pick two to four to weigh side by side.</span>
    <a class="cmpGo" id="cmpGo" aria-disabled="true" role="link" tabindex="-1">Compare these →</a>
  </div>

  <div class="tableWrap">
    <table class="grp" id="grpTable">
      <thead>
        <tr>
          <th class="sel" scope="col" aria-label="Pick companies to compare"></th>
          <th class="txt tk" data-t="s" data-key="ticker" scope="col"><button type="button">Ticker <span class="tri"></span></button></th>
          <th class="txt nm" data-t="s" data-key="name" scope="col"><button type="button">Name <span class="tri"></span></button></th>
          {/* The spine of this table. It sorts like any text column, which is how a reader bands the
              sector by industry without any new machinery, and each cell links down to that
              industry's own table. */}
          <th class="txt ind" data-t="s" data-key="industry" scope="col">
            <button type="button">Industry <span class="tri"></span></button>
            <span class="basis">sort to band the sector; each cell opens that industry&rsquo;s table</span>
          </th>
          {columns.map((col, i) => (
            <th class="num" data-t="n" data-key={col.key} scope="col" aria-sort={i === revenueColIdx ? "descending" : undefined}>
              <button type="button">{col.label} <span class="tri">{i === revenueColIdx ? "▼" : ""}</span></button>
              <span class="basis">{col.concept ? <a href={`/concepts#${col.concept}`}>{col.basis}</a> : col.basis}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr id={r.ticker}>
            <td class="sel"><label><input type="checkbox" class="pick" data-tk={r.ticker} aria-label={`Pick ${r.ticker} to compare`} /></label></td>
            <td class="txt tk" data-s={r.ticker}><a href={r.href}>{r.ticker}</a></td>
            <td class="txt nm" data-s={r.name.toLowerCase()}><span class="nmIn"><a href={r.href}>{r.name}</a></span></td>
            <td class="txt ind" data-s={r.industry.toLowerCase()}><a href={r.industryHref}>{r.industry}</a></td>
            {r.cells.map((cell) => (
              <td class={`num${cell.sort == null ? " off" : ""}`} data-s={cell.sort}>{cell.text}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="foot">
    Every figure is recomputed from the company&rsquo;s own SEC or EDINET filings, the same way as on
    its page; the columns name facts, weigh nothing, and form no rank. The three pools this surface
    reads are the US, ADR and Japanese ones, so a count here will not match the European records the
    catalog also holds.
    {hasForeign ? (
      <span>
        {" "}Foreign filers are stated in US dollars at the dated reference rate ({rates.fxAsOf ? `as of ${rates.fxAsOf}` : "dated"})
        so each money column sorts on one basis; their own pages keep the records as filed. A
        foreign filer whose conversion terms are missing shows its money as filed and sorts to the
        back of the column, never a guessed conversion. Ratios and margins are currency-free.
      </span>
    ) : null}
  </p>

  <script is:inline>
    // Column sorting — the same script the industry tables run, unchanged in intent: plain DOM
    // re-ordering of the rows already on the page, nothing fetched, weighted, filtered, highlighted
    // or remembered, and a cell with no sort key goes to the back whichever direction is chosen.
    // The active sort is mirrored into the URL (?sort=<column key>&dir=asc|desc) and read back on
    // load; the default view keeps a clean URL. A sort key that does not exist in this sector's
    // column set simply finds no header and leaves the default order standing.
    (function () {
      var table = document.getElementById("grpTable");
      if (!table || !table.tHead || !table.tBodies.length) return;
      var ths = Array.prototype.slice.call(table.tHead.rows[0].cells);
      var tbody = table.tBodies[0];
      var tkCol = 1; // the ticker column, the explicit tiebreak
      var cur = -1, dir = -1;
      ths.forEach(function (th, i) {
        if (th.getAttribute("aria-sort") === "descending") cur = i;
        var btn = th.querySelector("button");
        if (btn) btn.addEventListener("click", function () { sortBy(i); });
      });
      function keyOf(row, i) { return row.cells[i] ? row.cells[i].getAttribute("data-s") : null; }
      function sortBy(i, want) {
        var numeric = ths[i].getAttribute("data-t") === "n";
        if (want === "asc") dir = 1;
        else if (want === "desc") dir = -1;
        else dir = cur === i ? -dir : numeric ? -1 : 1; // numbers open largest-first, text A-to-Z
        cur = i;
        var rows = Array.prototype.slice.call(tbody.rows);
        rows.sort(function (ra, rb) {
          var a = keyOf(ra, i), b = keyOf(rb, i);
          var c = 0;
          if (a == null && b == null) c = 0;
          else if (a == null) return 1;  // no key: to the back, either direction
          else if (b == null) return -1;
          else if (numeric) c = (parseFloat(a) - parseFloat(b)) * dir;
          else c = (a < b ? -1 : a > b ? 1 : 0) * dir;
          if (c) return c;
          // The explicit tiebreak. Without it the tie order is whatever the previous pass left,
          // which is visible once a reader sorts by Industry to band the sector and then sorts back.
          var ta = keyOf(ra, tkCol) || "", tb = keyOf(rb, tkCol) || "";
          return ta < tb ? -1 : ta > tb ? 1 : 0;
        });
        for (var k = 0; k < rows.length; k++) tbody.appendChild(rows[k]);
        ths.forEach(function (th, k) {
          var tri = th.querySelector(".tri");
          if (tri) tri.textContent = k === i ? (dir === 1 ? "▲" : "▼") : "";
          if (k === i) th.setAttribute("aria-sort", dir === 1 ? "ascending" : "descending");
          else th.removeAttribute("aria-sort");
        });
        syncSortURL(i);
      }
      function syncSortURL(i) {
        try {
          var u = new URL(location.href);
          var key = ths[i].getAttribute("data-key");
          if (!key || (key === "revenue" && dir === -1)) { // the default order: a clean URL
            u.searchParams.delete("sort"); u.searchParams.delete("dir");
          } else {
            u.searchParams.set("sort", key);
            u.searchParams.set("dir", dir === 1 ? "asc" : "desc");
          }
          history.replaceState(null, "", u);
        } catch (e) {}
      }
      try {
        var q = new URL(location.href).searchParams;
        var sk = q.get("sort");
        if (sk) {
          var sd = q.get("dir") === "asc" ? "asc" : "desc";
          for (var si = 0; si < ths.length; si++) {
            if (ths[si].getAttribute("data-key") === sk) { sortBy(si, sd); break; }
          }
        }
      } catch (e) {}
    })();
  </script>

  <script is:inline>
    // The compare picker — the reader picks two to four members and weighs them side by side on
    // /compare. Picking is the reader's own act: it never sorts, never filters, never persists.
    // On a sector table the picks can now cross archetypes, a bank against an exchange against a
    // P&C insurer, which is exactly the comparison a sector view invites; /compare withholds a row
    // that is a category error for one of them, the same way these cells do.
    (function () {
      var table = document.getElementById("grpTable");
      var go = document.getElementById("cmpGo");
      var hint = document.getElementById("pickHint");
      if (!table || !go || !hint) return;
      var picked = [];
      Array.prototype.forEach.call(table.querySelectorAll("input.pick"), function (box) {
        box.addEventListener("change", function () {
          var tk = box.getAttribute("data-tk");
          picked = picked.filter(function (t) { return t !== tk; });
          if (box.checked) picked.push(tk);
          update();
        });
      });
      function update() {
        var n = picked.length;
        if (n >= 2 && n <= 4) {
          go.setAttribute("href", "/compare?c=" + picked.join(","));
          go.removeAttribute("aria-disabled");
          go.removeAttribute("tabindex");
        } else {
          go.removeAttribute("href");
          go.setAttribute("aria-disabled", "true");
          go.setAttribute("tabindex", "-1");
        }
        hint.textContent =
          n === 0 ? "Pick two to four to weigh side by side." :
          n === 1 ? "One picked. Pick at least one more." :
          n <= 4 ? n + " picked." :
          "Two to four is the most a head-to-head reads cleanly.";
      }
    })();
  </script>

  <style>
    .back { margin: 0 0 10px; font-size: 13px; }
    .back .sep { color: var(--faint); margin: 0 4px; }
    .crumbHere { color: var(--muted); }
    .hero h1 { margin: 4px 0 0; }
    .range { font-size: 13.5px; line-height: 1.6; color: var(--ink-dim); margin: 10px 0 0; max-width: 78ch; }
    .dateline { font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--muted); margin: 8px 0 0; }

    .groupLine { font-family: var(--serif); font-size: 13.5px; line-height: 1.65; color: var(--ink-soft); margin: 14px 0 0; max-width: 88ch; border-top: 1px solid var(--rule); padding-top: 10px; }
    .groupLine .glNote { font-style: italic; font-size: 12px; color: var(--muted); }

    .pickBar { display: flex; align-items: center; gap: 14px; margin: 12px 0 0; }
    .pickHint { font-family: var(--sans); font-size: 12px; color: var(--muted); }
    .cmpGo { font-family: var(--sans); font-size: 11.5px; font-weight: 600; letter-spacing: 0.03em; border: 1px solid var(--rule-strong); border-radius: 999px; padding: 4px 12px; color: var(--ink-dim); text-decoration: none; cursor: pointer; }
    .cmpGo[aria-disabled="true"] { opacity: 0.45; pointer-events: none; cursor: default; }
    .cmpGo:hover { border-color: var(--accent); color: var(--accent); }

    /* The frozen pane, carried over verbatim from the industry table: the wide table scrolls inside
       its own container so the page never scrolls sideways, the header row stays visible, and the
       company stays in view as the columns scroll. */
    .tableWrap { margin: 12px 0 0; overflow: auto; overscroll-behavior-x: contain; max-height: 82vh; }
    table.grp { border-collapse: separate; border-spacing: 0; width: 100%; font-variant-numeric: tabular-nums; }
    table.grp th, table.grp td { padding: 7px 10px; border-bottom: 1px solid var(--rule); white-space: nowrap; }
    table.grp thead th { position: sticky; top: 0; z-index: 2; background: var(--paper); border-bottom: 2px solid var(--rule-strong); vertical-align: bottom; text-align: left; }
    table.grp thead th.num { text-align: right; }

    table.grp .sel { width: 34px; min-width: 34px; max-width: 34px; text-align: center; padding-left: 8px; padding-right: 4px; }
    table.grp .sel input { accent-color: var(--accent); cursor: pointer; margin: 0; vertical-align: middle; }
    table.grp td.sel { padding-top: 0; padding-bottom: 0; }
    table.grp td.sel label { display: block; padding: 7px 0; cursor: pointer; }
    table.grp td.sel { position: sticky; left: 0; z-index: 1; background: var(--paper); }
    table.grp thead th.sel { left: 0; z-index: 3; }
    table.grp td.tk { position: sticky; left: 34px; z-index: 1; background: var(--paper); border-right: 1px solid var(--rule); }
    table.grp thead th.tk { left: 34px; z-index: 3; border-right: 1px solid var(--rule); }
    table.grp th.tk, table.grp td.tk { width: 88px; min-width: 88px; max-width: 88px; }
    table.grp tbody tr { scroll-margin-top: 76px; }
    table.grp tbody tr:target > td { background: var(--tag-bg); }
    table.grp tbody tr:target > td.tk { box-shadow: inset 3px 0 0 var(--accent); }
    @media (min-width: 720px) {
      table.grp td.tk, table.grp thead th.tk { border-right: 0; }
      table.grp td.nm { position: sticky; left: 122px; z-index: 1; background: var(--paper); border-right: 1px solid var(--rule); }
      table.grp thead th.nm { position: sticky; left: 122px; z-index: 3; border-right: 1px solid var(--rule); }
    }
    table.grp thead button { background: none; border: 0; padding: 0; margin: 0; cursor: pointer; font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); }
    table.grp thead button:hover { color: var(--accent); }
    table.grp thead .tri { display: inline-block; min-width: 1em; font-size: 9px; color: var(--accent); }
    table.grp thead .basis { display: block; font-family: var(--sans); font-weight: 400; text-transform: none; letter-spacing: 0; font-size: 10px; color: var(--muted); margin-top: 2px; max-width: 24ch; white-space: normal; }
    table.grp thead th.num .basis { margin-left: auto; }

    table.grp td.num { text-align: right; font-family: var(--sans); font-size: 12.5px; color: var(--ink); }
    table.grp td.num.off { color: var(--faint); }
    table.grp td.tk { font-family: var(--sans); font-weight: 700; font-size: 12.5px; }
    table.grp td.nm { font-family: var(--serif); font-size: 13px; color: var(--ink-soft); }
    table.grp td.nm .nmIn { display: block; max-width: 30ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    /* The industry reads darker here than on an industry table, where it is a repeated aside. On a
       sector table it is the spine, and it is the way down. */
    table.grp td.ind { font-family: var(--sans); font-size: 11.5px; }
    table.grp td.ind a { color: var(--ink-dim); text-decoration: none; border-bottom: 1px solid var(--rule); }
    table.grp td.ind a:hover { color: var(--accent); border-bottom-color: var(--accent); }

    @media (pointer: coarse) {
      table.grp thead button { padding: 6px 0; min-height: 24px; }
      table.grp .sel input { width: 20px; height: 20px; }
    }

    /* Narrow screens. The Industry column STAYS on a sector table: it is the spine and the way down
       to the specialist columns, and on a phone that is the reader's escape from a long table
       rather than an aside he can lose. It is the name column that gives up width instead. */
    @media (max-width: 700px) {
      table.grp thead th.num { max-width: 12ch; }
      table.grp thead th.num button { white-space: normal; display: inline-block; text-align: right; }
      table.grp thead .basis { max-width: 12ch; }
      table.grp thead th.ind .basis { display: none; }
      table.grp td.nm .nmIn { max-width: 10ch; }
    }

    /* Under 720px the height cap comes off. overflow-x on the wrap keeps the columns in their own
       sideways scroller, but a max-height on top of that makes a nested vertical scroller, and on a
       phone with several hundred rows that is the two-axis trap: the reader's vertical swipe is
       captured by the box, the page behind it will not move, and the footnote is hundreds of rows
       away. With no height constraint the wrap never scrolls vertically on its own, the page scrolls
       normally, and the header sticks against the viewport, which is the behaviour a phone wants.
       CSS cannot express overflow-x: auto with overflow-y: visible; a non-visible value on one axis
       computes the other to auto, so this is the honest way to get it. */
    @media (max-width: 720px) {
      .tableWrap { max-height: none; }
    }

    .foot { font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--muted); margin: 20px 0 0; line-height: 1.6; max-width: 78ch; border-top: 1px solid var(--rule-strong); padding-top: 12px; }
  </style>
</BaseLayout>
