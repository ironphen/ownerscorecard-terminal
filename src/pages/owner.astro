---
// The owner's statement — look-through ownership, Buffett's own instruction rendered as a
// page. The reader enters the shares they hold; the page states what that fraction owns,
// from each company's own filings: your revenue, your owner earnings, your net income, your
// share of the net debt. Per-currency totals, as filed, never converted.
//
// Doctrine, by refusal: no performance, no cost basis, no benchmark, no allocation chart, no
// live quotes, no brokerage import, no verdicts, no ranking (rows keep the reader's entry
// order). Every number is the reader's input or an as-filed figure times the reader's own
// fraction. Holdings live on this device only (localStorage, the price-memory pattern) — no
// account required, nothing stored with us. Prices are optional, reader-typed, dated, and
// shared with the company pages' price memory.
//
// The page is fully static; figures come client-side from the same slim per-ticker JSON
// cards the compare view reads. No data pool may be imported here (worker discipline).
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="The owner's statement, Owner Scorecard"
  description="Enter the shares you hold and read what they own: your fraction of each business's revenue, owner earnings, and debt, from the filings. Held on your device; no account needed."
>
  <section class="owner">
    <h1>The owner&rsquo;s statement</h1>
    <p class="intro">
      You do not own a ticker; you own a fraction of a business. Enter the shares you hold
      and this page states what that fraction owns, from each company&rsquo;s own filings:
      your share of the revenue, the owner earnings, the profit, and the debt. Your holdings
      stay on this device — no account, nothing stored with us.
    </p>

    <div class="addRow">
      <input id="addTicker" type="text" autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="Ticker (AAPL, 7203…)" aria-label="Ticker" />
      <input id="addShares" type="number" inputmode="decimal" min="0" step="any" placeholder="Shares you hold" aria-label="Shares you hold" />
      <button id="addBtn" type="button">Add</button>
      <span class="addErr" id="addErr" hidden></span>
    </div>

    <div class="tblWrap">
      <table class="stmt" id="stmt" hidden aria-label="Your look-through statement, by holding">
        <thead>
          <tr>
            <th>Company</th>
            <th class="num">Shares</th>
            <th class="num">Your price</th>
            <th>Your fraction</th>
            <th class="num">Your revenue</th>
            <th class="num">Your owner earnings</th>
            <th class="num">Your profit</th>
            <th class="num">Your net debt</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="stmtBody"></tbody>
      </table>
    </div>
    <p class="none" id="none">No holdings entered yet. Add one above; everything stays on this device.</p>

    <div id="totals"></div>

    <p class="foot">
      Figures are each company&rsquo;s latest annual filing, as filed, times your fraction
      (your shares over the filed share count); a figure the filing doesn&rsquo;t carry stays
      a dash, and totals say how many holdings they cover. Currencies are never converted —
      a yen business totals in yen. Owner earnings are the latest year&rsquo;s cash from
      operations less total capital spending; a bank is not read on owner earnings here, by
      design. The optional price is yours, dated on your device, and shared with each
      company page&rsquo;s price memory. Nothing on this page is a recommendation; what to
      own, and at what price, is the reader&rsquo;s judgment.
    </p>
    <p class="foot lic">
      &ldquo;Investors can benefit by focusing on their own look-through earnings&hellip;
      calculate the underlying earnings attributable to the shares you hold in your
      portfolio and total these.&rdquo; — Warren Buffett, 1991 letter to shareholders.
    </p>
  </section>

  <style>
    .owner { max-width: 860px; margin: 32px auto 0; }
    h1 { margin: 0 0 10px; }
    .intro { font-size: 15px; line-height: 1.6; color: var(--ink); max-width: 66ch; margin: 0 0 20px; }

    .addRow { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 0 0 16px; font-family: var(--sans); }
    .addRow input { font-size: 13.5px; padding: 6px 9px; border: 1px solid var(--rule-strong); border-radius: 6px; background: var(--surface); color: var(--ink); }
    #addTicker { width: 130px; text-transform: uppercase; }
    #addShares { width: 150px; }
    #addBtn { font-size: 12px; font-weight: 600; letter-spacing: 0.05em; color: var(--accent); background: none; border: 1px solid var(--accent); border-radius: 999px; padding: 5px 16px; cursor: pointer; }
    #addBtn:hover { background: var(--accent-tint); }
    .addErr { font-size: 12.5px; color: var(--bad); }

    .tblWrap { overflow-x: auto; }
    .stmt { width: 100%; border-collapse: collapse; font-family: var(--sans); font-size: 13px; font-variant-numeric: tabular-nums; }
    .stmt th { text-align: left; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--rule-strong); padding: 6px 10px 6px 0; white-space: nowrap; }
    .stmt th.num, .stmt td.num { text-align: right; }
    .stmt td { border-bottom: 1px solid var(--rule); padding: 8px 10px 8px 0; white-space: nowrap; }
    .stmt .tkr { font-weight: 700; }
    .stmt .co { color: var(--ink-dim); font-family: var(--serif); font-size: 13px; }
    .stmt .frac { color: var(--ink-dim); font-size: 12px; }
    .stmt input { width: 110px; font-size: 12.5px; padding: 3px 6px; border: 1px solid var(--rule); border-radius: 4px; background: var(--paper); color: var(--ink); text-align: right; }
    .stmt .rm { font-size: 11px; color: var(--muted); background: none; border: none; cursor: pointer; }
    .stmt .rm:hover { color: var(--bad); }
    .stmt .miss { color: var(--muted); }
    .none { color: var(--ink-dim); font-size: 14px; }

    #totals { margin-top: 22px; }
    .tBlock { border-top: 2px solid var(--ink); padding: 10px 0 4px; margin-bottom: 14px; }
    .tHead { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); margin: 0 0 6px; }
    .tGrid { display: flex; gap: 26px; flex-wrap: wrap; font-family: var(--sans); font-variant-numeric: tabular-nums; }
    .tCell .tv { font-size: 17px; font-weight: 700; color: var(--ink); }
    .tCell .tl { display: block; font-size: 11px; color: var(--muted); letter-spacing: 0.04em; }
    .tCov { font-family: var(--sans); font-size: 11.5px; color: var(--muted); margin: 8px 0 0; }
    .foot { font-size: 12.5px; line-height: 1.6; color: var(--muted); max-width: 72ch; margin: 22px 0 0; font-family: var(--sans); }
    .lic { font-family: var(--serif); font-style: italic; }
  </style>

  <script>
    import { holdingRow, statementTotals, money, fractionLabel } from "../lib/ownerStatement.mjs";
    import { readSaved, saveOnEdit } from "../lib/priceMemory.mjs";

    const KEY = "osc-owner-holdings";
    const load = () => { try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch { return {}; } };
    const store = (h) => { try { localStorage.setItem(KEY, JSON.stringify(h)); } catch {} };

    const holdings = load(); // { TICKER: shares } — entry order preserved by insertion
    const cards = {};        // { TICKER: card | null } — null = not covered

    const tbl = document.getElementById("stmt");
    const body = document.getElementById("stmtBody");
    const none = document.getElementById("none");
    const totalsEl = document.getElementById("totals");
    const addErr = document.getElementById("addErr");

    const el = (tag, cls, text) => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = text;
      return n;
    };

    const fetchCard = (t) =>
      cards[t] !== undefined
        ? Promise.resolve(cards[t])
        : fetch("/compare/" + encodeURIComponent(t) + ".json")
            .then((r) => (r.ok ? r.json() : null))
            .then((c) => { cards[t] = c; return c; })
            .catch(() => { cards[t] = null; return null; });

    const priceOf = (t) => {
      const s = readSaved(t);
      return s && s.p > 0 ? s.p : null;
    };

    function render() {
      const tickers = Object.keys(holdings);
      tbl.hidden = tickers.length === 0;
      none.hidden = tickers.length > 0;
      body.textContent = "";
      const rows = [];
      const prices = {};
      for (const t of tickers) {
        const card = cards[t];
        const tr = el("tr");
        const co = el("td");
        const link = el("a", "tkr", t);
        link.href = card ? (card.pool === "JP" ? "/jp/" + t : card.pool === "EU" ? "/eu/" + t : "/c/" + t) : "/c/" + t;
        co.append(link);
        if (card?.name) co.append(el("span", "co", " " + card.name));
        tr.append(co);

        const shTd = el("td", "num");
        const sh = el("input");
        sh.type = "number"; sh.min = "0"; sh.step = "any"; sh.value = holdings[t];
        sh.setAttribute("aria-label", "Shares of " + t);
        sh.addEventListener("change", () => {
          const v = parseFloat(sh.value);
          if (v > 0) { holdings[t] = v; store(holdings); render(); }
        });
        shTd.append(sh);
        tr.append(shTd);

        const pxTd = el("td", "num");
        const px = el("input");
        px.type = "number"; px.min = "0"; px.step = "0.01";
        px.placeholder = "optional";
        const saved = priceOf(t);
        if (saved != null) px.value = saved;
        px.setAttribute("aria-label", "Your price for " + t);
        px.addEventListener("change", () => { saveOnEdit(t, px.value); render(); });
        pxTd.append(px);
        tr.append(pxTd);

        const row = card ? holdingRow(card, holdings[t]) : null;
        if (row) {
          rows.push(row);
          const p = priceOf(t);
          if (p != null) prices[t] = p;
          tr.append(el("td", "frac", fractionLabel(row.frac)));
          for (const k of ["rev", "oe", "ni", "netDebt"]) {
            tr.append(el("td", "num" + (row[k] == null ? " miss" : ""), row[k] == null ? "—" : money(row[k], row.sym)));
          }
        } else {
          const miss = el("td", "miss", cards[t] === null ? "not in the library" : "…");
          miss.colSpan = 5;
          tr.append(miss);
        }

        const rmTd = el("td");
        const rm = el("button", "rm", "remove");
        rm.type = "button";
        rm.addEventListener("click", () => { delete holdings[t]; store(holdings); render(); });
        rmTd.append(rm);
        tr.append(rmTd);
        body.append(tr);
      }

      totalsEl.textContent = "";
      for (const g of statementTotals(rows, prices)) {
        const block = el("div", "tBlock");
        block.append(el("p", "tHead", `Your look-through statement, ${g.ccy} (${g.n} holding${g.n === 1 ? "" : "s"})`));
        const grid = el("div", "tGrid");
        const cell = (label, val) => {
          const c = el("div", "tCell");
          c.append(el("span", "tv", val));
          c.append(el("span", "tl", label));
          return c;
        };
        grid.append(cell("your revenue", money(g.revN ? g.rev : null, g.sym)));
        grid.append(cell("your owner earnings", money(g.oeN ? g.oe : null, g.sym)));
        grid.append(cell("your profit", money(g.niN ? g.ni : null, g.sym)));
        grid.append(cell(g.netDebtN && g.netDebt < 0 ? "your net cash" : "your net debt", money(g.netDebtN ? Math.abs(g.netDebt) : null, g.sym)));
        if (g.oeYield != null) {
          grid.append(cell("owner-earnings yield on your prices", (g.oeYield * 100).toFixed(1) + "%"));
        }
        block.append(grid);
        const cov = [];
        if (g.oeN < g.n) cov.push(`owner earnings cover ${g.oeN} of ${g.n}`);
        if (g.revN < g.n) cov.push(`revenue covers ${g.revN} of ${g.n}`);
        if (g.oeYield != null && g.pricedN < g.n) cov.push(`the yield covers the ${g.pricedN} priced holding${g.pricedN === 1 ? "" : "s"}`);
        if (cov.length) block.append(el("p", "tCov", cov.join("; ") + "."));
        totalsEl.append(block);
      }
    }

    document.getElementById("addBtn").addEventListener("click", () => {
      addErr.hidden = true;
      const t = document.getElementById("addTicker").value.trim().toUpperCase();
      const s = parseFloat(document.getElementById("addShares").value);
      if (!/^[A-Z0-9.\-]{1,10}$/.test(t)) { addErr.textContent = "Enter a ticker."; addErr.hidden = false; return; }
      if (!(s > 0)) { addErr.textContent = "Enter the shares you hold."; addErr.hidden = false; return; }
      holdings[t] = s;
      store(holdings);
      document.getElementById("addTicker").value = "";
      document.getElementById("addShares").value = "";
      fetchCard(t).then((c) => {
        if (!c) { addErr.textContent = t + " isn’t in the library."; addErr.hidden = false; }
        render();
      });
      render();
    });

    Promise.all(Object.keys(holdings).map(fetchCard)).then(render);
    render();
  </script>
</BaseLayout>
