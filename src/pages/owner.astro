---
// The owner's statement — look-through ownership, Buffett's own instruction rendered as a
// page. The reader enters the shares they hold; the page states what that fraction owns,
// from each company's own filings — dated per row, in the lens each business is read on,
// with per-currency totals as filed and one combined statement at dated, named reference
// rates. Shaped by a three-lane partner pass (Graham / Buffett / craftsman, adversarially
// verified) on 2026-07-16; the deliberate REFUSALS from that pass are as load-bearing as
// the features: no performance, no cost basis, no benchmark, no allocation chart, no live
// quotes, no brokerage import, no verdicts, no ranking, no SBC line (dilution already
// speaks through the fraction), no combined "shareholder yield" coinage, no aggregate ROIC
// (the cards carry no honest numerator), and holdings NEVER enter a URL.
//
// Holdings live on this device only (localStorage). Prices are optional, reader-typed,
// dated, and shared with the company pages' price memory. Figures come client-side from
// the same slim per-ticker JSON cards the compare view reads; rates.json (a kilobyte of
// dated public facts) is the one data import.
//
// NOTE on styles: the table rows and totals are built by the client script, so the style
// block below is is:global (Astro's scoping attribute never lands on JS-created elements).
// Every selector is prefixed with .owner to keep the globals contained.
import BaseLayout from "../layouts/BaseLayout.astro";
import rates from "../data/rates.json";
import { SEARCH_ALIASES } from "../lib/searchAliases.mjs";
const fxAsOf = rates?.fxAsOf ?? null;
---

<BaseLayout
  title="The owner's statement, Owner Scorecard"
  description="Enter the shares you hold and read what they own: your fraction of each business's revenue, owner earnings, equity, and debt, from the filings. Held on your device; no account needed."
>
  <section class="owner" id="ownerRoot" data-fx={JSON.stringify(rates?.fx ?? {})} data-fxasof={fxAsOf ?? ""} data-aliases={JSON.stringify(SEARCH_ALIASES)}>
    <h1>The owner&rsquo;s statement</h1>
    <p class="printLine" id="printLine" hidden></p>
    <p class="intro">
      You do not own a ticker; you own a fraction of a business. Enter the shares you hold
      and this page states what that fraction owns, from each company&rsquo;s own filings:
      your share of the revenue, the owner earnings, the profit, the equity, and the debt.
      Your holdings stay on this device — no account, nothing stored with us.
    </p>

    <div class="addRow">
      <span class="acWrap">
        <input id="addTicker" type="text" autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="Ticker or company name" aria-label="Ticker or company name" />
        <ul class="acList" id="acList" hidden></ul>
      </span>
      <input id="addShares" type="number" inputmode="decimal" min="0" step="any" placeholder="Shares you hold" aria-label="Shares you hold" />
      <button id="addBtn" type="button">Add</button>
      <span class="addErr" id="addErr" hidden></span>
    </div>

    <div class="tblWrap">
      <table class="stmt" id="stmt" hidden aria-label="Your look-through statement, by holding">
        <thead>
          <tr>
            <th>Company</th>
            <th class="num">Shares</th>
            <th class="num">Your price</th>
            <th class="num" title="Through-cycle median return on invested capital (a bank shows its normalized return on tangible equity); beneath it, the compound annual per-share growth over the filed record">Return on capital</th>
            <th class="num">Revenue</th>
            <th class="num">Owner earnings</th>
            <th class="num">Profit</th>
            <th class="num">Net debt</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="stmtBody"></tbody>
      </table>
    </div>
    <p class="none" id="none">No holdings entered yet. Add one above; everything stays on this device.</p>
    <p class="keepLine" id="keepLine" hidden>
      Holdings live on this device only. <button class="copyBtn" id="copyBtn" type="button">Copy them as text</button>
      to keep or move them; pasting a copied list into the ticker box restores it.
      <span id="copyMsg"></span>
    </p>

    <div id="totals"></div>

    <p class="foot">
      Figures are each company&rsquo;s latest annual filing — dated on every row — as filed,
      times your fraction (your shares over the filed share count); your equity is the filed
      book value per share times your shares. A figure the filing doesn&rsquo;t carry stays a
      dash, and totals say how many holdings they cover. The return column is each
      business&rsquo;s through-cycle median return on invested capital (a bank shows its
      normalized return on tangible equity, the lens a bank is read on), with the compound
      annual per-share growth over the filed record beneath it. The earlier-count line under
      a fraction restates the record&rsquo;s starting share count on today&rsquo;s
      split-adjusted basis — an arithmetic restatement, not a filed number. The averaged
      owner earnings are the last three filed years. The look-through return on equity is
      your profit over your equity, summed only across holdings carrying both; the
      owner-earnings yield names the sum of your own prices it is computed on. Each
      per-currency statement is as filed, never converted; the combined statement converts at
      the dated reference rates it names — reference rates, not quotes. Nothing on this page
      is a recommendation; what to own, and at what price, is the reader&rsquo;s judgment.
    </p>
    <p class="foot lic">
      &ldquo;We also believe that investors can benefit by focusing on their own
      look-through earnings. To calculate these, they should determine the underlying
      earnings attributable to the shares they hold in their portfolio and total
      these.&rdquo; — Warren Buffett, 1991 letter to shareholders.
    </p>
  </section>

  <style is:global>
    .owner { margin: 32px auto 0; }
    .owner h1 { margin: 0 0 10px; }
    .owner .intro { font-size: 15px; line-height: 1.6; color: var(--ink); max-width: 66ch; margin: 0 0 20px; }
    .owner .printLine { font-family: var(--sans); font-size: 12px; color: var(--muted); margin: 0 0 14px; }

    .owner .addRow { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 0 0 16px; font-family: var(--sans); }
    .owner .addRow input { font-size: 13.5px; padding: 6px 9px; border: 1px solid var(--rule-strong); border-radius: 6px; background: var(--surface); color: var(--ink); }
    .owner .acWrap { position: relative; }
    .owner #addTicker { width: 210px; }
    .owner #addShares { width: 150px; }
    .owner #addBtn { font-size: 12px; font-weight: 600; letter-spacing: 0.05em; color: var(--accent); background: none; border: 1px solid var(--accent); border-radius: 999px; padding: 5px 16px; cursor: pointer; }
    .owner #addBtn:hover { background: var(--accent-tint); }
    .owner .addErr { font-size: 12.5px; color: var(--bad); }
    .owner .acList { position: absolute; top: calc(100% + 3px); left: 0; z-index: 20; min-width: 280px; max-height: 260px; overflow-y: auto; list-style: none; margin: 0; padding: 4px 0; background: var(--surface); border: 1px solid var(--rule-strong); border-radius: 6px; box-shadow: 0 4px 14px rgba(0,0,0,0.18); }
    .owner .acList li { padding: 6px 10px; cursor: pointer; font-size: 13px; display: flex; gap: 8px; align-items: baseline; }
    .owner .acList li.on, .owner .acList li:hover { background: var(--accent-tint); }
    .owner .acList .acT { font-weight: 700; font-variant-numeric: tabular-nums; }
    .owner .acList .acN { color: var(--ink-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .owner .tblWrap { overflow-x: auto; }
    .owner .stmt { width: 100%; border-collapse: separate; border-spacing: 0; font-family: var(--sans); font-size: 13px; font-variant-numeric: tabular-nums; }
    .owner .stmt th { text-align: left; font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--rule-strong); padding: 6px 10px 6px 0; white-space: nowrap; }
    .owner .stmt th.num, .owner .stmt td.num { text-align: right; }
    .owner .stmt td { border-bottom: 1px solid var(--rule); padding: 8px 10px 8px 0; white-space: nowrap; vertical-align: top; }
    .owner .stmt td:first-child, .owner .stmt th:first-child { position: sticky; left: 0; background: var(--paper); z-index: 1; border-right: 1px solid var(--rule-strong); padding-right: 10px; }
    .owner .stmt .tkr { font-weight: 700; }
    .owner .stmt .co { display: block; color: var(--ink-dim); font-family: var(--serif); font-size: 12.5px; max-width: 190px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .owner .stmt .vint { display: block; font-size: 10.5px; color: var(--muted); letter-spacing: 0.03em; margin-top: 2px; }
    .owner .stmt .fracLine { display: block; font-size: 11.5px; color: var(--ink-dim); margin-top: 3px; }
    .owner .stmt .thenLine { display: block; font-size: 10.5px; color: var(--muted); margin-top: 1px; }
    .owner .stmt .retLbl { font-size: 10px; color: var(--muted); letter-spacing: 0.04em; }
    .owner .stmt .growLine { display: block; font-size: 11px; color: var(--muted); margin-top: 2px; }
    .owner .stmt input { width: 96px; font-size: 12.5px; padding: 3px 6px; border: 1px solid var(--rule); border-radius: 4px; background: var(--paper); color: var(--ink); text-align: right; }
    .owner .stmt .rm { font-size: 13px; line-height: 1; color: var(--muted); background: none; border: none; cursor: pointer; padding: 2px 4px; }
    .owner .stmt .rm:hover { color: var(--bad); }
    .owner .stmt .miss { color: var(--muted); }
    .owner .stmt .retry { font-size: 11.5px; color: var(--accent); background: none; border: none; cursor: pointer; padding: 0; text-decoration: underline; }
    .owner .none { color: var(--ink-dim); font-size: 14px; }
    .owner .keepLine { font-family: var(--sans); font-size: 12px; color: var(--muted); margin: 10px 0 0; }
    .owner .copyBtn { font-size: 12px; color: var(--accent); background: none; border: none; cursor: pointer; padding: 0; text-decoration: underline; }

    .owner #totals { margin-top: 22px; }
    .owner .tBlock { border-top: 2px solid var(--ink); padding: 12px 0 6px; margin-bottom: 16px; }
    .owner .tBlock.comb { border-top-width: 3px; }
    .owner .tHead { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; }
    .owner .tGrid { display: flex; gap: 30px; row-gap: 14px; flex-wrap: wrap; font-family: var(--sans); font-variant-numeric: tabular-nums; }
    .owner .tCell .tv { display: block; font-size: 18px; font-weight: 700; color: var(--ink); }
    .owner .tCell .tl { display: block; font-size: 11px; color: var(--muted); letter-spacing: 0.04em; margin-top: 2px; max-width: 24ch; }
    .owner .tCov { font-family: var(--sans); font-size: 11.5px; color: var(--muted); margin: 10px 0 0; }
    .owner .foot { font-size: 12.5px; line-height: 1.6; color: var(--muted); max-width: 74ch; margin: 22px 0 0; font-family: var(--sans); }
    .owner .lic { font-family: var(--serif); font-style: italic; }

    /* The printed page is the artifact: a dated position sheet, not a form. BaseLayout
       already prints the light palette, repeats the table head per sheet, and stamps every
       sheet with the provenance footer; this page only stops printing its chrome. */
    @media print {
      .owner .addRow, .owner .stmt .rm, .owner .keepLine,
      .owner .stmt th:last-child, .owner .stmt td:last-child { display: none; }
      .owner .printLine { display: block !important; }
      .owner .stmt input { border: none; background: none; padding: 0; appearance: textfield; -moz-appearance: textfield; }
      .owner .stmt input::placeholder { color: transparent; }
      .owner .stmt td:first-child, .owner .stmt th:first-child { position: static; border-right: none; }
    }
  </style>

  <script>
    import { holdingRow, statementTotals, combineUsd, money, fractionLabel } from "../lib/ownerStatement.mjs";
    import { readSaved, saveOnEdit, localISO } from "../lib/priceMemory.mjs";

    const KEY = "osc-owner-holdings";
    const load = () => { try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch { return {}; } };
    const store = (h) => { try { localStorage.setItem(KEY, JSON.stringify(h)); } catch {} };

    const holdings = load(); // { TICKER: shares } — entry order preserved by insertion
    const cards = {};        // TICKER → card | null (confirmed not covered) | "error" (transient, retryable)

    const root = document.getElementById("ownerRoot");
    const FX = (() => { try { return JSON.parse(root.dataset.fx) || {}; } catch { return {}; } })();
    const FX_ASOF = root.dataset.fxasof || null;
    const ALIASES = (() => { try { return JSON.parse(root.dataset.aliases) || {}; } catch { return {}; } })();

    const tbl = document.getElementById("stmt");
    const body = document.getElementById("stmtBody");
    const none = document.getElementById("none");
    const keepLine = document.getElementById("keepLine");
    const totalsEl = document.getElementById("totals");
    const addErr = document.getElementById("addErr");
    const printLine = document.getElementById("printLine");
    printLine.textContent = `Position statement, printed ${localISO()}. Figures as filed.`;

    const el = (tag, cls, text) => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = text;
      return n;
    };

    // A 404 is the library's answer (not covered); a network failure is not — it must never
    // be reported as a coverage fact ("a wrong number is worse than a missing one" extends
    // to wrong words). Transient failures stay retryable.
    const fetchCard = (t) =>
      cards[t] !== undefined && cards[t] !== "error"
        ? Promise.resolve(cards[t])
        : fetch("/compare/" + encodeURIComponent(t) + ".json")
            .then((r) => {
              if (r.ok) return r.json().then((c) => { cards[t] = c; return c; });
              cards[t] = r.status === 404 ? null : "error";
              return cards[t] === null ? null : Promise.reject();
            })
            .catch(() => { if (cards[t] === undefined) cards[t] = "error"; return "error"; });

    const priceOf = (t) => {
      const s = readSaved(t);
      return s && s.p > 0 ? s.p : null;
    };

    const sig3 = (n) => {
      const mag = Math.pow(10, Math.max(0, Math.floor(Math.log10(n)) - 2));
      return (Math.round(n / mag) * mag).toLocaleString("en-US");
    };

    function totalsBlock(g, title, extraCov) {
      const block = el("div", "tBlock");
      block.append(el("p", "tHead", title));
      const grid = el("div", "tGrid");
      const cell = (label, val) => {
        const c = el("div", "tCell");
        c.append(el("span", "tv", val));
        c.append(el("span", "tl", label));
        return c;
      };
      grid.append(cell("your revenue", money(g.revN ? g.rev : null, g.sym)));
      grid.append(cell("your owner earnings", money(g.oeN ? g.oe : null, g.sym)));
      if (g.oe3N) grid.append(cell("averaged owner earnings, last three filed years", money(g.oe3, g.sym)));
      grid.append(cell("your profit", money(g.niN ? g.ni : null, g.sym)));
      grid.append(cell("your equity", money(g.bvN ? g.bv : null, g.sym)));
      grid.append(cell(g.netDebtN && g.netDebt < 0 ? "your net cash" : "your net debt", money(g.netDebtN ? Math.abs(g.netDebt) : null, g.sym)));
      if (g.lookRoe != null) grid.append(cell("look-through return on equity", (g.lookRoe * 100).toFixed(1) + "%"));
      if (g.oeYield != null) grid.append(cell(`owner-earnings yield on ${money(g.outlay, g.sym)} at your prices`, (g.oeYield * 100).toFixed(1) + "%"));
      block.append(grid);
      const cov = [];
      if (g.oeN < g.n) cov.push(`owner earnings cover ${g.oeN} of ${g.n}`);
      if (g.oe3N && g.oe3N < g.n) cov.push(`the average covers ${g.oe3N} of ${g.n}`);
      if (g.revN < g.n) cov.push(`revenue covers ${g.revN} of ${g.n}`);
      if (g.lookRoe != null && g.roeN < g.n) cov.push(`the return on equity covers ${g.roeN} of ${g.n}`);
      if (g.oeYield != null && g.pricedN < g.n) cov.push(`the yield covers the ${g.pricedN} priced holding${g.pricedN === 1 ? "" : "s"}`);
      if (extraCov) cov.push(extraCov);
      if (cov.length) block.append(el("p", "tCov", cov.join("; ") + "."));
      return block;
    }

    function render() {
      const tickers = Object.keys(holdings);
      tbl.hidden = tickers.length === 0;
      none.hidden = tickers.length > 0;
      keepLine.hidden = tickers.length === 0;
      body.textContent = "";
      const rows = [];
      const prices = {};
      for (const t of tickers) {
        const card = cards[t];
        const isCard = card && card !== "error";
        const tr = el("tr");

        const co = el("td");
        const link = el("a", "tkr", t);
        link.href = isCard ? (card.pool === "JP" ? "/jp/" + t : card.pool === "EU" ? "/eu/" + t : "/c/" + t) : "/c/" + t;
        co.append(link);
        if (isCard) {
          if (card.name) co.append(el("span", "co", card.name));
          if (card.fy != null || card.form) co.append(el("span", "vint", ["FY" + (card.fy ?? "?"), card.form].filter(Boolean).join(" · ")));
        }
        tr.append(co);

        const shTd = el("td", "num");
        const sh = el("input");
        sh.type = "number"; sh.min = "0"; sh.step = "any"; sh.value = holdings[t];
        sh.setAttribute("aria-label", "Shares of " + t);
        sh.addEventListener("change", () => {
          const v = parseFloat(sh.value);
          if (v > 0) holdings[t] = v;
          store(holdings);
          render(); // an invalid edit snaps back to the stored figure — garbage never sits beside real numbers
        });
        shTd.append(sh);
        tr.append(shTd);

        const pxTd = el("td", "num");
        const px = el("input");
        px.type = "number"; px.min = "0"; px.step = "0.01";
        px.placeholder = "optional";
        const saved = priceOf(t);
        if (saved != null) px.value = saved;
        px.setAttribute("aria-label", "Your price for " + t);
        px.addEventListener("change", () => { saveOnEdit(t, px.value); render(); });
        pxTd.append(px);
        tr.append(pxTd);

        const row = isCard ? holdingRow(card, holdings[t]) : null;
        if (row) {
          rows.push(row);
          const p = priceOf(t);
          if (p != null) prices[t] = p;
          co.append(el("span", "fracLine", fractionLabel(row.frac)));
          if (row.thenFrac && row.thenFrac.frac > 0 && row.thenFrac.frac < 1) {
            const startYr = String(row.thenFrac.span).slice(0, 4);
            co.append(el("span", "thenLine", `on today's share basis, the ${startYr} count put this stake at 1/${sig3(1 / row.thenFrac.frac)}th`));
          }
          const retTd = el("td", "num" + (row.ret ? "" : " miss"));
          if (row.ret) {
            retTd.append(el("span", null, (row.ret.v * 100).toFixed(0) + "% "));
            retTd.append(el("span", "retLbl", row.ret.label + (row.ret.note ? " · " + row.ret.note : "")));
          } else retTd.textContent = "—";
          if (row.grow) {
            const gv = row.grow.v * 100;
            retTd.append(el("span", "growLine", `${row.grow.label} ${gv >= 0 ? "+" : "−"}${Math.abs(gv).toFixed(1)}%/yr`));
          }
          tr.append(retTd);
          for (const k of ["rev", "oe", "ni"]) {
            tr.append(el("td", "num" + (row[k] == null ? " miss" : ""), row[k] == null ? "—" : money(row[k], row.sym)));
          }
          const ndTd = el("td", "num" + (row.netDebt == null ? " miss" : ""));
          if (row.netDebt == null) ndTd.textContent = "—";
          else if (row.netDebt < 0) {
            ndTd.append(el("span", null, money(Math.abs(row.netDebt), row.sym) + " "));
            ndTd.append(el("span", "retLbl", "net cash"));
          } else ndTd.textContent = money(row.netDebt, row.sym);
          tr.append(ndTd);
        } else {
          const miss = el("td", "miss");
          if (card === "error") {
            miss.append(el("span", null, "couldn’t load — "));
            const retry = el("button", "retry", "retry");
            retry.type = "button";
            retry.addEventListener("click", () => { cards[t] = "error"; fetchCard(t).then(render); });
            miss.append(retry);
          } else miss.textContent = cards[t] === null ? "not in the library" : "…";
          miss.colSpan = 5;
          tr.append(miss);
        }

        const rmTd = el("td");
        const rm = el("button", "rm", "×");
        rm.type = "button";
        rm.setAttribute("aria-label", "Remove " + t);
        rm.title = "Remove " + t;
        rm.addEventListener("click", () => { delete holdings[t]; store(holdings); render(); });
        rmTd.append(rm);
        tr.append(rmTd);
        body.append(tr);
      }

      totalsEl.textContent = "";
      const groups = statementTotals(rows, prices);
      for (const g of groups) {
        totalsEl.append(totalsBlock(g, `Your look-through statement, ${g.ccy} (${g.n} holding${g.n === 1 ? "" : "s"})`));
      }
      if (groups.length > 1) {
        const c = combineUsd(groups, FX);
        if (c.n > 0 && c.rates.length > 0) {
          const rateLine = "converted at " + c.rates.map((x) => `$${x.usdPerUnit} per ${x.sym}1`).join(" and ") + (FX_ASOF ? `, reference rates as of ${FX_ASOF}` : "");
          const block = totalsBlock(c, `Combined, in dollars (${c.n} holding${c.n === 1 ? "" : "s"})`, rateLine + (c.skipped.length ? `; no reference rate for ${c.skipped.join(", ")}, left out` : ""));
          block.classList.add("comb");
          totalsEl.append(block);
        }
      }
    }

    // ---- add flow: nothing is stored until the library answers (a typo must never
    // persist as a dead row), and a network failure is never reported as non-coverage. ----
    function addOne(t, s, quiet) {
      return fetchCard(t).then((c) => {
        if (c === "error") { if (!quiet) { addErr.textContent = "Couldn’t reach the library — try again."; addErr.hidden = false; } return false; }
        if (!c) { if (!quiet) { addErr.textContent = t + " isn’t in the library."; addErr.hidden = false; } return false; }
        holdings[t] = s;
        store(holdings);
        return true;
      });
    }

    function add() {
      addErr.hidden = true;
      const t = document.getElementById("addTicker").value.trim().toUpperCase();
      const s = parseFloat(document.getElementById("addShares").value);
      if (!/^[A-Z0-9.\-]{1,10}$/.test(t)) { addErr.textContent = "Enter a ticker or pick a company."; addErr.hidden = false; return; }
      if (!(s > 0)) { addErr.textContent = "Enter the shares you hold."; addErr.hidden = false; return; }
      addOne(t, s).then((ok) => {
        if (ok) {
          document.getElementById("addTicker").value = "";
          document.getElementById("addShares").value = "";
        }
        render();
      });
    }
    document.getElementById("addBtn").addEventListener("click", add);
    document.getElementById("addShares").addEventListener("keydown", (e) => { if (e.key === "Enter") add(); });

    // ---- copy / paste: the reader's holdings as a plain text list they own. Never a URL. ----
    document.getElementById("copyBtn").addEventListener("click", () => {
      const text = Object.entries(holdings).map(([t, s]) => `${t} ${s}`).join("\n");
      const msg = document.getElementById("copyMsg");
      navigator.clipboard.writeText(text).then(
        () => { msg.textContent = "Copied."; setTimeout(() => (msg.textContent = ""), 2500); },
        () => { msg.textContent = "Couldn’t copy on this browser."; }
      );
    });
    document.getElementById("addTicker").addEventListener("paste", (e) => {
      const text = (e.clipboardData || window.clipboardData)?.getData("text") || "";
      if (!text.includes("\n") && !/^[A-Z0-9.\-]{1,10}\s+[\d.]+$/i.test(text.trim())) return; // ordinary paste
      e.preventDefault();
      const pairs = text.split(/\n/).map((l) => l.trim()).filter(Boolean).map((l) => l.split(/\s+/));
      Promise.all(pairs.map(([t, s]) => {
        const T = String(t || "").toUpperCase();
        const S = parseFloat(s);
        return /^[A-Z0-9.\-]{1,10}$/.test(T) && S > 0 ? addOne(T, S, true) : false;
      })).then(render);
    });

    // ---- name → ticker: the same index and alias map the site search uses, in a small
    // dropdown. Ranking search suggestions reuses the ratified search order (ticker match,
    // then name match, by prominence) — it ranks candidates, never the reader's holdings. ----
    let INDEX = null;
    const acList = document.getElementById("acList");
    const addTicker = document.getElementById("addTicker");
    let acActive = -1;
    const loadIndex = () =>
      INDEX ? Promise.resolve(INDEX)
        : fetch("/company-index.json").then((r) => (r.ok ? r.json() : { rows: [] })).then((j) => {
            INDEX = (j.rows || []).map((r) => ({ t: r[0], name: r[1], pool: r[2], prom: r[3] || 0 }));
            return INDEX;
          }).catch(() => (INDEX = []));
    const suggest = (term) => {
      const q = term.trim().toLowerCase();
      if (!q || !INDEX) return [];
      const alias = ALIASES[q]; // alias values are arrays of tickers ("google" → ["GOOGL","GOOG"])
      const scored = [];
      for (const it of INDEX) {
        const tl = it.t.toLowerCase(), nl = (it.name || "").toLowerCase();
        let s = -1;
        if (Array.isArray(alias) && alias.includes(it.t)) s = 0;
        else if (tl === q) s = 0;
        else if (tl.indexOf(q) === 0) s = 1;
        else if (nl.indexOf(q) === 0) s = 2;
        else if (nl.split(/\s+/).some((w) => w.indexOf(q) === 0)) s = 3;
        else if (q.length > 2 && nl.indexOf(q) >= 0) s = 4;
        if (s >= 0) scored.push({ it, s });
      }
      scored.sort((a, b) => a.s - b.s || b.it.prom - a.it.prom || a.it.name.length - b.it.name.length);
      return scored.slice(0, 8).map((x) => x.it);
    };
    const paintAc = (items) => {
      acList.textContent = "";
      acActive = -1;
      acList.hidden = items.length === 0;
      items.forEach((it) => {
        const li = el("li");
        li.append(el("span", "acT", it.t));
        li.append(el("span", "acN", it.name));
        li.addEventListener("mousedown", (e) => { e.preventDefault(); pick(it); });
        acList.append(li);
      });
    };
    const pick = (it) => {
      addTicker.value = it.t;
      acList.hidden = true;
      document.getElementById("addShares").focus();
    };
    addTicker.addEventListener("input", () => {
      loadIndex().then(() => paintAc(suggest(addTicker.value)));
    });
    addTicker.addEventListener("keydown", (e) => {
      const items = [...acList.children];
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        if (acList.hidden || !items.length) return;
        e.preventDefault();
        acActive = e.key === "ArrowDown" ? Math.min(acActive + 1, items.length - 1) : Math.max(acActive - 1, 0);
        items.forEach((li, i) => li.classList.toggle("on", i === acActive));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (!acList.hidden && acActive >= 0) {
          const it = suggest(addTicker.value)[acActive];
          if (it) { pick(it); return; }
        }
        acList.hidden = true;
        document.getElementById("addShares").focus();
      } else if (e.key === "Escape") acList.hidden = true;
    });
    addTicker.addEventListener("blur", () => setTimeout(() => (acList.hidden = true), 150));

    Promise.all(Object.keys(holdings).map(fetchCard)).then(render);
    render();
  </script>
</BaseLayout>
