---
import BaseLayout from "../layouts/BaseLayout.astro";
import wire from "../data/wire.json";
import fundamentals from "../data/fundamentals.json";
import upcoming from "../data/upcoming.json";
import { perfLine } from "../lib/wirePerf.mjs";
import { isSteadyRhythm, rollToBusinessDay, nextBusinessDays, monthPhrase } from "../lib/filingRhythm.mjs";

const known = new Set((fundamentals.companies || []).map((c) => String(c.ticker).toUpperCase()));
const items = wire?.items || [];

const fmtDate = (s) => new Date(s + "T00:00:00Z").toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", timeZone: "UTC" });

// group by filing date, newest first
const groups = [];
for (const it of items) {
  const g = groups.find((x) => x.date === it.date);
  if (g) g.items.push(it);
  else groups.push({ date: it.date, items: [it] });
}

// The performance line (up/down and a percentage per proven line) is shared from lib/wirePerf.mjs,
// so /wire, the per-day page, the Atom feed, the account band and the company page all read alike.

// ---- coming due: whose next report the record places in the next two filing days ----
// EDGAR announces no future dates, and neither do we: the SELECTION below uses each company's
// computed expectation (its median filing lag applied to its next period end), but every printed
// field is a filed fact or the statute — the period the report covers (month-level, since 52/53-
// week calendars drift by days), the N-day rule for its filer class, and how many days after
// period end it has historically filed. The page rebuilds daily, so the window rolls.
//
// The window is TWO FILING DAYS (weekend expectations roll to Monday), and only companies whose
// own rhythm supports day-level placement are listed (lib/filingRhythm.mjs: recent same-form
// lags held within ~2 days of the median). A full week at peak earnings season ran to hundreds
// of names and buried the wire itself. Companies in the window on looser or unmeasured rhythms
// are not characterized at all — the lede states the selection rule, and their filings enter
// the wire as they arrive; counting them would claim day-level placement exactly where the
// record refuses it. A report that has already arrived leaves the band: the wire's own items
// (same ticker + form) veto a chip, so a company is never "coming due" beside its own filing.
const nameOf = new Map((fundamentals.companies || []).map((c) => [String(c.ticker).toUpperCase(), c.name]));
const today = new Date().toISOString().slice(0, 10);
const windowDays = new Set(nextBusinessDays(rollToBusinessDay(today), 2));
const alreadyFiled = new Set(items.map((it) => `${String(it.ticker).toUpperCase()}|${it.form}`));
const dueSoon = Object.entries(upcoming.companies || {})
  .map(([t, c]) => ({ t, ...c }))
  .filter((c) => c.expected && windowDays.has(rollToBusinessDay(c.expected)) && !alreadyFiled.has(`${c.t}|${c.nextForm}`))
  .filter((c) => isSteadyRhythm(c.lagsSameForm))
  // Deterministic before the cap: earliest filing day first, then ticker — so the cap can never
  // drop a today name while keeping a tomorrow one, and the shown set is stable across builds.
  .sort((a, b) => rollToBusinessDay(a.expected).localeCompare(rollToBusinessDay(b.expected)) || a.t.localeCompare(b.t));
// Grouped by what the report is (form + the period it covers), tickers alphabetical within.
const AHEAD_CAP = 200;
const aheadGroups = [];
for (const c of dueSoon.slice(0, AHEAD_CAP)) {
  const label = c.nextForm === "10-K"
    ? `annual reports (10-K) for fiscal years ended ${monthPhrase(c.nextPeriodEnd)}`
    : `10-Qs for quarters ended ${monthPhrase(c.nextPeriodEnd)}`;
  const g = aheadGroups.find((x) => x.label === label);
  if (g) g.rows.push(c);
  else aheadGroups.push({ label, form: c.nextForm, end: c.nextPeriodEnd, rows: [c] });
}
aheadGroups.sort((a, b) => a.form.localeCompare(b.form) || a.end.localeCompare(b.end));
for (const g of aheadGroups) g.rows.sort((a, b) => a.t.localeCompare(b.t));
const chipTitle = (c) => {
  const name = nameOf.get(c.t);
  const what = c.nextForm === "10-K" ? `annual report (10-K) for the fiscal year ended ${monthPhrase(c.nextPeriodEnd)}` : `10-Q for the quarter ended ${monthPhrase(c.nextPeriodEnd)}`;
  return `${name ? name + " — " : ""}${what}; due within ${c.statutoryDays} days of period end; has filed ~${c.typicalLagDays} days after`;
};
---

<BaseLayout title="The Filing Wire, Owner Scorecard">
  <header class="hd">
    <h1>The Filing Wire</h1>
    {wire?.asOf ? <span class="asof">filings as of {wire.asOf} · refreshed daily</span> : null}
  </header>
  <p class="lede">
    Every new filing across the
    catalog, straight from EDGAR, newest first, with the 8-K codes translated into plain English. The grave
    ones (an auditor change, a restatement, a default) announce themselves.
  </p>

  {dueSoon.length ? (
    <section class="ahead">
      <h2>Coming due</h2>
      <p class="aheadLede">
        Companies whose own filing pace places their next report within the next two filing days.
        Each has held within a couple of days of its usual lag, filing after filing; the periods
        and day-counts are from its filings, and the deadline is the rule for its filer class.
        Nothing here is announced by the companies.
      </p>
      {aheadGroups.map((g) => (
        <div class="aheadGroup">
          <span class="gLabel">{g.label}</span>
          <span class="chips">
            {g.rows.map((c) => (
              <a class="chip" href={`/c/${c.t}`} title={chipTitle(c)} aria-label={chipTitle(c)}>{c.t}</a>
            ))}
          </span>
        </div>
      ))}
      {dueSoon.length > AHEAD_CAP ? <p class="aheadMore">…and {dueSoon.length - AHEAD_CAP} more match these two filing days; the list stops at {AHEAD_CAP}.</p> : null}
    </section>
  ) : null}

  {items.length ? (
    groups.map((g) => (
      <section class="day">
        <h2 class="date"><a href={`/wire/${g.date}`}>{fmtDate(g.date)}</a></h2>
        <ul>
          {g.items.map((it) => (
            <li class={it.grave ? "grave" : ""}>
              <div class="row">
                <span class="tkr">{known.has(it.ticker) ? <a href={`/c/${it.ticker}`}>{it.ticker}</a> : it.ticker}</span>
                <span class="what">{it.label}</span>
                <span class="form">{it.form}</span>
                {it.url ? <a class="src" href={it.url} target="_blank" rel="noopener">source →</a> : null}
              </div>
              {it.performance && perfLine(it.performance) ? (
                <div class="perf">
                  <p class="line">{perfLine(it.performance)}</p>
                  {it.performance.driver ? <p class="q">“{it.performance.driver}”</p> : null}
                  <p class="note">{it.performance.driver ? "figures computed from the filing's XBRL; the words are the company's" : "figures computed from the filing's XBRL"}</p>
                </div>
              ) : null}
            </li>
          ))}
        </ul>
      </section>
    ))
  ) : (
    <p class="empty">The wire refreshes daily from EDGAR; the latest filings will appear here after the next refresh.</p>
  )}

  <style>
    .ahead { margin: 20px 0 6px; padding: 14px 16px; background: var(--accent-tint); border-left: 2px solid var(--accent); }
    .ahead h2 { margin: 0; font-size: 15px; font-family: var(--sans); letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent); }
    .aheadLede { font-family: var(--serif); font-style: italic; font-size: 13px; color: var(--muted); margin: 7px 0 0; line-height: 1.55; max-width: 78ch; }
    .aheadGroup { margin: 10px 0 0; padding: 8px 0 0; border-top: 1px solid var(--rule); font-size: 13px; }
    .gLabel { display: block; color: var(--ink-soft); margin: 0 0 6px; }
    .chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .chip { display: inline-block; padding: 2px 8px; border: 1px solid var(--rule-strong); border-radius: 3px; color: var(--accent); text-decoration: none; font-weight: 600; font-size: 12.5px; font-variant-numeric: tabular-nums; }
    .chip:hover { border-color: var(--accent); text-decoration: underline; }
    .aheadMore { font-size: 12.5px; color: var(--muted); margin: 8px 0 0; font-style: italic; }
    .hd { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .hd h1 { margin: 0; }
    .asof { font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
    .lede { font-family: var(--serif); font-style: italic; font-size: clamp(16px, 2.4vw, 19px); line-height: 1.45; color: var(--ink-soft); margin: 10px 0 26px; max-width: 66ch; }

    .day { margin: 0 0 22px; }
    .date { font-family: var(--sans); font-size: 11.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 0 0 4px; border-bottom: 1px solid var(--rule-strong); padding-bottom: 5px; }
    .date a { color: inherit; text-decoration: none; }
    .date a:hover { color: var(--accent); }
    ul { list-style: none; padding: 0; margin: 0; }
    li { padding: 9px 0; border-bottom: 1px solid var(--rule); }
    .row { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .tkr { font-weight: 700; font-variant-numeric: tabular-nums; flex: 0 0 64px; }
    .tkr a { color: var(--accent); }
    .what { flex: 1 1 auto; min-width: 200px; color: var(--ink); }
    .form { font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--rule); padding: 1px 6px; flex: 0 0 auto; }
    .src { font-size: 12px; color: var(--accent); flex: 0 0 auto; }
    li.grave .what { color: var(--bad); font-weight: 600; }
    li.grave .tkr a { color: var(--bad); }

    .perf { margin: 8px 0 2px; }
    .perf .line { font-size: 13px; color: var(--accent); font-weight: 600; font-variant-numeric: tabular-nums; margin: 0 0 4px; }
    .perf .q { font-family: var(--serif); font-size: 13.5px; line-height: 1.5; color: var(--ink-soft); border-left: 2px solid var(--accent); padding: 2px 0 2px 12px; margin: 5px 0; }
    .perf .note { font-size: 11px; letter-spacing: 0.03em; color: var(--muted); margin: 4px 0 0; }
    .empty { color: var(--muted); font-family: var(--serif); font-style: italic; }
  </style>
</BaseLayout>
