---
import BaseLayout from "../layouts/BaseLayout.astro";
import wire from "../data/wire.json";
import fundamentals from "../data/fundamentals.json";
import upcoming from "../data/upcoming.json";
import { perfLine } from "../lib/wirePerf.mjs";
import { rollToBusinessDay, nextBusinessDays, monthPhrase, estimateRange, fmtMD } from "../lib/filingRhythm.mjs";
import { topLineRevenue } from "../lib/fundamentals.mjs";
import { secondaryListingsCached } from "../lib/listings.mjs";

const known = new Set((fundamentals.companies || []).map((c) => String(c.ticker).toUpperCase()));
const items = wire?.items || [];

const fmtDate = (s) => new Date(s + "T00:00:00Z").toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", timeZone: "UTC" });

// group by filing date, newest first
const groups = [];
for (const it of items) {
  const g = groups.find((x) => x.date === it.date);
  if (g) g.items.push(it);
  else groups.push({ date: it.date, items: [it] });
}

// The performance line (up/down and a percentage per proven line) is shared from lib/wirePerf.mjs,
// so /wire, the per-day page, the Atom feed, the account band and the company page all read alike.

// ---- the week ahead: who files in the next five filing days ----
// REBUILT 2026-07-27. Three things were wrong with this band and one of them was a wrong number.
//
//  1. It ran the estimator the COMPANY PAGE RETIRED on 2026-07-25 — upcoming.json's single point
//     `expected`, which is exactly right 21.9% of the time and systematically late. The page had
//     moved to filingRhythm.estimateRange, a backtested window; the wire never got it.
//  2. The window was TWO business days. On a Monday it could only ever show Monday and Tuesday, so
//     everything reporting Wednesday to Friday was structurally invisible — of the seventeen largest
//     US companies, ZERO appeared. It is now a full filing week, which is what a reader means.
//  3. Selecting on a single guessed DAY meant a company whose window covered today was dropped
//     because its retired point estimate pointed at last week. Tesla and Johnson & Johnson were both
//     in that state on the day this was found. Selection is now by OVERLAP with the window.
//
// The old isSteadyRhythm() filter is gone: estimateRange carries its own, better, backtested gate,
// and running both meant refusing names on a retired test.
//
// WHAT THIS BAND IS NOT. It is filing dates, not earnings dates. A company ANNOUNCES results in an
// 8-K under Item 2.02, filed the day it happens, typically a day or two before the 10-Q — Alphabet
// announced on 2026-07-22 and filed on the 23rd. We looked hard at predicting that announcement from
// each filer's own 2.02 history and REFUSED to publish it: across 75,881 held-out predictions the
// width gate that was supposed to make it honest turned out not to select for accuracy at all
// (ungated 88.2% beat every gate but the narrowest), a filer's perfect run buys nothing (10.1% miss
// after four straight hits against 11.8% unconditional), 2.2% of admitted rows belong to a company
// about to go quiet for a quarter or more, and for filers like Xcel, Danaher and Berkshire the date
// EDGAR stamps is not the date the announcement happened. Above all the asymmetry runs the wrong
// way: when a FILING estimate misses, 87.8% of the time the filing still arrives by the statutory
// deadline printed beside it, so the miss degrades to "earlier than the fact we also gave you". An
// announcement has no deadline behind it, so a miss degrades to a bare falsehood. The lede says
// "files", not "reports", because that is what this is.
const nameOf = new Map((fundamentals.companies || []).map((c) => [String(c.ticker).toUpperCase(), c.name]));
const revOf = new Map((fundamentals.companies || []).map((c) => [String(c.ticker).toUpperCase(), topLineRevenue(c.lines || {}, c) || 0]));
// A preferred series is not a separate company coming due. Alphabet was appearing four times over
// (GOOG, GOOGL, GOOGM, GOOGN) — the same defect the grouping tables shed on 2026-07-27, keyed on the
// filed CIK rather than on the shape of a ticker.
const secondary = secondaryListingsCached(fundamentals.companies || []);
const today = new Date().toISOString().slice(0, 10);
const week = nextBusinessDays(rollToBusinessDay(today), 5);
const weekStart = week[0], weekEnd = week[week.length - 1];
const weekSet = new Set(week);
const alreadyFiled = new Set(items.map((it) => `${String(it.ticker).toUpperCase()}|${it.form}`));

const dueSoon = Object.entries(upcoming.companies || {})
  .map(([t, c]) => ({ t, ...c, range: estimateRange(c, today) }))
  .filter((c) => c.range && !secondary.has(c.t) && !alreadyFiled.has(`${c.t}|${c.nextForm}`))
  // An ESTIMATE belongs in the week when its window overlaps it at all; a DEADLINE belongs when the
  // due date itself lands in it. Two different claims, so they are kept apart and labelled apart.
  .filter((c) => (c.range.kind === "estimate"
    ? c.range.lo <= weekEnd && c.range.hi >= weekStart
    : weekSet.has(rollToBusinessDay(c.range.lo))))
  // LARGEST FIRST (owner ruling, 2026-07-27), the same default order the grouping tables use, on the
  // same reasoning: size is an objective fact, not a judgment. The old order was the ALPHABET, which
  // under a cap kept Apple and dropped Walmart for no reason a reader could defend and held under
  // half the band's revenue. Ties break on ticker so the set is stable across builds.
  .sort((a, b) => (revOf.get(b.t) || 0) - (revOf.get(a.t) || 0) || a.t.localeCompare(b.t));

const AHEAD_CAP = 120;
const shown = dueSoon.slice(0, AHEAD_CAP);
const aheadGroups = [];
for (const kind of ["estimate", "deadline"]) {
  const rows = shown.filter((c) => c.range.kind === kind);
  if (rows.length) aheadGroups.push({ kind, rows });
}
const fmtRange = (r) => (r.kind === "deadline" ? `by ${fmtMD(r.lo)}` : r.lo === r.hi ? fmtMD(r.lo) : `${fmtMD(r.lo)}–${fmtMD(r.hi)}`);
const chipTitle = (c) => {
  const name = nameOf.get(c.t);
  const what = c.nextForm === "10-K" ? `annual report (10-K) for the fiscal year ended ${monthPhrase(c.nextPeriodEnd)}` : `10-Q for the quarter ended ${monthPhrase(c.nextPeriodEnd)}`;
  const when = c.range.kind === "deadline"
    ? `due by ${c.range.lo}`
    : `expected ${c.range.lo} to ${c.range.hi}, from its own last four filings; due by ${c.dueBy}`;
  return `${name ? name + " — " : ""}${what}; ${when}; must file within ${c.statutoryDays} days of period end`;
};
// The results-8-K expected line (UX survey item 22): only an 8-K whose label says results were
// reported, only a company the week-ahead model knows, and only when the announced period's
// periodic filing has not already arrived. An estimate window prints as a range; where the
// window says nothing, the statutory deadline prints as the fact it is; where neither exists,
// silence.
const expectedLine = (it) => {
  if (it.form !== "8-K" || it.label !== "Reported results") return null;
  const t = String(it.ticker).toUpperCase();
  const up = (upcoming.companies || {})[t];
  if (!up?.nextForm || !/^10-[KQ]/.test(up.nextForm)) return null;
  if (alreadyFiled.has(t + "|" + up.nextForm)) return null;
  const range = estimateRange(up, today);
  if (!range) return null;
  return range.kind === "estimate"
    ? `figures arrive with the ${up.nextForm} · expected ${fmtMD(range.lo)}–${fmtMD(range.hi)}`
    : `figures arrive with the ${up.nextForm} · due by ${fmtMD(range.lo)}`;
};
---

<BaseLayout title="The Filing Wire, Owner Scorecard">
  <header class="hd">
    <h1>The Filing Wire</h1>
    {wire?.asOf ? <span class="asof">filings as of {wire.asOf} · refreshed daily</span> : null}
  </header>
  <p class="lede">
    Every new filing across the
    catalog, straight from EDGAR, newest first, with the 8-K codes translated into plain English. The grave
    ones (an auditor change, a restatement, a default) announce themselves.
  </p>

  {dueSoon.length ? (
    <section class="ahead">
      <h2>The week ahead</h2>
      <p class="aheadLede">
        Who <b>files</b> between {fmtMD(weekStart)} and {fmtMD(weekEnd)}, largest first. An
        <b> expected</b> date is a window drawn from that filer&rsquo;s own last four filings, shown
        only where it closes before the report is legally due; everything else carries the
        <b> due-by</b> date, which is the statute for its filer class and a filed fact. Companies
        announce results separately, in an 8-K a day or two earlier, and we do not estimate that
        date &mdash; nothing here is announced by the companies.
      </p>
      {aheadGroups.map((g) => (
        <div class="aheadGroup">
          <span class="gLabel">{g.kind === "estimate" ? "expected, from each filer's own record" : "due by, the statutory date"}</span>
          <span class="chips">
            {g.rows.map((c) => (
              <a class="chip" href={`/c/${c.t}`} title={chipTitle(c)} aria-label={chipTitle(c)}>
                {c.t}<span class="cWhen">{fmtRange(c.range)}</span>
              </a>
            ))}
          </span>
        </div>
      ))}
      {dueSoon.length > AHEAD_CAP ? <p class="aheadMore">…and {dueSoon.length - AHEAD_CAP} smaller companies also file this week; the list stops at the {AHEAD_CAP} largest.</p> : null}
    </section>
  ) : null}

  {items.length ? (
    groups.map((g) => (
      <section class="day">
        <h2 class="date"><a href={`/wire/${g.date}`}>{fmtDate(g.date)}</a></h2>
        <ul>
          {g.items.map((it) => (
            <li class={it.grave ? "grave" : ""}>
              <div class="row">
                <span class="tkr">{known.has(it.ticker) ? <a href={`/c/${it.ticker}`}>{it.ticker}</a> : it.ticker}</span>
                <span class="what">{it.label}</span>
                <span class="form">{it.form}</span>
                {it.url ? <a class="src" href={it.url} target="_blank" rel="noopener">source →</a> : null}
              </div>
              {/* A results 8-K announces; the figures arrive with the periodic filing. The line
                  names when, from the same backtested window the week-ahead band prints — an
                  estimate range where one exists, the statutory due date as the fact behind it
                  otherwise. No press-release parsing, no earnings-date guess (refused above). */}
              {expectedLine(it) ? <p class="expect">{expectedLine(it)}</p> : null}
              {it.performance && perfLine(it.performance) ? (
                <div class="perf">
                  <p class="line">{perfLine(it.performance)}</p>
                  {it.performance.driver ? <p class="q">“{it.performance.driver}”</p> : null}
                  <p class="note">{it.performance.driver ? "figures computed from the filing's XBRL; the words are the company's" : "figures computed from the filing's XBRL"}</p>
                </div>
              ) : null}
            </li>
          ))}
        </ul>
      </section>
    ))
  ) : (
    <p class="empty">The wire refreshes daily from EDGAR; the latest filings will appear here after the next refresh.</p>
  )}

  <style>
    .ahead { margin: 20px 0 6px; padding: 14px 16px; background: var(--accent-tint); border-left: 2px solid var(--accent); }
    .ahead h2 { margin: 0; font-size: 15px; font-family: var(--sans); letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent); }
    .aheadLede { font-family: var(--serif); font-style: italic; font-size: 13px; color: var(--muted); margin: 7px 0 0; line-height: 1.55; max-width: 78ch; }
    .aheadGroup { margin: 10px 0 0; padding: 8px 0 0; border-top: 1px solid var(--rule); font-size: 13px; }
    .gLabel { display: block; color: var(--ink-soft); margin: 0 0 6px; }
    .chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .chip { display: inline-block; padding: 2px 8px; border: 1px solid var(--rule-strong); border-radius: 3px; color: var(--accent); text-decoration: none; font-weight: 600; font-size: 12.5px; font-variant-numeric: tabular-nums; }
    .chip:hover { border-color: var(--accent); text-decoration: underline; }
    .cWhen { display: block; font-size: 10.5px; font-weight: 400; color: var(--muted); letter-spacing: 0; margin-top: 1px; }
    .aheadMore { font-size: 12.5px; color: var(--muted); margin: 8px 0 0; font-style: italic; }
    .hd { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .hd h1 { margin: 0; }
    .asof { font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
    .lede { font-family: var(--serif); font-style: italic; font-size: clamp(16px, 2.4vw, 19px); line-height: 1.45; color: var(--ink-soft); margin: 10px 0 26px; max-width: 66ch; }

    .day { margin: 0 0 22px; }
    .date { font-family: var(--sans); font-size: 11.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 0 0 4px; border-bottom: 1px solid var(--rule-strong); padding-bottom: 5px; }
    .date a { color: inherit; text-decoration: none; }
    .date a:hover { color: var(--accent); }
    ul { list-style: none; padding: 0; margin: 0; }
    li { padding: 9px 0; border-bottom: 1px solid var(--rule); }
    .row { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .tkr { font-weight: 700; font-variant-numeric: tabular-nums; flex: 0 0 64px; }
    .tkr a { color: var(--accent); }
    .what { flex: 1 1 auto; min-width: 200px; color: var(--ink); }
    .form { font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--rule); padding: 1px 6px; flex: 0 0 auto; }
    .src { font-size: 12px; color: var(--accent); flex: 0 0 auto; }
    li.grave .what { color: var(--bad); font-weight: 600; }
    li.grave .tkr a { color: var(--bad); }

    .perf { margin: 8px 0 2px; }
    .perf .line { font-size: 13px; color: var(--accent); font-weight: 600; font-variant-numeric: tabular-nums; margin: 0 0 4px; }
    .perf .q { font-family: var(--serif); font-size: 13.5px; line-height: 1.5; color: var(--ink-soft); border-left: 2px solid var(--accent); padding: 2px 0 2px 12px; margin: 5px 0; }
    .perf .note { font-size: 11px; letter-spacing: 0.03em; color: var(--muted); margin: 4px 0 0; }
    .empty { color: var(--muted); font-family: var(--serif); font-style: italic; }
    .expect { font-size: 11.5px; color: var(--muted); margin: 3px 0 0; }
  </style>
</BaseLayout>
