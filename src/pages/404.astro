---
// The 404 IS the front door: the search box, offered again. A mistyped ticker or a stale
// external link is how a serious reader arrives; hand them the catalog, not a dead end.
// Astro emits this as 404.html and the Workers static-asset layer serves it for any
// unmatched route.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found, Owner Scorecard" noindex={true}>
  <section class="nf">
    <h1>No record at this address</h1>
    <p class="sub">
      The page may have moved, or the ticker may be spelled differently (addresses here are
      uppercase: <a href="/c/ADBE">/c/ADBE</a>). 
    </p>
    <p class="actions">
      <button type="button" class="nfSearch" onclick="document.getElementById('siteSearchOpen')?.click()">Search the catalog</button>
    </p>
    <p class="links">
      Or start from <a href="/">the catalog</a>, <a href="/notes">the Notes</a>,
      <a href="/wire">the wire</a>, or <a href="/concepts">the principles</a>.
    </p>
  </section>

  <style>
    .nf { max-width: 560px; margin-top: 24px; }
    .nf h1 { margin: 0 0 10px; }
    .sub { color: var(--ink-dim); }
    .actions { margin: 18px 0; }
    .nfSearch {
      font-family: var(--sans); font-size: 14px; font-weight: 600; padding: 10px 18px;
      border: 0; border-radius: 6px; background: var(--solid); color: var(--solid-ink); cursor: pointer;
    }
    .links { font-size: 14.5px; color: var(--muted); }
  </style>
</BaseLayout>
