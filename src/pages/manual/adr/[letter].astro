---
// The Manual, volume two (ADRs), one page per first letter of the ticker —
// docs/discovery-design.md feature 2. Foreign filers on US exchanges, figures as filed in each
// company's home currency; otherwise identical in form to volume one, because the fixed format
// is the point.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ManualPage from "../../../components/ManualPage.astro";
import fundamentals from "../../../data/fundamentals.json";
import adrData from "../../../data/fundamentals.adr.json";
import jpData from "../../../data/fundamentals.jp.json";
import language from "../../../data/language.json";
import { manualOrder, manualPageChain } from "../../../lib/manual.mjs";
import { computeLenses } from "../../../lib/lenses.mjs";

export function getStaticPaths() {
  const { volumes } = manualOrder(fundamentals.companies, adrData.companies, jpData.companies);
  const vol = volumes.find((v) => v.key === "adr");
  return [...vol.letters.keys()].map((L) => ({ params: { letter: L.toLowerCase() } }));
}

const letter = String(Astro.params.letter || "").toUpperCase();
const { volumes, total } = manualOrder(fundamentals.companies, adrData.companies, jpData.companies);
const vol = volumes.find((v) => v.key === "adr");
const entries = vol.letters.get(letter) || [];

const chain = manualPageChain(volumes);
const idx = chain.findIndex((p) => p.volKey === "adr" && p.letter === letter);
const rail = chain.filter((p) => p.volKey === "adr").map((p) => ({ letter: p.letter, href: p.href }));

const lenses = computeLenses(
  [...(fundamentals.companies || []), ...(adrData.companies || [])],
  language.companies
).byTicker;
---

<BaseLayout
  title={`The Manual: ADRs, ${letter} — Owner Scorecard`}
  description={`Volume two of the Manual: the ${entries.length.toLocaleString()} ADRs whose tickers begin with ${letter}, each as the same five-line record, figures as filed, in strict alphabetical order.`}
>
  <ManualPage
    vol={vol}
    letter={letter}
    entries={entries}
    prevPage={idx > 0 ? chain[idx - 1] : null}
    nextPage={idx >= 0 && idx < chain.length - 1 ? chain[idx + 1] : null}
    lenses={lenses}
    total={total}
    rail={rail}
  />
</BaseLayout>
