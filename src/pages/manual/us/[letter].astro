---
// The Manual, volume one (United States), one page per first letter of the ticker —
// docs/discovery-design.md feature 2. Every company under the letter as an Entry Block, in strict
// alphabetical order, with prev/next page links; no sort controls, no filters.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ManualPage from "../../../components/ManualPage.astro";
import fundamentals from "../../../data/fundamentals.json";
import adrData from "../../../data/fundamentals.adr.json";
import jpData from "../../../data/fundamentals.jp.json";
import { manualOrder, manualPageChain } from "../../../lib/manual.mjs";

export function getStaticPaths() {
  const { volumes } = manualOrder(fundamentals.companies, adrData.companies, jpData.companies);
  const vol = volumes.find((v) => v.key === "us");
  return [...vol.letters.keys()].map((L) => ({ params: { letter: L.toLowerCase() } }));
}

const letter = String(Astro.params.letter || "").toUpperCase();
const { volumes, total } = manualOrder(fundamentals.companies, adrData.companies, jpData.companies);
const vol = volumes.find((v) => v.key === "us");
const entries = vol.letters.get(letter) || [];

const chain = manualPageChain(volumes);
const idx = chain.findIndex((p) => p.volKey === "us" && p.letter === letter);
const rail = chain.filter((p) => p.volKey === "us").map((p) => ({ letter: p.letter, href: p.href }));

---

<BaseLayout
  title={`The Manual: United States, ${letter} — Owner Scorecard`}
  description={`Volume one of the Manual: the ${entries.length.toLocaleString()} United States companies whose tickers begin with ${letter}, each as the same four-line record, in strict alphabetical order.`}
>
  <ManualPage
    vol={vol}
    letter={letter}
    entries={entries}
    prevPage={idx > 0 ? chain[idx - 1] : null}
    nextPage={idx >= 0 && idx < chain.length - 1 ? chain[idx + 1] : null}
    total={total}
    rail={rail}
  />
</BaseLayout>
