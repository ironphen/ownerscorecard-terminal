---
import BaseLayout from "../../layouts/BaseLayout.astro";
import jp from "../../data/fundamentals.jp.json";
import TenYear from "../../components/TenYear.astro";
import OwnerEarningsBridge from "../../components/OwnerEarningsBridge.astro";
import Scorecard from "../../components/Scorecard.astro";
import Capital from "../../components/Capital.astro";
import Inversion from "../../components/Inversion.astro";
import Valuation from "../../components/Valuation.astro";
import CompareLink from "../../components/CompareLink.astro";
import ActHeader from "../../components/ActHeader.astro";
import Segments from "../../components/Segments.astro";
import notes from "../../data/notes.json";
import { pickNote } from "../../lib/business.mjs";
import fundamentals from "../../data/fundamentals.json";
import adrData from "../../data/fundamentals.adr.json";
import { manualOrder, manualHref } from "../../lib/manual.mjs";
import { industryOrder, chapterMemberHref } from "../../lib/chapters.mjs";

// The Japanese pool, a separate route and a separate dataset from the US catalog. These
// pages are quantitative by design: the figures are read straight from each company's
// EDINET annual securities report, but the Japanese-language narrative (the business
// description, the risk factors, what changed) is not parsed, so the page says so plainly
// rather than guess. Everything quantitative, the record, normalized earnings, the
// scorecard, capital allocation, the inversion checks and the reverse-DCF, is the same
// machinery the US pages use, run in yen, and lights up now that the deeper EDINET capex
// history gives the Japanese names a full owner-earnings record.
export function getStaticPaths() {
  return (jp.companies || []).map((c) => ({ params: { ticker: String(c.ticker) } }));
}

const ticker = String(Astro.params.ticker || "");
const fund = (jp.companies || []).find((c) => String(c.ticker) === ticker) || null;
const name = fund?.name || "";
// A reviewed, hand-written business note (docs/qualitative-doctrine.md) is the one
// narrative these otherwise quantitative pages carry: the Japanese-language filing is
// not machine-read, so for the names a human has written up we surface the reviewed
// note instead, grounded in the filing and the company's established facts. Absent a
// note, the page stays quantitative-only and says so.
const note = fund ? pickNote(notes, ticker) : null;

// This company's place in the Manual (docs/discovery-design.md feature 2): prev/next securities
// code within the Japan volume, so reading proceeds page to page. Same memoized order the manual
// pages render.
const man = manualOrder(fundamentals.companies || [], adrData.companies || [], jp.companies || []);
const manEntry = fund ? man.neighbors[`jp:${ticker}`] || null : null;
const manPlace = manEntry ? manualHref("jp", ticker) : null;

// And its place in its industry chapter (feature 3): JP industry labels share the US/ADR label
// space (lib/shelves.mjs), so a neighbor here can be a US or ADR name on /c/. Same memoized order
// the chapter pages render.
const indOrder = industryOrder(fundamentals.companies || [], adrData.companies || [], jp.companies || []);
const indEntry = fund ? indOrder.neighbors[`jp:${ticker}`] || null : null;
const chapterHref = indEntry ? `/industries/${indEntry.slug}` : null;

const SECTOR_LABEL = {
  assetLight: "Asset-light compounder",
  consumer: "Consumer & brand",
  capital: "Capital-intensive",
  retail: "Trading & distribution",
  general: "Diversified",
};
const sectorLabel = fund ? SECTOR_LABEL[fund.sector] || "Diversified" : null;
---

<BaseLayout title={`${ticker} ${name}, Owner Scorecard (Japan)`}>
  <p class="back">
    <a href="/japan">← Japan catalog</a>
    {manEntry ? (
      <span class="manNav">
        {manEntry.prev ? <a href={`/jp/${manEntry.prev}`}>← {manEntry.prev}</a> : null}
        <a class="manIn" href={manPlace}>Manual</a>
        {manEntry.next ? <a href={`/jp/${manEntry.next}`}>{manEntry.next} →</a> : null}
      </span>
    ) : null}
    {indEntry ? (
      <span class="manNav">
        {indEntry.prev ? (
          <a href={chapterMemberHref(indEntry.prev)} title={`Previous in ${indEntry.label}`}>← {indEntry.prev.ticker}</a>
        ) : null}
        <a class="manIn" href={chapterHref} title={`The ${indEntry.label} chapter`}>{indEntry.label}</a>
        {indEntry.next ? (
          <a href={chapterMemberHref(indEntry.next)} title={`Next in ${indEntry.label}`}>{indEntry.next.ticker} →</a>
        ) : null}
      </span>
    ) : null}
  </p>

  {fund ? (
    <>
      <header class="hero" id="top">
        <h1>{ticker} · {name}</h1>
        <div class="ident">
          {chapterHref ? (
            <a class="ichip" href={chapterHref} title={`The ${indEntry.label} chapter`}>{fund.industry}</a>
          ) : (
            <span class="ichip">{fund.industry}</span>
          )}
          <span class="model">{sectorLabel}</span>
          <span class="jp">Japan · ¥</span>
          {fund.accountingStandard ? <span class="std">{fund.accountingStandard}</span> : null}
        </div>
        <div class="meta">Latest filing: FY{fund.fy} annual securities report (有価証券報告書) · EDINET</div>
      </header>

      <section class="band note">
        {note ? (
          <p>
            The numbers below are read directly from {name}&rsquo;s EDINET filing, in yen. The
            Japanese-language narrative is not machine-read; the short business note that follows
            is written and reviewed by hand, grounded in the filing and the company&rsquo;s
            established facts.
            <a href={fund.sourceUrl} target="_blank" rel="noopener"> Find it on EDINET (code {ticker}) →</a>
          </p>
        ) : (
          <p>
            This is a quantitative scorecard. The numbers below are read directly from
            {name}&rsquo;s EDINET filing, in yen. The Japanese-language narrative, what the
            business does, its risks, what changed this year, is not machine-read here, so we
            do not paraphrase it. 
            <a href={fund.sourceUrl} target="_blank" rel="noopener"> Find it on EDINET (code {ticker}) →</a>
          </p>
        )}
      </section>

      {note ? (
        <section id="sec-business" class="brief sec">
          <h3 class="secTitle">The business in brief</h3>
          <dl class="reads">
            {note.whatItIs ? (
              <div class="r"><dt>What it is</dt><dd>{note.whatItIs}</dd></div>
            ) : null}
            {note.needle ? (
              <div class="r"><dt>What moves the needle</dt><dd>{note.needle}</dd></div>
            ) : null}
          </dl>
          <p class="briefFoot">
            Written and reviewed by hand, grounded in the filing and the company&rsquo;s established
            facts.
          </p>
        </section>
      ) : null}

      <div id="sec-mix" class="sec"><Segments company={fund} /></div>

      <section class="actGroup">
        <ActHeader n="I" title="The record" lede="What the business has done across the cycle, read straight from the EDINET filing: the multi-year record, and the walk from reported profit to the cash an owner could take out." />
        <div id="sec-record" class="sec"><TenYear company={fund} /></div>
        <div id="sec-bridge" class="sec"><OwnerEarningsBridge company={fund} /></div>
      </section>

      <section class="actGroup">
        <ActHeader n="II" title="Quality &amp; stewardship" lede="Returns, the balance sheet, and stewardship. The same checks the US pages run, in yen." />
        <div id="sec-scorecard" class="sec"><Scorecard company={fund} /></div>
        <div id="sec-capital" class="sec"><Capital company={fund} /></div>
        <div id="sec-inversion" class="sec"><Inversion company={fund} /></div>
      </section>

      <section class="actGroup">
        <ActHeader n="III" title="The price" lede="What a price would have to assume, set against the record above." />
        <div id="sec-price" class="sec"><Valuation company={fund} /><CompareLink company={fund} /></div>
      </section>

      <p class="foot">
        Figures from EDINET, the Financial Services Agency&rsquo;s disclosure system, the
        same kind of filing the US pages draw from EDGAR. A separate
        pool: these names never pass through the US industry classifier.
      </p>

      {manEntry ? (
        <p class="manFoot">
          Manual order: {manEntry.prev ? <a href={`/jp/${manEntry.prev}`}>← {manEntry.prev}</a> : null}
          <a href={manPlace}>its page in the Manual</a>
          {manEntry.next ? <a href={`/jp/${manEntry.next}`}>{manEntry.next} →</a> : null}
        </p>
      ) : null}

      {indEntry ? (
        <p class="manFoot indFoot">
          Industry order: {indEntry.prev ? (
            <a href={chapterMemberHref(indEntry.prev)} title={`Previous in ${indEntry.label}`}>← {indEntry.prev.ticker}</a>
          ) : null}
          <a href={chapterHref}>the {indEntry.label} chapter</a>
          {indEntry.next ? (
            <a href={chapterMemberHref(indEntry.next)} title={`Next in ${indEntry.label}`}>{indEntry.next.ticker} →</a>
          ) : null}
        </p>
      ) : null}
    </>
  ) : (
    <p>Nothing here for {ticker} yet.</p>
  )}

  <style>
    .back { margin: 0 0 10px; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .manNav { display: inline-flex; gap: 12px; align-items: baseline; font-size: 12.5px; }
    .manNav a { font-family: var(--sans); font-weight: 600; }
    .manNav .manIn { font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
    .manNav .manIn:hover { color: var(--accent); }
    .manFoot { display: flex; gap: 14px; align-items: baseline; justify-content: center; font-size: 12.5px; border-top: 1px solid var(--rule); margin-top: 20px; padding-top: 12px; flex-wrap: wrap; }
    .manFoot a { font-family: var(--sans); font-weight: 600; }
    .indFoot { border-top: 0; margin-top: 6px; padding-top: 0; }
    .hero h1 { margin: 0; }
    .ident { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: 8px 0 0; }
    .ichip { font-family: var(--sans); font-size: 11.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); border: 1px solid var(--rule-strong); padding: 2px 8px; }
    a.ichip { text-decoration: none; }
    a.ichip:hover { color: var(--accent); border-color: var(--accent); }
    .model { font-family: var(--sans); font-size: 11.5px; letter-spacing: 0.03em; color: var(--muted); }
    .jp { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent); border: 1px solid var(--accent); padding: 1px 7px; border-radius: 2px; }
    .std { font-family: var(--sans); font-size: 10px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--rule); padding: 1px 6px; }
    .meta { color: var(--ink-dim); font-size: 13px; margin-top: 8px; }

    .note { margin: 18px 0 0; background: var(--accent-tint); border-left: 2px solid var(--accent); padding: 12px 16px; }
    .note p { font-size: 14px; line-height: 1.6; color: var(--ink-soft); margin: 0; max-width: 76ch; }
    .note b { color: var(--ink); }
    .note a { color: var(--accent); white-space: nowrap; }

    /* The reviewed business note: the one narrative a JP page carries, styled to match
       the US "business in brief". */
    .brief { margin: 22px 0 0; }
    .brief .secTitle { font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); border-bottom: 1px solid var(--rule-strong); padding-bottom: 6px; margin: 0; }
    .brief .reads { margin: 12px 0 0; }
    .brief .r { display: grid; grid-template-columns: 190px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
    .brief .r dt { font-family: var(--sans); font-weight: 700; font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
    .brief .r dd { margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--ink-soft); max-width: 72ch; }
    .briefFoot { font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--muted); border-top: 1px solid var(--rule-strong); margin-top: 14px; padding-top: 10px; max-width: 72ch; }
    @media (max-width: 560px) { .brief .r { grid-template-columns: 1fr; gap: 4px; } }

    .sec { scroll-margin-top: 16px; }
    .foot { font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--muted); margin: 20px 0 0; line-height: 1.5; max-width: 76ch; border-top: 1px solid var(--rule); padding-top: 12px; }
  </style>
</BaseLayout>
