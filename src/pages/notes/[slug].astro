---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { ORG } from "../../lib/seo.mjs";
import fundamentals from "../../data/fundamentals.json";
import adrFundamentals from "../../data/fundamentals.adr.json";
import Cite from "../../components/Cite.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const fmtDate = (d) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

// Reading time from the raw MDX body: strip frontmatter-adjacent syntax crudely and count words
// at 230 wpm. An honest affordance for a long read, not engagement bait; shown once in the meta row.
const words = (article.body || "").replace(/```[\s\S]*?```|<[^>]+>|[#*_>\[\]()`]/g, " ").split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(words / 230));

// End-of-note wayfinding: the reader's intent peaks at the last paragraph, so the records behind
// the note, and the neighboring notes, are offered there rather than abandoning them at the footer.
const allCompanies = [...(fundamentals.companies || []), ...(adrFundamentals.companies || [])];
const recordLinks = article.data.tickers.map((t) => {
  const c = allCompanies.find((x) => String(x.ticker || "").toUpperCase() === t.toUpperCase());
  return { ticker: t.toUpperCase(), name: c?.name || t.toUpperCase() };
});
const published = (
  await getCollection("articles", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const idx = published.findIndex((a) => a.id === article.id);
const newer = idx > 0 ? published[idx - 1] : null;
const older = idx >= 0 && idx < published.length - 1 ? published[idx + 1] : null;

// Structured data: the Note as an Article, authored and published by the publication itself —
// notes carry Owner Scorecard's name, not a personal byline, by choice. `about` links each
// covered ticker to its scorecard so machines connect the essay to the company pages.
const description = article.data.description || `${article.data.title}, a research note from Owner Scorecard.`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const iso = (d) => d.toISOString().slice(0, 10);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.data.title,
  description,
  datePublished: iso(article.data.date),
  dateModified: iso(article.data.updated || article.data.date),
  author: ORG,
  publisher: ORG,
  mainEntityOfPage: canonical,
  ...(article.data.tickers.length
    ? {
        about: article.data.tickers.map((t) => ({
          "@type": "Corporation",
          tickerSymbol: t,
          url: new URL(`/c/${t}`, Astro.site).href,
        })),
      }
    : {}),
};
---

<BaseLayout title={`${article.data.title}, Owner Scorecard`} description={description} ogType="article" jsonLd={jsonLd}>
  <p class="back"><a href="/notes">← Notes</a></p>

  <article>
    <header class="hero">
      <h1>{article.data.title}</h1>
      <div class="meta">
        <span class="section">{article.data.section}</span>
        {article.data.draft ? <span class="draft">draft</span> : null}
        {fmtDate(article.data.date)}
        {article.data.updated ? ` · updated ${fmtDate(article.data.updated)}` : ""}
        {` · ${readMinutes} min read`}
      </div>
      {article.data.tickers.length ? (
        <div class="tickers">
          {article.data.tickers.map((t) => (
            <a href={`/c/${t}`}>{t}</a>
          ))}
        </div>
      ) : null}
    </header>

    <div class="body">
      <Content />
    </div>

    {article.data.corrections.length ? (
      <aside class="corrections">
        <h2 class="corrTitle">Corrections</h2>
        <ul class="corrList">
          {article.data.corrections.map((c) => (
            <li><span class="corrDate">{fmtDate(c.date)}</span> {c.note}</li>
          ))}
        </ul>
      </aside>
    ) : null}

    {recordLinks.length ? (
      <aside class="after">
        <h2 class="afterTitle">The records behind this note</h2>
        <ul class="afterList">
          {recordLinks.map((r) => (
            <li>
              <a href={`/c/${r.ticker}`}>{r.name}</a>
              <span class="afterTicker">{r.ticker}</span>
            </li>
          ))}
        </ul>
        {newer || older ? (
          <p class="afterNav">
            {older ? <a href={`/notes/${older.id}`}>← {older.data.title}</a> : <span />}
            {newer ? <a href={`/notes/${newer.id}`}>{newer.data.title} →</a> : null}
          </p>
        ) : null}
      </aside>
    ) : null}

    <Cite citation={`Owner Scorecard, "${article.data.title}," ${canonical.replace(/\/$/, "")}, ${fmtDate(article.data.date)}${article.data.updated ? `, updated ${fmtDate(article.data.updated)}` : ""}.`} />
  </article>

  <style>
    .back { margin: 0 0 10px; }
    .hero h1 { margin: 0; }
    .meta { color: var(--ink-dim); font-size: 14px; margin-top: 6px; }
    .section {
      border: 1px solid var(--rule);
      padding: 1px 6px;
      margin-right: 8px;
      font-size: 11px;
      letter-spacing: 0.4px;
      text-transform: uppercase;
    }
    .draft { color: var(--bad); margin-right: 8px; font-size: 11px; text-transform: uppercase; }
    .tickers { margin-top: 6px; font-size: 14px; }
    .tickers a { font-weight: 700; margin-right: 10px; }

    .body { margin-top: 18px; font-size: 17px; line-height: 1.55; max-width: 70ch; }
    /* Any table an author drops into a note scrolls inside itself instead of breaking the page on
       a phone; company-page tables have their own wrappers, notes get the guard here. */
    .body :global(table) { display: block; overflow-x: auto; max-width: 100%; }

    .corrections { margin-top: 28px; border: 1px solid var(--rule); padding: 12px 16px; max-width: 70ch; }
    .corrTitle { font-size: 14px; margin: 0 0 8px; font-family: var(--sans); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
    .corrList { list-style: none; margin: 0; padding: 0; font-size: 14.5px; color: var(--ink-soft); }
    .corrList li { margin: 0 0 6px; }
    .corrDate { font-family: var(--sans); font-size: 12px; color: var(--muted); margin-right: 8px; }

    .after { margin-top: 40px; border-top: 1px solid var(--rule-strong); padding-top: 16px; max-width: 70ch; }
    .afterTitle { font-size: 16px; margin: 0 0 10px; }
    .afterList { list-style: none; margin: 0; padding: 0; }
    .afterList li { padding: 7px 0; border-bottom: 1px solid var(--rule-soft); display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
    .afterList a { font-weight: 600; }
    .afterTicker { font-family: var(--sans); font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
    .afterNav { display: flex; justify-content: space-between; gap: 16px; margin-top: 16px; font-size: 14px; }
    .body :global(h2) { border-bottom: 1px solid var(--rule); padding-bottom: 4px; margin-top: 28px; }
    .body :global(blockquote) {
      border-left: 2px solid var(--ink);
      margin: 16px 0;
      padding: 2px 0 2px 14px;
      color: var(--ink-soft);
    }
    .body :global(code) { font-size: 0.85em; background: var(--surface-2); padding: 1px 4px; }
    .body :global(pre) { background: var(--surface-2); padding: 12px; overflow-x: auto; font-size: 13px; }
    .body :global(pre code) { background: none; padding: 0; }
    .body :global(img) { max-width: 100%; }
    .body :global(table) { border-collapse: collapse; }
    .body :global(td), .body :global(th) { border-bottom: 1px solid var(--rule); padding: 6px 10px; }
  </style>
</BaseLayout>
