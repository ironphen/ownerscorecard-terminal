---
import BaseLayout from "../layouts/BaseLayout.astro";
import fundamentals from "../data/fundamentals.json";
import { getCollection } from "astro:content";
import jpData from "../data/fundamentals.jp.json";
import adrData from "../data/fundamentals.adr.json";
import euData from "../data/fundamentals.eu.json";
import wire from "../data/wire.json";
import { SHELVES, industryLabelOf } from "../lib/shelves.mjs";
import { GROUPINGS } from "../lib/groupingColumns.mjs";
import { ORG } from "../lib/seo.mjs";
const jpCount = (jpData.companies || []).length;
const adrCount = (adrData.companies || []).length;
const euCount = (euData.companies || []).length;

// The front door is a search box, not a screener. A screener pulls toward a verdict — filter to "the
// ones that pass" and you have implied they are the good ones, the one thing we never do. So instead
// the door is open to all of them at once: one bar that reaches every business we cover, in every
// pool, the way you'd walk up to a reference desk and name the company you came to read. Behind a
// small link sits the full catalog (/catalog, its own server-rendered page) — Buffett's "open the
// manuals and start with the A's" — for the reader who'd rather browse than search. The search box
// reads its index from /company-index.json, fetched once and cached, so the front door ships light
// instead of carrying every catalog row in hidden DOM.
const usTickers = (fundamentals.companies || []).map((c) => String(c.ticker || "").toUpperCase()).filter(Boolean);

const totalCount = usTickers.length + jpCount + adrCount + euCount;
const totalLabel = totalCount.toLocaleString("en-US");

const articles = (
  await getCollection("articles", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmtDate = (d) => d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });

// Starter examples — names (not tickers) so they resolve regardless of ticker form, and a deliberate
// spread: a tech compounder, a classic brand, a conglomerate, a retailer, a foreign great.
const STARTERS = ["Apple", "Coca-Cola", "Berkshire", "Costco", "Toyota", "Visa"];

// The groupings door, surfaced inside the empty-and-focused search box as a second door: search a
// name, or browse the catalog arranged by what the businesses do. The count comes from the same
// pass the /groupings page runs, so the door can never disagree with the page it links to.
const labelToNoun = new Map();
for (const sh of SHELVES) for (const ind of sh.industries) labelToNoun.set(ind.label, sh.noun);
const countByNoun = new Map();
for (const c of [...(fundamentals.companies || []), ...(adrData.companies || []), ...(jpData.companies || [])]) {
  const noun = labelToNoun.get(industryLabelOf(c));
  if (noun) countByNoun.set(noun, (countByNoun.get(noun) || 0) + 1);
}
const groupingsN = GROUPINGS.filter((g) => (countByNoun.get(g.noun) || 0) > 0).length;

// The wire, distilled for the front door: the newest filings across the catalog, results and reports
// first, so the reader lands on something CURRENT and can step straight into the company. Not a screener
// and not a market ticker — just what companies disclosed, one row per company (its most significant
// recent filing), earnings ahead of housekeeping, capped as a teaser onto the full wire.
const KNOWN = new Set(usTickers);
const isEarnings = (it) =>
  it.form === "10-K" || it.form === "10-Q" ||
  /reported results|results of operations|quarterly report|annual report/i.test(it.label || "");
const filingSig = (it) => (isEarnings(it) ? 2 : it.grave ? 1 : 0);
const wireByTicker = new Map();
for (const it of wire?.items || []) {
  const tk = String(it.ticker || "").toUpperCase();
  if (!tk || !KNOWN.has(tk)) continue;
  const prev = wireByTicker.get(tk);
  if (!prev || filingSig(it) > filingSig(prev) || (filingSig(it) === filingSig(prev) && it.date > prev.date))
    wireByTicker.set(tk, it);
}
const wireFeed = [...wireByTicker.values()]
  .sort((a, b) =>
    filingSig(b) - filingSig(a) ||
    (a.date < b.date ? 1 : a.date > b.date ? -1 : 0) ||
    String(a.ticker).localeCompare(String(b.ticker)))
  .slice(0, 8);
const fmtWireDate = (s) => new Date(s + "T00:00:00Z").toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
---

<BaseLayout
  title="Owner Scorecard"
  description="Learn and navigate the world's massive universe of marketable securities and the businesses that they represent in an efficient manner."
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Owner Scorecard",
      url: new URL("/", Astro.site).href,
      publisher: { "@id": new URL("/#organization", Astro.site).href },
    },
    { "@context": "https://schema.org", ...ORG },
  ]}
>
  <!-- ============================ SEARCH (the default door) ============================ -->
  <section id="searchView">
    <div class="omni" id="omniBox">
      <div class="omniField">
        <svg class="omniIcon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          id="omni"
          type="search"
          placeholder={`Search ${totalLabel} companies by name or ticker…`}
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="Search every company by name or ticker"
          role="combobox"
          aria-expanded="false"
          aria-controls="omniResults"
          aria-autocomplete="list"
        />
        <kbd class="omniKbd" aria-hidden="true">/</kbd>
      </div>

      <div class="omniPanel" id="omniPanel" hidden>
        <div class="omniDefault" id="omniDefault" hidden>
          <a class="odConf" href="/groupings">
            <span class="odConfT">Browse the groupings</span>
            <span class="odConfN">every business by what it does · {groupingsN.toLocaleString()} comparative tables →</span>
          </a>
        </div>
        <div class="omniCount" id="omniCount" aria-live="polite"></div>
        <ul class="omniResults" id="omniResults" role="listbox" aria-label="Matching companies"></ul>
        <p class="omniEmpty" id="omniEmpty" hidden>No company matches that. Try a ticker, or part of a name.</p>
      </div>

      <div class="chips" id="omniChips">
        <span class="chipLbl">Try</span>
        {STARTERS.map((s) => <button type="button" class="chip" data-q={s}>{s}</button>)}
      </div>
    </div>

    {wireFeed.length ? (
      <section class="wire">
        <div class="bandHead">
          <h2>Fresh from the wire</h2>
          <a class="all" href="/wire">The full wire →</a>
        </div>
        <p class="wireLede">
          The newest filings across the
          catalog{wire?.asOf ? `, as of ${fmtWireDate(wire.asOf)}` : ""}, the ones reporting results first.
        </p>
        <ul class="wireList">
          {wireFeed.map((it) => (
            <li class={`wf${isEarnings(it) ? " earn" : ""}${it.grave ? " grave" : ""}`}>
              <a class="wfCo" href={`/c/${it.ticker}`}>
                <span class="wfTkr">{it.ticker}</span>
                <span class="wfName">{it.name}</span>
              </a>
              <span class="wfWhat">{it.label}</span>
              <span class="wfForm">{it.form}</span>
              <span class="wfDate">{fmtWireDate(it.date)}</span>
              {it.url ? <a class="wfSrc" href={it.url} target="_blank" rel="noopener">filing →</a> : null}
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    {articles.length ? (
      <section class="writing">
        <div class="bandHead">
          <h2>Latest notes</h2>
          <a class="all" href="/notes">All notes →</a>
        </div>
        <ul class="cards">
          {articles.map((a) => (
            <li>
              <a class="cardTitle" href={`/notes/${a.id}`}>{a.data.title}</a>
              <p class="dek">{a.data.description}</p>
              <div class="cardMeta"><span class="sec">{a.data.section}</span> {fmtDate(a.data.date)}</div>
            </li>
          ))}
        </ul>
      </section>
    ) : null}
  </section>

  <noscript>
    <style>
      /* With no JavaScript the omni-search can't run; the full catalog at /catalog is a plain,
         server-rendered page — point the reader there instead of at a dead box. */
      #omniBox, #omniChips { display: none !important; }
    </style>
  </noscript>

  <style>
    /* ---------------------------------- search view ---------------------------------- */
    #searchView { margin-top: 8px; }

    .omni { max-width: 640px; margin: 44px auto 0; }
    @media (max-width: 640px) { .omni { margin-top: 28px; } }
    .omniField {
      display: flex; align-items: center; gap: 10px;
      border: 1.5px solid var(--rule-strong); border-radius: 10px;
      background: var(--surface); padding: 0 14px;
      box-shadow: 0 1px 2px var(--shadow); transition: border-color 0.12s, box-shadow 0.12s;
    }
    .omniField:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-tint); }
    .omniIcon { width: 19px; height: 19px; color: var(--faint); flex: 0 0 auto; }
    .omniField:focus-within .omniIcon { color: var(--accent); }
    #omni {
      flex: 1 1 auto; min-width: 0; border: 0; background: none; outline: none;
      font-family: var(--sans); font-size: 17px; color: var(--ink);
      padding: 15px 0; line-height: 1.2;
    }
    #omni::placeholder { color: var(--faint); }
    #omni::-webkit-search-cancel-button { -webkit-appearance: none; }
    .omniKbd {
      flex: 0 0 auto; font-family: var(--sans); font-size: 11px; font-weight: 600; color: var(--muted);
      border: 1px solid var(--rule-strong); border-radius: 4px; padding: 2px 7px; line-height: 1.3;
      background: var(--paper);
    }
    @media (max-width: 520px) { .omniKbd { display: none; } }

    /* results sit directly under the field, attached, like a reference desk handing you the cards */
    .omniPanel { margin-top: 8px; border: 1px solid var(--rule-strong); border-radius: 10px; background: var(--surface); overflow: hidden; box-shadow: 0 4px 16px var(--shadow); }

    /* The empty-and-focused state: a second door — browse the groupings instead of naming a company. */
    .omniDefault { padding: 5px; }
    .odConf { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 10px 11px; border-radius: 6px; color: var(--ink); }
    .odConf:hover { background: var(--accent-tint); text-decoration: none; }
    .odConf + .odConf { border-top: 1px solid var(--rule); border-top-left-radius: 0; border-top-right-radius: 0; }
    .odConfT { font-family: var(--serif); font-weight: 600; font-size: 15px; }
    .odConfN { font-family: var(--sans); font-size: 11.5px; letter-spacing: 0.02em; color: var(--accent); flex: 0 0 auto; }
    .omniCount { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); padding: 9px 14px; border-bottom: 1px solid var(--rule); font-variant-numeric: tabular-nums; }
    .omniResults { list-style: none; margin: 0; padding: 4px; max-height: min(60vh, 460px); overflow-y: auto; }
    /* The result rows are created in JavaScript, so they never carry Astro's scope attribute; scope
       the container and mark the dynamic descendants :global so their styles actually apply. */
    .omniResults :global(.res) { margin: 0; border-radius: 6px; }
    .omniResults :global(.resLink) { display: flex; align-items: baseline; gap: 10px; padding: 9px 11px; min-width: 0; color: var(--ink); }
    .omniResults :global(.resLink:hover) { text-decoration: none; }
    .omniResults :global(.res.is-active) { background: var(--accent-tint); }
    .omniResults :global(.res.is-active .resName) { color: var(--accent); }
    .omniResults :global(.resName) { font-size: 15px; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1 1 auto; min-width: 0; }
    .omniResults :global(.resTicker) { font-family: var(--sans); font-weight: 700; font-variant-numeric: tabular-nums; font-size: 11.5px; letter-spacing: 0.03em; color: var(--muted); flex: 0 0 auto; }
    .omniResults :global(.res.is-active .resTicker) { color: var(--accent); }
    .omniResults :global(.resPlace) { font-size: 10.5px; letter-spacing: 0.02em; color: var(--tag-ink); background: var(--tag-bg); border-radius: 3px; padding: 2px 7px; white-space: nowrap; flex: 0 0 auto; }
    .omniEmpty { font-family: var(--serif); font-style: italic; color: var(--muted); margin: 0; padding: 22px 14px; }

    .chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 12px 2px 0; justify-content: center; }
    .chipLbl { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); }
    .chip {
      font-family: var(--sans); font-size: 13px; color: var(--ink-soft);
      border: 1px solid var(--rule-strong); border-radius: 999px; padding: 5px 13px; cursor: pointer;
      background: var(--surface); transition: border-color 0.1s, color 0.1s;
    }
    .chip:hover { border-color: var(--accent); color: var(--accent); }

    /* ---- writing band ---- */
    .writing { margin: 46px 0 0; }
    .cards { list-style: none; padding: 0; margin: 14px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .cards li { border-left: 2px solid var(--rule); padding: 2px 0 2px 14px; }
    .cardTitle { font-family: var(--serif); font-weight: 600; font-size: 17px; line-height: 1.25; display: block; color: var(--ink); }
    .cardTitle:hover { color: var(--accent); }
    .dek { font-size: 13.5px; color: var(--ink-dim); margin: 6px 0 8px; line-height: 1.45; }
    .cardMeta { font-size: 11.5px; color: var(--muted); letter-spacing: 0.02em; }
    .cardMeta .sec { text-transform: uppercase; letter-spacing: 0.06em; border: 1px solid var(--rule); padding: 1px 5px; margin-right: 6px; font-size: 10px; }

    /* ---- fresh-from-the-wire band ---- */
    .wire { margin: 46px 0 0; }
    .wireLede { font-family: var(--serif); font-style: italic; font-size: 14px; color: var(--ink-dim); margin: 10px 0 0; max-width: 70ch; line-height: 1.5; }
    .wireList { list-style: none; padding: 0; margin: 12px 0 0; }
    .wf { display: flex; align-items: baseline; gap: 10px 12px; flex-wrap: wrap; padding: 9px 0 9px 12px; border-bottom: 1px solid var(--rule); border-left: 2px solid transparent; }
    .wf.earn { border-left-color: var(--accent); }
    .wfCo { display: inline-flex; align-items: baseline; gap: 9px; flex: 1 1 240px; min-width: 0; }
    .wfCo:hover { text-decoration: none; }
    .wfTkr { font-family: var(--sans); font-weight: 700; font-variant-numeric: tabular-nums; font-size: 11.5px; letter-spacing: 0.03em; color: var(--accent); flex: 0 0 auto; }
    .wfName { font-size: 14px; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .wfCo:hover .wfName { color: var(--accent); }
    .wfWhat { font-size: 13px; color: var(--ink-soft); flex: 0 1 auto; }
    .wfForm { font-size: 10px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--rule); padding: 1px 6px; flex: 0 0 auto; }
    .wfDate { font-size: 11.5px; font-variant-numeric: tabular-nums; letter-spacing: 0.02em; color: var(--muted); flex: 0 0 auto; }
    .wfSrc { font-size: 11.5px; color: var(--accent); flex: 0 0 auto; }
    /* The grave ones announce themselves — a restatement, default, auditor change or impairment reads
       in red, the same alarm the full wire uses. Placed after .earn so it wins the left-border colour. */
    .wf.grave { border-left-color: var(--bad); }
    .wf.grave .wfTkr, .wf.grave .wfWhat { color: var(--bad); }

    /* Shared band header (the wire + notes bands). */
    .bandHead { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--rule-strong); padding-bottom: 6px; }
    .bandHead h2 { margin: 0; }
    .all { font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; flex: 0 0 auto; }

    @media (max-width: 640px) {
      .cards { grid-template-columns: 1fr; gap: 14px; }
      .cards li { border-left: 0; border-top: 1px solid var(--rule); padding: 10px 0 0; }
      .wfCo { flex-basis: 100%; }
    }
  </style>

  <script is:inline>
    /* The catalog lives at /catalog now. Old deep links (/#catalog, /#japan, /#adrs) still work:
       they land here and are forwarded to the catalog page, pool preserved. */
    (function () {
      const h = location.hash;
      if (h === "#catalog") location.replace("/catalog");
      else if (h === "#japan" || h === "#adrs") location.replace("/catalog" + h);
    })();
  </script>

  <script is:inline>
    /* The unified search. Its index is /company-index.json (every pool, one compact cached file),
       fetched once during idle or on the first keystroke — the page itself carries no catalog rows.
       Ranking favors an exact ticker, then a ticker or name that starts with what you typed,
       then a word inside the name, then anything containing it. Keyboard: ↑/↓ to move, Enter to open,
       Esc to clear; "/" from anywhere jumps to the box. */
    (function () {
      const input = document.getElementById("omni");
      const panel = document.getElementById("omniPanel");
      const list = document.getElementById("omniResults");
      const countEl = document.getElementById("omniCount");
      const emptyEl = document.getElementById("omniEmpty");
      const chips = document.getElementById("omniChips");
      const def = document.getElementById("omniDefault");
      if (!input || !panel || !list) return;
      const MAX = 40;
      const sortKey = (s) => s.replace(/^the\s+/i, "").replace(/^[^a-z0-9]+/i, "").trim().toLowerCase();
      // Squeeze out spaces and punctuation so "jp morgan" finds JPMorgan and "coca cola" finds
      // Coca-Cola — a reader shouldn't have to guess a company's exact spacing or hyphens.
      const sq = (s) => s.replace(/[^a-z0-9]+/g, "");

      // The curated alias bridge (searchAliases.mjs), emitted once as a JSON blob by the site-wide
      // search (in the base layout, so it's on this page too). Maps a typed query to the tickers it
      // should surface and the score to give them — an exact key like a ticker prefix (1), a
      // progressive prefix just behind (1.5) — so "google", "facebook", "coke" reach the right name.
      // Read lazily: this is an inline script that runs during parsing, before the blob is emitted at
      // end-of-body, so we resolve it on first use (a keystroke, long after load), never at init.
      let ALIAS = null;
      function getAlias() {
        if (ALIAS) return ALIAS;
        const el = document.getElementById("searchAliases");
        if (!el) return {};
        try { ALIAS = JSON.parse(el.dataset.aliases); } catch (e) { ALIAS = {}; }
        return ALIAS || {};
      }
      function aliasTargets(tq) {
        const A = getAlias();
        const m = {};
        for (const key in A) {
          const score = tq === key ? 1 : (tq.length >= 3 && key.indexOf(tq) === 0 ? 1.5 : -1);
          if (score < 0) continue;
          for (const tk of A[key]) { const tl = tk.toLowerCase(); if (m[tl] === undefined || score < m[tl]) m[tl] = score; }
        }
        return m;
      }

      // The index comes from /company-index.json — the same compact file the site-wide overlay
      // uses — fetched once (usually warmed during idle, before the first keystroke) instead of
      // shipping every catalog row in this page's HTML. Row tuples: [ticker, name, poolCode,
      // prominence, place]; poolCode 0 = US, 1 = ADR, 2 = Japan, which is already the rank order
      // that puts a US listing ahead of a foreign duplicate of the same name.
      const INDEX = [];
      let indexLoad = null;
      function ensureIndex() {
        if (!indexLoad) {
          indexLoad = fetch("/company-index.json")
            .then((r) => (r.ok ? r.json() : { rows: [] }))
            .then((d) => {
              (d.rows || []).forEach((row) => {
                const ticker = String(row[0] || "");
                const name = String(row[1] || "") || ticker;
                const poolCode = row[2] | 0;
                const place = String(row[4] || "");
                if (!ticker) return;
                const nl = name.toLowerCase();
                const hay = nl + " " + ticker.toLowerCase() + " " + place.toLowerCase();
                INDEX.push({
                  name, ticker, place,
                  href: (poolCode === 2 ? "/jp/" : poolCode === 3 ? "/eu/" : "/c/") + ticker,
                  pool: poolCode,
                  prom: row[3] | 0,
                  tl: ticker.toLowerCase(),
                  words: nl.split(/[^a-z0-9]+/).filter(Boolean),
                  nlsq: sq(nl), nksq: sq(sortKey(name)), haysq: sq(hay),
                });
              });
            })
            .catch(() => {});
        }
        return indexLoad;
      }
      // Warm the index during idle so the first keystroke answers instantly.
      (window.requestIdleCallback || function (f) { setTimeout(f, 1200); })(ensureIndex);

      let shown = [];   // current rendered matches
      let active = -1;  // highlighted index into `shown`

      function rank(term) {
        const t = term.trim().toLowerCase();
        const tq = sq(t);
        if (!tq) return [];
        const al = aliasTargets(tq);
        const out = [];
        for (let i = 0; i < INDEX.length; i++) {
          const it = INDEX[i];
          let s = -1;
          if (it.tl === tq) s = 0;                                          // exact ticker
          else if (it.tl.indexOf(tq) === 0) s = 1;                          // ticker prefix
          else if (it.nlsq.indexOf(tq) === 0 || it.nksq.indexOf(tq) === 0) s = 2; // name prefix
          else if (it.words.some((w) => w.indexOf(t) === 0)) s = 3;         // a word in the name starts with it
          else if (it.nlsq.indexOf(tq) >= 0) s = 4;                         // name contains
          else if (it.haysq.indexOf(tq) >= 0) s = 5;                        // ticker or place contains
          // A curated alias surfaces the household name where the legal name wouldn't match; never
          // demotes a stronger literal match (an exact ticker like COKE still leads its own query).
          const a = al[it.tl];
          if (a !== undefined && (s < 0 || a < s)) s = a;
          if (s >= 0) out.push({ it, s });
        }
        // Best match first: closeness of match, then a US listing over a foreign duplicate, then the
        // bigger company, then the shorter (more canonical) name, then alphabetical.
        out.sort((a, b) =>
          a.s - b.s ||
          a.it.pool - b.it.pool ||
          b.it.prom - a.it.prom ||
          a.it.name.length - b.it.name.length ||
          a.it.nlsq.localeCompare(b.it.nlsq));
        return out;
      }

      function setActive(i) {
        const items = list.children;
        if (active >= 0 && items[active]) { items[active].classList.remove("is-active"); items[active].setAttribute("aria-selected", "false"); }
        active = i;
        if (active >= 0 && items[active]) {
          items[active].classList.add("is-active");
          items[active].setAttribute("aria-selected", "true");
          input.setAttribute("aria-activedescendant", items[active].id);
          items[active].scrollIntoView({ block: "nearest" });
        } else {
          input.removeAttribute("aria-activedescendant");
        }
      }

      // The empty-and-focused state: the groupings door, a second door beside naming a company.
      function showDefault() {
        if (!def) return;
        list.textContent = ""; shown = []; active = -1;
        input.removeAttribute("aria-activedescendant");
        countEl.hidden = true;
        emptyEl.hidden = true;
        def.hidden = false;
        panel.hidden = false;
        if (chips) chips.hidden = false;
        input.setAttribute("aria-expanded", "true");
      }

      function render(term) {
        if (def) def.hidden = true;
        const matches = rank(term);
        shown = matches.slice(0, MAX).map((m) => m.it);
        list.textContent = "";
        active = -1;
        input.removeAttribute("aria-activedescendant");

        if (!matches.length) {
          panel.hidden = false;
          countEl.hidden = true;
          emptyEl.hidden = false;
          input.setAttribute("aria-expanded", "true");
          return;
        }
        emptyEl.hidden = true;
        countEl.hidden = false;
        countEl.textContent = matches.length > MAX
          ? ("Showing " + MAX + " of " + matches.length.toLocaleString() + "; keep typing to narrow")
          : (matches.length + (matches.length === 1 ? " match" : " matches"));

        shown.forEach((it, i) => {
          const li = document.createElement("li");
          li.className = "res";
          li.id = "res-" + i;
          li.setAttribute("role", "option");
          li.setAttribute("aria-selected", "false");
          const a = document.createElement("a");
          a.className = "resLink";
          a.href = it.href;
          a.tabIndex = -1;
          const n = document.createElement("span"); n.className = "resName"; n.textContent = it.name || it.ticker;
          const t = document.createElement("span"); t.className = "resTicker"; t.textContent = it.ticker;
          a.appendChild(n); a.appendChild(t);
          if (it.place) { const p = document.createElement("span"); p.className = "resPlace"; p.textContent = it.place; a.appendChild(p); }
          li.appendChild(a);
          li.addEventListener("mouseenter", () => setActive(i));
          list.appendChild(li);
        });
        panel.hidden = false;
        input.setAttribute("aria-expanded", "true");
      }

      function collapse() {
        panel.hidden = true;
        if (def) def.hidden = true;
        list.textContent = "";
        shown = []; active = -1;
        input.setAttribute("aria-expanded", "false");
        input.removeAttribute("aria-activedescendant");
        if (chips) chips.hidden = false;
      }

      function onInput() {
        const term = (input.value || "").trim().toLowerCase();
        if (!term) { showDefault(); return; }
        if (chips) chips.hidden = true;
        // The index is fetched lazily; re-read the live value at render time so a keystroke that
        // raced the first load still renders what the reader actually typed.
        ensureIndex().then(() => {
          const now = (input.value || "").trim().toLowerCase();
          if (now) render(now);
        });
      }

      // Focus the empty box and the groupings door drops down; click away and it folds back (search
      // results keep their own persist-until-cleared behavior, so this only governs the default state).
      input.addEventListener("focus", () => { if (!(input.value || "").trim()) showDefault(); });
      input.addEventListener("blur", () => {
        if (!def || def.hidden) return;
        setTimeout(() => { if (document.activeElement !== input) collapse(); }, 150);
      });

      function go(it) { if (it && it.href) window.location.href = it.href; }

      input.addEventListener("input", onInput);
      input.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown") { e.preventDefault(); if (shown.length) setActive(Math.min((active < 0 ? -1 : active) + 1, shown.length - 1)); }
        else if (e.key === "ArrowUp") { e.preventDefault(); if (shown.length) setActive(Math.max(active - 1, 0)); }
        else if (e.key === "Enter") { if (shown.length) { e.preventDefault(); go(shown[active >= 0 ? active : 0]); } }
        else if (e.key === "Escape") { if (input.value) { input.value = ""; collapse(); } else input.blur(); }
      });
      // Clicking a result navigates (the anchor handles middle-click / open-in-new-tab on its own).
      list.addEventListener("click", (e) => { if (e.target.closest("a")) return; const li = e.target.closest(".res"); if (li) { const i = Array.prototype.indexOf.call(list.children, li); go(shown[i]); } });

      if (chips) chips.addEventListener("click", (e) => {
        const b = e.target.closest(".chip");
        if (!b) return;
        input.value = b.dataset.q || b.textContent;
        input.focus();
        onInput();
      });

      // "/" focuses the omni box (the catalog page has its own handler for its own boxes).
      document.addEventListener("keydown", (e) => {
        if (e.key !== "/" ) return;
        const tag = ((document.activeElement || {}).tagName || "").toLowerCase();
        if (tag === "input" || tag === "textarea" || tag === "select") return;
        e.preventDefault();
        input.focus();
      });

      // Land and type: on a desktop, focus the box (without scrolling). Skipped on touch, where
      // it would pop the keyboard over the page.
      try {
        if (window.matchMedia && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
          input.focus({ preventScroll: true });
        }
      } catch (e) {}
    })();
  </script>
</BaseLayout>
