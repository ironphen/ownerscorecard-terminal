---
// The flag registers — the hub. Five named ways to die, one page per way: each register is a list
// of a single kind of disqualifying fact, drawn from the same guarded reads the company page runs,
// over the same universe the archetypes read. No score is formed across registers and no total is
// counted anywhere; a register is one fact, its members, and the figure that fired for each, and
// the reader draws the conclusion.
import BaseLayout from "../../layouts/BaseLayout.astro";
import fundamentals from "../../data/fundamentals.json";
import adr from "../../data/fundamentals.adr.json";
import language from "../../data/language.json";
import { REGISTERS, computeRegisters } from "../../lib/flags.mjs";
import { dataAsOf, fmtAsOf } from "../../lib/freshness.mjs";

const companies = [...(fundamentals.companies || []), ...(adr.companies || [])];
const bySlug = computeRegisters(companies, language.companies);
const refreshed = fmtAsOf(dataAsOf);
---

<BaseLayout title="Flags, Owner Scorecard">
  <header class="hero">
    <h1>The flag registers</h1>
    <p class="lede">
      Five named ways to die. Each register lists the companies where one specific disqualifying
      fact fired, with the figure that fired it.
    </p>
    <p class="sub">
      These are the cheap checks that end most inquiries in seconds. A register is a list of a
      single kind of fact, ordered by that fact's own size; no score is formed across registers,
      and nothing here is a verdict on a business — the figure is stated and the reader draws the
      conclusion, on the company page if the inquiry survives.
    </p>
    {refreshed ? <p class="dateline">From the latest filings · data as of {refreshed}.</p> : null}
  </header>

  <ul class="registers">
    {REGISTERS.map((r) => (
      <li class="reg">
        <a href={`/flags/${r.slug}`}>
          <div class="rTop">
            <span class="rTitle">{r.title}</span>
            <span class="rN">{(bySlug[r.slug]?.length || 0).toLocaleString()} companies</span>
          </div>
          <p class="rDesc">{r.describe}</p>
        </a>
      </li>
    ))}
  </ul>

  <p class="foot">
    Every figure comes from the company's SEC filings and its MD&amp;A, computed the same way as on
    its page, so a register and the page it links to can never disagree.
  </p>

  <style>
    .hero h1 { margin: 0 0 8px; color: var(--warn, #b4690e); }
    .lede { font-family: var(--serif); font-size: 18px; line-height: 1.55; color: var(--ink-soft); margin: 0 0 10px; max-width: 68ch; }
    .sub { color: var(--ink-dim); margin: 0; max-width: 68ch; line-height: 1.6; font-size: 14.5px; }
    .dateline { font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--muted); margin: 10px 0 0; }

    .registers { list-style: none; padding: 0; margin: 22px 0 0; }
    .reg { border-bottom: 1px solid var(--rule); }
    .reg a { display: block; padding: 15px 0; text-decoration: none; }
    .rTop { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .rTitle { font-family: var(--serif); font-weight: 600; font-size: 17px; color: var(--warn, #b4690e); }
    .reg a:hover .rTitle { filter: brightness(1.15); }
    .rN { font-family: var(--sans); font-variant-numeric: tabular-nums; font-size: 13px; color: var(--muted); flex: 0 0 auto; }
    .rDesc { margin: 5px 0 0; color: var(--ink-dim); font-size: 13.5px; line-height: 1.55; max-width: 76ch; }

    .foot { font-family: var(--serif); font-style: italic; font-size: 13px; color: var(--muted); border-top: 1px solid var(--rule-strong); margin-top: 28px; padding-top: 12px; max-width: 78ch; line-height: 1.6; }
  </style>
</BaseLayout>
