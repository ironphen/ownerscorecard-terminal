---
import { fmtMoney, roicValue, operatingMargin, ownerEarningsMargin, freeCashFlowMargin, topLineRevenue, debtReliable, grossMargin, gmCorrupt } from "../lib/fundamentals.mjs";
import { returnOnEquity, returnOnTangibleEquity, efficiencyRatio, equityToAssets, returnOnAssets } from "../lib/financials.mjs";
import { ffoMargin, ffoPayout, debtToAssets } from "../lib/reits.mjs";
import { combinedRatio, lossRatio } from "../lib/insurers.mjs";
import { netMargin, feeReturnOnEquity } from "../lib/feeFinancials.mjs";
import { medicalLossRatio } from "../lib/managedCare.mjs";
import { floatYield } from "../lib/peers.mjs";
import { financialKind, financialSubtype, classify } from "../lib/archetype.mjs";
import { isSteadyRhythm, rollToBusinessDay, nextBusinessDays, monthPhrase } from "../lib/filingRhythm.mjs";
import upcoming from "../data/upcoming.json";
import Term from "./Term.astro";

const { company } = Astro.props;
const $ = (v) => fmtMoney(v, company?.currency || "USD");
// Trust the captured debt (for ROIC) only when interest does not prove it under-captured.
const debtOk = debtReliable(company.lines || {}) && debtReliable(company.ttm?.lines || {});
const fk = financialKind(company);
// Life insurers sit inside the insurer kind but are read on the spread and book value,
// not the combined ratio, so they get their own vital signs.
const isLife = fk === "insurer" && financialSubtype(company) === "life-insurer";
const isReit = fk === "reit", isBank = fk === "bank", isInsurer = fk === "insurer" && !isLife;
const isFee = fk === "fee", isManagedCare = fk === "managedCare";
// Net investment yield: what the float earns, the life insurer's engine — through the SAME
// plausibility cap the Peers table uses (floatYield), so the two surfaces cannot diverge. A
// life insurer's real float lives in policy reserves the pipeline doesn't tag; the P&C
// lossReserves tag is a sliver, so the raw ratio prints impossibles (MET 130%, RGA 205%) —
// withheld above 15% (2026-07-17 correctness sweep #2).
const investmentYield = (l) => floatYield(l || {});
const L = company.lines || {};
const rev = topLineRevenue(L, company);
const hist = company.history || [];

const revSeries = hist.map((h) => topLineRevenue(h.lines, company)).filter((v) => v != null);
const prevRev = revSeries.length >= 2 ? revSeries[revSeries.length - 2] : null;
const revGrowth = prevRev ? (rev - prevRev) / prevRev : null;
// The CAGR adapts its span down to the record (a 4-year history yields a 3-year CAGR), so the
// label must carry the computed span — a hardcoded "5-yr" would mislabel every shorter record,
// contradicted by the "4-yr average" beside it. Same interpolation avgLabel does below.
let cagr = null, cagrSpan = null;
if (revSeries.length >= 4) {
  const span = Math.min(5, revSeries.length - 1);
  const first = revSeries[revSeries.length - 1 - span];
  if (first > 0) {
    cagr = Math.pow(rev / first, 1 / span) - 1;
    cagrSpan = span;
  }
}

// One vital-signs strip, the universal "is it a good business?" numbers, latest
// year. (No second strip: the business-model specifics live in the record table
// and in what the filing flags below, so they aren't duplicated up here.)
// Vital signs from the freshest twelve months (TTM), each with its 5-year average
// for context, is the business running above or below its own recent norm?
const cur = company.ttm?.lines || L;
const curLabel = company.ttm?.lines ? "TTM" : `FY${company.fy}`;
// A goods business — a manufacturer, retailer or branded-goods maker — cannot have a ~100% gross
// margin; that means the cost-of-revenue line was misclassified or partly missed (Caterpillar's $49M
// COGS against $68B of revenue). A genuine ~100%-gross model is asset-light, not goods (a platform, an
// exchange), and reports no cost line at all. So on a goods business, treat a near-total gross margin
// as the capture error it is and withhold it rather than print an impossible figure.
const goodsSector = (() => { try { return ["capital", "consumer", "retail"].includes(classify(company).sector.key); } catch { return false; } })();
// Withhold an impossible gross margin two ways: a near-total reading on a goods business (the cost line
// missed), and a near-total reading on any business whose record swings between moderate and ~100% years
// (the cost line captured near zero in those years) — matching the record table, so the strip and the
// table never disagree.
const grossM = (l) => { const v = grossMargin(l); if (v == null) return null; if (v > 0.95 && goodsSector) return null; if (gmCorrupt(v, company)) return null; return v; };
const hist5 = hist.slice(-5).map((h) => h.lines);
const avgLabel = hist5.length >= 5 ? "5-yr average" : hist5.length >= 2 ? `${hist5.length}-yr average` : null;
const avgShort = avgLabel ? avgLabel.replace("average", "avg") : "";
const avgOf = (fn) => { const xs = hist5.map(fn).filter((v) => v != null); return xs.length ? xs.reduce((a, b) => a + b, 0) / xs.length : null; };
// A pre-commercial company that loses more than it sells has margins that are noise — a −2,000%
// "operating margin" teaches nothing. When the filing's own situation says so (the unprofitable-growth
// overlay) and revenue is still de minimis, read it the way that overlay prescribes: on cash — the size
// of the war chest, the rate it burns, and the runway that leaves. A large company whose loss is a
// one-off writedown rather than a true cash burn is held out by the revenue ceiling.
const omCur = operatingMargin(cur);
const isBurnStage = (classify(company).overlays || []).some((o) => o.key === "unprofitable") && omCur != null && omCur < -1 && (rev == null || rev < 3e9);
const liquidity = (cur.cashAndEquivalents || 0) + (cur.shortTermInvestments || 0) + (cur.longTermMarketable || 0);
const burnRate = cur.cashFromOps != null && cur.cashFromOps < 0 ? -cur.cashFromOps : null;
const runwayYrs = burnRate && liquidity > 0 ? liquidity / burnRate : null;
const fmtRunway = (y) => (y == null ? null : y >= 10 ? "10+ yrs" : y >= 1 ? `${y.toFixed(1)} yrs` : `${Math.round(y * 12)} mo`);
const burnVitals = [
  { label: "Cash & investments", display: liquidity > 0 ? $(liquidity) : null },
  { label: "Cash burn · annual", display: burnRate != null ? $(burnRate) : null },
  { label: "Runway", display: fmtRunway(runwayYrs) },
  { label: "Gross margin", concept: "gross-margin", value: ((g) => (g != null && g > -0.2 && g <= 1.001 ? g : null))(grossM(cur)), dp: 0 },
].filter((v) => v.display != null || v.value != null);

// Vital signs differ by archetype: a bank's "is it a good business" lives in return
// on equity and the efficiency of the operation, not in margins or ROIC.
const vitals = isBurnStage ? burnVitals : (isReit
  ? [
      { label: "FFO margin", concept: "ffo", value: ffoMargin(cur), avg: avgOf(ffoMargin), dp: 0 },
      { label: "Dividend payout (FFO)", concept: "ffo", value: ffoPayout(cur), avg: avgOf(ffoPayout), dp: 0 },
      { label: "Debt / assets", concept: "net-debt", value: debtToAssets(cur), avg: avgOf(debtToAssets), dp: 0 },
    ]
  : isLife
  ? [
      { label: "Return on equity", concept: "return-on-equity", value: returnOnEquity(cur), avg: avgOf(returnOnEquity), dp: 0 },
      { label: "Investment yield on float", concept: "insurance-float", value: investmentYield(cur), avg: avgOf(investmentYield), dp: 1 },
      { label: "Return on assets", concept: "return-on-assets", value: returnOnAssets(cur), avg: avgOf(returnOnAssets), dp: 1 },
    ]
  : isInsurer
  ? [
      { label: "Combined ratio", concept: "combined-ratio", value: combinedRatio(cur), avg: avgOf(combinedRatio), dp: 0 },
      { label: "Loss ratio", concept: "combined-ratio", value: lossRatio(cur), avg: avgOf(lossRatio), dp: 0 },
      { label: "Return on equity", concept: "return-on-equity", value: returnOnEquity(cur), avg: avgOf(returnOnEquity), dp: 0 },
    ]
  : isBank
  ? [
      { label: "Return on equity", concept: "return-on-equity", value: returnOnEquity(cur), avg: avgOf(returnOnEquity), dp: 0 },
      { label: "Return on tangible equity", concept: "rotce", value: returnOnTangibleEquity(cur), avg: avgOf(returnOnTangibleEquity), dp: 0 },
      { label: "Efficiency ratio", concept: "efficiency-ratio", value: efficiencyRatio(cur), avg: avgOf(efficiencyRatio), dp: 0 },
      { label: "Equity / assets", concept: "tangible-book", value: equityToAssets(cur), avg: avgOf(equityToAssets), dp: 1 },
    ]
  : isManagedCare
  ? [
      { label: "Medical loss ratio", concept: "medical-loss-ratio", value: medicalLossRatio(cur), avg: avgOf(medicalLossRatio), dp: 1 },
      { label: "Operating margin", concept: "operating-margin", value: operatingMargin(cur), avg: avgOf(operatingMargin), dp: 1 },
      { label: "Return on equity", concept: "return-on-equity", value: returnOnEquity(cur), avg: avgOf(returnOnEquity), dp: 0 },
    ]
  : isFee
  ? [
      { label: "Operating margin", concept: "operating-margin", value: operatingMargin(cur), avg: avgOf(operatingMargin), dp: 1 },
      { label: "Net margin", concept: null, value: netMargin(cur), avg: avgOf(netMargin), dp: 1 },
      { label: "Return on equity", concept: "return-on-equity", value: feeReturnOnEquity(cur), avg: avgOf(feeReturnOnEquity), dp: 0 },
    ]
  : [
      { label: "Gross margin", concept: "gross-margin", value: grossM(cur), avg: avgOf(grossM), dp: 0 },
      { label: "Operating margin", concept: "operating-margin", value: operatingMargin(cur), avg: avgOf(operatingMargin), dp: 1 },
      { label: "ROIC", concept: "roic", value: debtOk ? roicValue(cur) : null, avg: debtOk ? avgOf(roicValue) : null, dp: 0 },
      { label: "Owner-earnings margin", concept: "owner-earnings", value: ownerEarningsMargin(cur, company), avg: avgOf((l) => ownerEarningsMargin(l, company)), dp: 0 },
      { label: "Free cash flow margin", concept: "free-cash-flow", value: freeCashFlowMargin(cur), avg: avgOf(freeCashFlowMargin), dp: 0 },
    ]
).filter((v) => v.value != null);

const pct = (v, dp = 0) => (v == null ? "—" : `${v < 0 ? "−" : ""}${(Math.abs(v) * 100).toFixed(dp)}%`);

// Revenue joins the strip, from the same freshest-twelve-months the other vitals read, with
// the same five-year average beneath it as every other vital carries: how the current run rate
// stands against the business's own recent norm.
const curRev = topLineRevenue(cur, company) ?? rev;
const avgRev = avgOf((l) => topLineRevenue(l, company));
if (!isBurnStage && curRev != null)
  vitals.unshift({ label: "Revenue", display: $(curRev), avgDisplay: avgRev != null ? $(avgRev) : null });

// The latest single quarter, for the reader arriving from the wire: the just-reported quarter
// against the SAME quarter a year ago (the honest comparison for a seasonal business). Fiscal
// year-end entries in the series carry no standalone revenue (a 10-K reports the year, not a
// fourth quarter), so the latest usable quarter is the last entry with a revenue figure, and
// its yardstick is the usable entry nearest one year before it.
const qSeries = (company.quarterly?.series || []).filter((e) => e && e.end && e.revenue != null);
const latestQ = qSeries.length ? qSeries[qSeries.length - 1] : null;
const dayMs = 86400000;
const yearAgoQ = latestQ
  ? qSeries.find((e) => {
      const gap = (new Date(latestQ.end) - new Date(e.end)) / dayMs;
      return gap > 320 && gap < 410;
    }) || null
  : null;
const qm = (num, den) => (num != null && den ? num / den : null);
const qVitals = latestQ
  ? [
      {
        label: "Revenue",
        display: $(latestQ.revenue),
        sub: yearAgoQ ? { growth: (latestQ.revenue - yearAgoQ.revenue) / yearAgoQ.revenue } : null,
      },
      {
        label: "Operating margin",
        value: qm(latestQ.operatingIncome, latestQ.revenue),
        dp: 1,
        sub: ((a) => (a != null ? { ago: a, dp: 1 } : null))(yearAgoQ ? qm(yearAgoQ.operatingIncome, yearAgoQ.revenue) : null),
      },
      {
        label: "Net income",
        display: latestQ.netIncome != null ? $(latestQ.netIncome) : null,
        sub: ((a) => (a != null ? { agoMoney: a } : null))(yearAgoQ ? yearAgoQ.netIncome : null),
      },
      {
        label: "Net margin",
        value: qm(latestQ.netIncome, latestQ.revenue),
        dp: 1,
        sub: ((a) => (a != null ? { ago: a, dp: 1 } : null))(yearAgoQ ? qm(yearAgoQ.netIncome, yearAgoQ.revenue) : null),
      },
    ].filter((v) => v.display != null || v.value != null)
  : [];
const fmtQEnd = (iso) => {
  const [y, m, dd] = iso.slice(0, 10).split("-").map(Number);
  const M = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return `${M[m - 1]} ${dd}, ${y}`;
};
// The toggle earns its place only when there is a real quarter to show; burn-stage pages keep
// their cash-and-runway strip undisturbed.
const showQuarter = !isBurnStage && qVitals.length >= 2;
const ttmModeLabel = `${curLabel}${!isBurnStage && avgLabel ? `, with ${avgLabel}` : ""}`;
const qModeLabel = latestQ ? `quarter ended ${fmtQEnd(latestQ.end)}, with the year-ago quarter` : "";

function spark(values, w = 132, h = 28) {
  const vs = values.filter((v) => v != null);
  if (vs.length < 2) return null;
  const min = Math.min(...vs), max = Math.max(...vs), span = max - min || 1;
  const x = (i) => (w * i) / (values.length - 1);
  const y = (v) => h - 2 - (h - 4) * ((v - min) / span);
  const d = values.map((v, i) => (v == null ? "" : `${i ? "L" : "M"}${x(i).toFixed(1)},${y(v).toFixed(1)}`)).join("");
  return { d, w, h, lastX: x(values.length - 1), lastY: y(values[values.length - 1]) };
}
const sp = spark(revSeries);

// The next report, from the statutory clock and the company's own rhythm (the wire's coming-due
// doctrine, applied to one company): every printed field is a filed fact or the statute — the period
// the report covers at month precision, the N-day rule for the filer class, and how many days after
// period end it has historically filed. The computed expectation is never printed as a date; when the
// rhythm is steady (lib/filingRhythm.mjs) and the arithmetic lands within the next two filing days,
// the line says that much and no more. Suppressed once the report has already arrived in the record,
// and once the statutory deadline has passed unfiled — a wrong or accusatory "next" is worse than none.
const up = upcoming.companies?.[String(company.ticker || "").toUpperCase()] || null;
const todayISO = new Date().toISOString().slice(0, 10);
const nextReport = (() => {
  if (!up || !up.nextPeriodEnd || !up.expected) return null;
  if (todayISO > up.dueBy) return null;
  const filedEnds = [company.periodEnd, ...(company.quarterly?.series || []).map((e) => e?.end)].filter(Boolean);
  if (filedEnds.some((e) => e >= up.nextPeriodEnd)) return null;
  const what = up.nextForm === "10-K"
    ? `annual report (10-K) for the fiscal year ended ${monthPhrase(up.nextPeriodEnd)}`
    : `10-Q for the quarter ended ${monthPhrase(up.nextPeriodEnd)}`;
  const imminent = isSteadyRhythm(up.lagsSameForm) &&
    new Set(nextBusinessDays(rollToBusinessDay(todayISO), 2)).has(rollToBusinessDay(up.expected));
  return { what, statutoryDays: up.statutoryDays, typicalLagDays: up.typicalLagDays, imminent };
})();
---

<section class="portrait">
  <div class="topline">
    <div class="rev">
      <div class="lbl">Revenue · FY{company.fy}</div>
      <div class="big">{$(rev)}</div>
      <div class="growth">
        {revGrowth != null ? (
          <span class={revGrowth < 0 ? "neg" : "pos"}>{revGrowth >= 0 ? "+" : ""}{pct(revGrowth, 1)} YoY</span>
        ) : null}
        {cagr != null ? <span class="muted"> · {pct(cagr, 0)} {cagrSpan}-yr CAGR</span> : null}
      </div>
    </div>
    {sp ? (
      <svg class="spark" viewBox={`0 0 ${sp.w} ${sp.h}`} preserveAspectRatio="none" role="img" aria-label="Revenue trend">
        <path d={sp.d} />
        <circle cx={sp.lastX} cy={sp.lastY} r="2.4" />
      </svg>
    ) : null}
  </div>

  {vitals.length ? (
    <div class="vitals">
      <div class="vHead">
        <span class="vLbl">Vital signs · <span id="vMode" data-ttm={ttmModeLabel} data-q={qModeLabel}>{ttmModeLabel}</span></span>
        {showQuarter ? (
          <div class="vToggle" role="tablist" aria-label="Vital signs period">
            <button type="button" class="vT" id="vtTtm" role="tab" aria-selected="true">TTM</button>
            <button type="button" class="vT" id="vtQ" role="tab" aria-selected="false">Latest quarter</button>
          </div>
        ) : null}
      </div>
      <div class="vRow" id="vRowTtm">
        {vitals.map((v) => (
          <div class="v">
            <span class="vk">{v.concept ? <Term id={v.concept}>{v.label}</Term> : v.label}</span>
            <span class="vv">{v.display != null ? v.display : pct(v.value, v.dp)}</span>
            {v.avg != null && avgShort ? (
              <span class="va">{avgShort} {pct(v.avg, v.dp)}</span>
            ) : v.avgDisplay && avgShort ? (
              <span class="va">{avgShort} {v.avgDisplay}</span>
            ) : null}
          </div>
        ))}
      </div>
      {showQuarter ? (
        <div class="vRow" id="vRowQ" hidden>
          {qVitals.map((v) => (
            <div class="v">
              <span class="vk">{v.label}</span>
              <span class="vv">{v.display != null ? v.display : pct(v.value, v.dp)}</span>
              {v.sub && v.sub.growth != null ? (
                <span class={`va ${v.sub.growth < 0 ? "vaNeg" : "vaPos"}`}>{v.sub.growth >= 0 ? "+" : ""}{pct(v.sub.growth, 1)} vs yr-ago qtr</span>
              ) : v.sub && v.sub.ago != null ? (
                <span class="va">yr-ago {pct(v.sub.ago, v.sub.dp)}</span>
              ) : v.sub && v.sub.agoMoney != null ? (
                <span class="va">yr-ago {$(v.sub.agoMoney)}</span>
              ) : null}
            </div>
          ))}
        </div>
      ) : null}
    </div>
  ) : null}

  {showQuarter ? (
    <script is:inline>
      (function () {
        var bT = document.getElementById("vtTtm"), bQ = document.getElementById("vtQ");
        var rT = document.getElementById("vRowTtm"), rQ = document.getElementById("vRowQ");
        var mode = document.getElementById("vMode");
        if (!bT || !bQ || !rT || !rQ) return;
        function set(q) {
          rT.hidden = q; rQ.hidden = !q;
          bT.setAttribute("aria-selected", String(!q));
          bQ.setAttribute("aria-selected", String(q));
          if (mode) mode.textContent = q ? (mode.dataset.q || "") : (mode.dataset.ttm || "");
        }
        bT.addEventListener("click", function () { set(false); });
        bQ.addEventListener("click", function () { set(true); });
      })();
    </script>
  ) : null}

  {nextReport ? (
    <p class="nextReport">
      <span class="nrLbl">Next report</span>
      the {nextReport.what} · due within {nextReport.statutoryDays} days of period end · has filed
      ~{nextReport.typicalLagDays} days after{nextReport.imminent ? " · its own pace places it within the next two filing days" : ""}
      · <a href="/wire">the wire</a> records it on arrival
    </p>
  ) : null}

</section>

<style>
  .portrait { margin: 14px 0 18px; }
  .nextReport { margin: 10px 0 0; font-size: 12.5px; color: var(--muted); line-height: 1.5; font-variant-numeric: tabular-nums; }
  .nrLbl { font-size: 10.5px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); margin-right: 8px; }
  .nextReport a { color: inherit; text-decoration: underline; }
  .nextReport a:hover { color: var(--accent); }

  .topline { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .lbl { font-size: 11.5px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
  .big { font-size: clamp(30px, 6vw, 44px); font-weight: 700; line-height: 1.04; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .growth { margin-top: 2px; font-size: 14px; font-variant-numeric: tabular-nums; }
  .growth .pos { color: var(--good); font-weight: 600; }
  .growth .neg { color: var(--bad); font-weight: 600; }
  .growth .muted { color: var(--muted); }
  .spark { width: 160px; height: 36px; overflow: visible; }
  .spark path { fill: none; stroke: var(--ink); stroke-width: 1.4; vector-effect: non-scaling-stroke; }
  .spark circle { fill: var(--accent); }

  .vitals { margin: 16px 0 0; padding: 12px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .vHead { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .vLbl { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .vToggle { display: inline-flex; border: 1px solid var(--rule-strong); border-radius: 999px; padding: 2px; background: var(--surface); gap: 2px; }
  .vT {
    font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: 0.04em;
    color: var(--muted); background: none; border: 0; border-radius: 999px; padding: 3px 11px; cursor: pointer;
  }
  .vT:hover { color: var(--ink); }
  .vT[aria-selected="true"] { background: var(--solid); color: var(--solid-ink); }
  .vaPos { color: var(--good); }
  .vaNeg { color: var(--bad); }
  .vRow { display: flex; gap: 30px 40px; flex-wrap: wrap; margin-top: 8px; }
  .v { display: flex; flex-direction: column; }
  .vk { font-size: 12px; color: var(--muted); }
  .vv { font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.1; margin-top: 2px; }
  .va { font-size: 11.5px; color: var(--muted); font-variant-numeric: tabular-nums; margin-top: 2px; }
</style>
