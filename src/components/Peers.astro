---
import fundamentals from "../data/fundamentals.json";
import adrFundamentals from "../data/fundamentals.adr.json";
import { classify } from "../lib/archetype.mjs";
import { fmtMoney, topLineRevenue } from "../lib/fundamentals.mjs";
import { financialKind } from "../lib/archetype.mjs";
import { selectPeers, peerStat, REIT_SUBSECTOR_LABELS } from "../lib/peers.mjs";
import { peerColumnsFor, lensKeyFor } from "../lib/peerLenses.mjs";
import { shortRecord } from "../lib/fundamentals.mjs";
import { secondaryListingsCached, primaryTickerFor } from "../lib/listings.mjs";

// One array, built once per module load rather than once per page, so the memoized listing set in
// listings.mjs has a stable identity to key its WeakMap on across all 3,623 company pages.
const LISTING_POOL = [...(fundamentals.companies || []), ...(adrFundamentals.companies || [])];
import { industryLabelOf, industrySlug } from "../lib/shelves.mjs";
import { usdTerms, revenueSortUsd } from "../lib/groupingColumns.mjs";
import adrRatios from "../data/adrRatios.json";
import rates from "../data/rates.json";
import Term from "./Term.astro";

// The peer set is computed once on the page and passed in, so the universe scan runs a single time per
// page; selectPeers here is the fallback when the component is used on its own.
const { company, peers: peersProp, basis: basisProp, subsector: subsectorProp, shelfNoun: shelfNounProp, sector: sectorProp } = Astro.props;
const all = fundamentals.companies || [];
// The listing check spans BOTH pools that reach a /c/ page, because four of the Brookfield Property
// preferred series are ADR filings: a set built from the US pool alone would miss them and hand each
// one a bench. Frozen at module scope so the memo in listings.mjs has a stable array to key on.
const listingPool = LISTING_POOL;

// Peers are drawn taxonomy-first (the same industry label the heading and the /groupings tables use) and
// ranked by structural likeness — selectPeers lives in lib/peers.mjs so the rule is one place and
// testable. The basis names the rung the bench was drawn from (industry label / shelf / sector /
// economic model) so the heading never claims a tighter group than the bench holds; the subsector, when
// a REIT, names the property bench.
const sel = peersProp ? { peers: peersProp, basis: basisProp, subsector: subsectorProp, shelfNoun: shelfNounProp, sector: sectorProp } : selectPeers(company, all);
const { peers, basis, subsector, shelfNoun, sector } = sel;
const cls = classify(company);

// A CLAIM ON A BUSINESS DOES NOT GET A COMPARATIVE TABLE (owner ruling, 2026-07-27). A preferred
// series, a baby bond, a warrant and a contingent value right arrive in the universe as separate
// tickers sharing one CIK with the common stock, and on 2026-07-27 they stopped COUNTING as
// businesses in the /groupings tables. The bench was untouched by that, so 227 of them still opened a
// full peer table among operating companies: six B. Riley preferred series each printed B. Riley's
// return on tangible equity, and AGNC's six preferreds each got a bench with AGNC itself excluded by
// the very CIK guard meant to stop a company benching against itself.
//
// The page stays, because a reader who types AGNCP should land somewhere truthful. What it stops
// doing is comparing: a bench exists to line businesses up against each other, and a claim on a
// business is not one of them. It points at the business instead.
const secondary = secondaryListingsCached(listingPool).has(String(company?.ticker || "").toUpperCase());
const parentTicker = secondary ? primaryTickerFor(listingPool, company.ticker) : null;
const parent = parentTicker ? listingPool.find((c) => String(c.ticker).toUpperCase() === parentTicker) : null;

// ONE COLUMN, ONE CURRENCY. Until 2026-07-27 the Revenue cell printed each row in the row's own
// currency — fmtMoney(revenue, c.currency) — under a bare "Revenue" header, so a foreign filer's
// own row sat in a column of US dollars with nothing marking the difference. Taiwan Semiconductor's
// bench opened "NT$2.89T" above Nvidia's "$215.9B" when TSMC's revenue is $89.5B: a reader draws the
// comparison the table invites and gets it exactly backwards. It affected 333 pages.
//
// The row ORDER was computed from the same unconverted figure, so 244 subjects sat in the wrong
// position and 60 were printed at the top of a bench they do not lead. The sort also read
// lines.revenue rather than topLineRevenue, so a bank or an insurer was ordered on a line its own
// page does not treat as its top line; 101 US benches re-order for that reason alone, which is a
// correction and not churn.
//
// Both now go through the same doctrine every other surface uses (groupingColumns.usdTerms): a US
// filer is already dollars, an ADR with known conversion terms converts at the dated reference rate,
// an ADR that files in dollars needs nothing, the Japanese pool converts at that same dated rate,
// and ANYTHING ELSE prints as filed and sorts to the back. A guessed conversion is a wrong number;
// an as-filed figure that says so is a missing one.
const termsOf = (c) => usdTerms(c, adrRatios, rates);
const group = [company, ...peers]
  .map((c) => ({ c, t: termsOf(c) }))
  .map((x) => ({ ...x, usd: revenueSortUsd(x.c, x.t) }))
  .sort((a, b) => (a.usd == null ? 1 : b.usd == null ? -1 : b.usd - a.usd));

// A percent unless the column says otherwise: inventory days is a count of days, and neither a share
// nor a sum, so it prints as the number it is.
const cell = (v, col) => (v == null ? "—" : col.type === "num" ? String(Math.round(v)) : `${(v * 100).toFixed(col.dp ?? 0)}%`);
const fk = financialKind(company);
const lensKey = lensKeyFor(company);

// THE COLUMNS COME FROM THE SHARED LENS DECLARATION (lib/peerLenses.mjs) since 2026-07-27, not from
// a hand-written list in this component. That list was the reason the owner could see a figure on an
// industry table that his own company page never showed him: six analyst desks shipped specialist
// columns onto /groupings and none of them reached here, because nothing connected the two. The
// declaration now carries each column's label, glossary concept, decimals, BASIS and how to read it,
// and a test fails the build if a new /groupings ratio column is neither present on the matching lens
// nor named with the measurement that refused it.
//
// Each column states its own basis in the header. The quality ratios are read through the cycle — the
// median over the readable record, so a peer caught at a peak or a trough doesn't distort the table —
// and the specialist intensities are read at the latest fiscal year because that is what their
// /groupings columns read, and one concept must give one figure. Revenue stays latest: it is the
// scale anchor for the row, not a rate to average.
const RAW_COLS = peerColumnsFor(company);

// The revenue cell, in the reader's dollars where the terms are known and as filed where they are
// not. Ratios are unitless and need no conversion, which is why only this one cell moves.
const revenueCell = ({ c, t }) => {
  const r = topLineRevenue(c.lines || {}, c);
  if (r == null || !Number.isFinite(r)) return "—";
  if (t.asFiled) return `as filed: ${fmtMoney(r, t.ccy)}`;
  return fmtMoney(r * t.factor, "USD");
};
// Each column reads itself. A cell is { value, years } or null; `years` is the count the median rests
// on, and null where the column is a latest-year figure and no count applies.
const readRow = (c) => {
  const out = {};
  for (const col of RAW_COLS) out[col.key] = col.read(c);
  return out;
};
const rows = group.map(({ c, t }) => ({ c, t, m: readRow(c), rev: revenueCell({ c, t }) }));
const val = (m, k) => (m[k] ? m[k].value : null);
// The mark fires when a median is too short to normalize (under three years) OR rests on under half
// the record it could have been read across — a figure read on three of ten years looks like a level
// and is not one.
const mark = (m, k) => (shortRecord(m[k]) ? m[k].years : null);
// No "best" mark per column. Crowning a winner on a single measure is a verdict — and the same one
// the compare view explicitly forbids ("no highlighted 'better' cell"). The group-median row below is
// the honest context device: it shows where each figure sits in the distribution without ranking.

// A column with NO reading anywhere in the group is a header over nothing — 149 of these were shipping
// across the site, 101 of them gross margin on benches where every member is a financial. It comes
// down. The rule is deliberately "zero readings", not "fewer than half": a fewer-than-half rule was
// measured too, and it removes 761 columns and destroys 1,331 real figures including 245 belonging to
// the subject company itself, then leaves two companies in the same industry looking at different
// columns on their own pages. A blank column teaches nothing; a sparse one still teaches whoever
// filled it in, and Salesforce should not lose its own 84.5% because its peers do not report it.
//
// The invYield case keeps its stricter half-the-group rule. It is not sparse data but a plausibility
// CAP: the pipeline's only float line is the P&C loss-reserve tag, which for a life insurer is a
// sliver of the real float, so the withheld cells are wrong-denominator readings rather than absent
// ones. A column that is mostly tripwire is not a column.
const answered = (key) => rows.filter((r) => val(r.m, key) != null).length;
const COLS = RAW_COLS.filter((col) =>
  col.key === "invYield" ? answered(col.key) >= Math.ceil(rows.length / 2) : answered(col.key) > 0
);

// The group's distribution per column — the median the company is read against, so a figure is context
// rather than a lone number. peerStat needs three readings (the company plus two peers); a thinner group
// simply shows no median line.
const subjectRow = rows.find((r) => r.c.ticker === company.ticker);
const dist = {};
for (const col of COLS) dist[col.key] = peerStat(rows.map((r) => val(r.m, col.key)), subjectRow ? val(subjectRow.m, col.key) : null);
const anyMed = COLS.some((col) => dist[col.key]);
// Whether the table needs to explain its year marks at all: most benches carry none.
const anyShort = rows.some((r) => COLS.some((col) => mark(r.m, col.key) != null));

// The words for the lens the bench is read on, one per declared lens — the software and semiconductor
// lenses are new (2026-07-27) and say what the desk's columns actually measure, so the sentence over
// the table is describing the columns under it rather than a generic "owner economics".
const LENS_WORDS = {
  reit: "the REIT lens",
  lifeInsurer: "the spread-and-book-value lens",
  insurer: "the underwriting lens",
  bank: "the bank lens",
  managedCare: "the medical-loss-ratio lens",
  fee: "fee margins",
  software: "owner economics and what the growth costs",
  semiconductor: "owner economics, research and the inventory cycle",
  operating: "owner economics",
};
const lens = LENS_WORDS[lensKey] || "owner economics";
// The heading names exactly the group the bench was drawn from: a REIT's property subsector
// ("Net-lease REITs"), the taxonomy's industry label (override-aware — the same label the /groupings
// tables seat the company under), the shelf or sector where the label ran thin, or the economic model
// as the honest last resort.
const myLabel = industryLabelOf(company);
const subLabel = subsector ? REIT_SUBSECTOR_LABELS[subsector] || myLabel : null;
const heading =
  basis === "model" ? "Peers, nearest by economic model"
  : basis === "sector" ? `Peers, ${sector || cls.sector.label} sector`
  : basis === "shelf" ? `Peers, ${shelfNoun || myLabel}`
  : `Peers, ${subLabel || myLabel}`;
// Only link the heading where the bench really is one industry. On a widened bench (a sector or an
// economic model) the heading names something no single table holds, and a link would promise a
// page that does not answer the words above it.
const tableSlug = ["model", "sector", "shelf"].includes(basis) || subsector ? null : industrySlug(myLabel);
const intro =
  basis === "model" ? `No close industry peers in the catalog yet, so these are the nearest by economic model (${cls.sector.label.toLowerCase()}), compared on ${lens}.`
  : basis === "sector" ? `Too few catalog companies share this one's industry, so the bench widens to its sector, side by side on ${lens}.`
  : basis === "shelf" ? `The neighboring industries on the same shelf, side by side on ${lens}.`
  : `The same industry, side by side on ${lens}.`;
---

{secondary ? (
  <section class="peers">
    <h3 class="secTitle pHead">Peers</h3>
    <p class="pNote">
      {company.name} is listed here as a claim on a business rather than as the business itself &mdash;
      a preferred series, a bond or a warrant, filed under the same registrant as the common stock.
      A comparative table lines businesses up against one another, so there is none here.
      {parent ? (
        <> The business behind it is <a href={`/c/${parentTicker}`}>{parent.name} ({parentTicker})</a>,
        where the record, the scorecard and the peer bench are.</>
      ) : null}
    </p>
  </section>
) : group.length >= 2 ? (
  <section class="peers">
    {/* The bench and the full comparative table are the same group read at two depths, and until
        now nothing on a company page said so: across 3,872 built pages, not one linked to its own
        grouping. A reader who wants the whole industry rather than the nearest six had no way
        down except the site search. The heading is that link where the group IS an industry. */}
    <h3 class="secTitle pHead">
      {tableSlug ? <>Peers, <a href={`/groupings/${tableSlug}`} class="pHeadLink">{heading.replace(/^Peers, /, "")}</a></> : heading}
    </h3>
    {/* The note used to open "Each figure is a through-cycle median", which was false twice over:
        Revenue is a single latest year, and 3,720 comparison cells across 1,127 pages were built on
        one or two years of record. Every column now states its OWN basis under its header, the way
        the grouping tables do, because the columns no longer share one: the quality ratios are read
        through the cycle and the desks' intensities at the latest year, matching their /groupings
        columns exactly so a concept can never give two figures again. */}
    <p class="pNote">{intro}{" "}Each column names the period it is read over{anyShort ? <>, and a
      median resting on fewer than three years carries that count beside it</> : null}; the <b>group
      median</b> at the foot is the line to read each figure against.</p>
    <div class="wrap">
      <table>
        <thead>
          <tr>
            <th class="tl">Company</th><th>Revenue<span class="bas">latest FY, USD</span></th>
            {COLS.map((col) => (
              <th>{col.concept ? <Term id={col.concept}>{col.label}</Term> : col.label}<span class="bas">{col.basis}</span></th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map(({ c, m, rev }) => (
            <tr class={c.ticker === company.ticker ? "me" : ""}>
              <th class="tl"><a href={`/c/${c.ticker}`}>{c.ticker}</a><span class="nm">{c.name}</span></th>
              <td>{rev}</td>
              {COLS.map((col) => {
                const v = val(m, col.key), y = mark(m, col.key);
                return (
                  <td>{cell(v, col)}{v != null && y != null ? (
                    <span class="shrt" title={`read on ${y} year${y === 1 ? "" : "s"} of the record`}>{y}y</span>
                  ) : null}</td>
                );
              })}
            </tr>
          ))}
        </tbody>
        {anyMed ? (
          <tfoot>
            <tr class="medRow">
              <th class="tl">Group median</th>
              <td>—</td>
              {COLS.map((col) => <td>{dist[col.key] ? cell(dist[col.key].median, col) : "—"}</td>)}
            </tr>
          </tfoot>
        ) : null}
      </table>
    </div>
  </section>
) : null}

<style>
  .peers { margin: 22px 0; }
  .pHead { border-bottom: 1px solid var(--rule-strong); padding-bottom: 6px; display: block; }
  .pNote { font-family: var(--serif); font-style: italic; font-size: 13px; color: var(--muted); margin: 9px 0 6px; }
  .wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 13px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  thead th { font-weight: 600; color: var(--muted); font-size: 12px; text-align: right; padding: 8px 10px 6px; border-bottom: 1px solid var(--rule); }
  thead th.tl, tbody th.tl { text-align: left; }
  tbody th.tl { font-weight: 600; padding: 9px 12px 9px 0; }
  tbody th.tl a { color: var(--accent); }
  .nm { color: var(--muted); font-weight: 400; font-size: 12px; margin-left: 8px; }
  td { text-align: right; padding: 9px 10px; border-bottom: 1px solid var(--rule); }
  tr.me th.tl a, tr.me td { font-weight: 700; }
  tr.me { background: var(--accent-tint); }

  /* The group-median row: the distribution line the company's figures are read against. Set off with a
     heavier rule and a muted, italic label so it reads as the yardstick, not another peer. */
  tfoot .medRow th.tl, tfoot .medRow td { border-top: 2px solid var(--rule-strong); padding-top: 9px; color: var(--ink-soft); font-weight: 600; }
  tfoot .medRow th.tl { font-style: italic; color: var(--muted); }
  .pNote b { font-style: normal; color: var(--ink); }

  /* The basis, under the Revenue header — the same thing the grouping tables' headers say, because a
     column of money that does not name its currency and period is not a fact. */
  .bas { display: block; font-weight: 400; font-size: 10px; letter-spacing: 0.02em; color: var(--muted); text-transform: none; margin-top: 2px; }

  /* The short-record mark. A figure built on one or two years is still the best reading the record
     supports and is printed; the count says so, quietly, so the figure is never mistaken for a
     normalized level. */
  .shrt { font-size: 10px; color: var(--muted); margin-left: 4px; vertical-align: 2px; }
</style>
