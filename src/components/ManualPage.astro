---
// One page of the Manual — docs/discovery-design.md feature 2. A fixed-format reading surface:
// every company on the page as an Entry Block, in strict alphabetical order by ticker, with
// prev/next page links and nothing else. No sort controls, no filters, no progress mechanics —
// the fixed format is what trains the eye, and a bookmark is a ribbon in a book. The one piece
// of client JS stores the reader's place (volume, ticker, entry number) in localStorage when a
// company is clicked; the Manual's index page renders that ribbon back as a single line.
import EntryBlock from "./EntryBlock.astro";

// vol: the volume object from manualOrder. letter: this page's letter (null for the single-page
// Japan volume). entries: the page's entries in order. prevPage/nextPage: neighbors in the
// Manual's page chain. total: entries in the whole Manual. rail: the volume's letter links
// (lettered volumes only).
const { vol, letter = null, entries = [], prevPage = null, nextPage = null, total, rail = [] } = Astro.props;

const first = entries[0];
const last = entries[entries.length - 1];
const VOL_NOTE = {
  us: null,
  adr: "Foreign filers on US exchanges. Figures as filed, in each company's home currency.",
  jp: "Read from each company's EDINET annual securities report. Figures as filed, in yen.",
}[vol.key];
---

<p class="back"><a href="/manual">← The Manual</a></p>

<header class="hero">
  <span class="kicker">{vol.ordinal} · {vol.label}</span>
  <h1>{letter || vol.label}</h1>
  {first ? (
    <p class="range">
      {entries.length.toLocaleString()} {entries.length === 1 ? "entry" : "entries"}, {first.ticker} to {last.ticker} ·
      entries {first.n.toLocaleString()}–{last.n.toLocaleString()} of {total.toLocaleString()}
    </p>
  ) : null}
  {VOL_NOTE ? <p class="volNote">{VOL_NOTE}</p> : null}
</header>

{rail.length ? (
  <nav class="lrail" aria-label="Letters in this volume">
    {rail.map((r) => (r.letter === letter ? <span class="cur">{r.letter}</span> : <a href={r.href}>{r.letter}</a>))}
  </nav>
) : null}

<nav class="pageNav" aria-label="Manual pages">
  {prevPage ? <a href={prevPage.href}>← {prevPage.label}</a> : <span />}
  {nextPage ? <a class="next" href={nextPage.href}>{nextPage.label} →</a> : null}
</nav>

<div id="mEntries" data-vol={vol.key}>
  {entries.map((e) => (
    <EntryBlock company={e.company} n={e.n} market={vol.key} />
  ))}
</div>

<nav class="pageNav bottom" aria-label="Manual pages">
  {prevPage ? <a href={prevPage.href}>← {prevPage.label}</a> : <span />}
  {nextPage ? <a class="next" href={nextPage.href}>{nextPage.label} →</a> : null}
</nav>

<p class="foot">
  The same four lines for every company, in strict ticker order; a figure that could not be read
  renders as "not read," never as a mark against the record beside it. The entries carry no
  ranking and form no score. What an entry cannot carry — understanding of the business, and a
  price — is yours.
</p>

<script is:inline>
  // The ribbon: clicking through to a company marks the place. A bookmark, nothing more — no
  // percent, no streaks, no completion state anywhere.
  (function () {
    var list = document.getElementById("mEntries");
    if (!list) return;
    list.addEventListener("click", function (e) {
      var a = e.target && e.target.closest ? e.target.closest("a[data-mn]") : null;
      if (!a) return;
      try {
        localStorage.setItem(
          "oscManualResume",
          JSON.stringify({ v: list.dataset.vol, t: a.dataset.mt, n: +a.dataset.mn })
        );
      } catch (err) {}
    });
  })();
</script>

<style>
  .back { margin: 0 0 10px; font-size: 13px; }
  .kicker { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); }
  .hero h1 { margin: 4px 0 0; }
  .range { font-family: var(--sans); font-size: 13px; color: var(--ink-dim); margin: 8px 0 0; font-variant-numeric: tabular-nums; }
  .volNote { font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--muted); margin: 8px 0 0; max-width: 72ch; }

  .lrail { display: flex; flex-wrap: wrap; gap: 1px 2px; margin: 14px 0 0; padding: 6px 0; border-bottom: 1px solid var(--rule); }
  .lrail a, .lrail .cur { font-family: var(--sans); font-size: 12px; font-weight: 600; letter-spacing: 0.02em; padding: 3px 7px; border-radius: 3px; min-width: 22px; text-align: center; }
  .lrail a { color: var(--accent); }
  .lrail a:hover { background: var(--accent-tint); text-decoration: none; }
  .lrail .cur { color: var(--ink); background: var(--accent-tint); }

  .pageNav { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin: 14px 0 0; padding-bottom: 8px; border-bottom: 1px solid var(--rule-strong); }
  .pageNav.bottom { margin-top: 22px; padding: 10px 0 0; border-bottom: 0; border-top: 1px solid var(--rule-strong); }
  .pageNav a { font-family: var(--sans); font-size: 12.5px; font-weight: 600; letter-spacing: 0.02em; }
  .pageNav .next { text-align: right; }

  .foot { font-family: var(--serif); font-style: italic; font-size: 13px; color: var(--muted); margin: 18px 0 0; line-height: 1.6; max-width: 78ch; }
</style>
