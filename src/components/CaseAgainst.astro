---
// The case against, first — docs/discovery-design.md, feature 14. Sits directly under the
// identity header on every company page: the reader must know what a thing is before evidence
// against it means anything; after that, the disconfirming evidence comes before the story does
// its seducing. This is a REORDERING of reads the page already holds, never a new computation:
// the fired flag registers, the flagged inversion checks, the Graham tests failed, and a candor
// low — one line per fired item, each with its figure, each anchoring to the fuller panel below.
// No verdict words; the strip states facts and where they are examined. When nothing fired it
// says so in one plain sentence — never a green badge, because the absence of a flag is not a
// virtue, only the cheap checks coming back empty. (The withheld-reads line joins in milestone 2,
// once the readability record exists.)
import { firedRegisters, REGISTER_BY_SLUG } from "../lib/flags.mjs";
import { inversionChecks } from "../lib/inversion.mjs";
import { grahamTests } from "../lib/graham.mjs";
import { financialKind } from "../lib/archetype.mjs";

// `lang` is this company's entry from language.json (the candor and integrity reads); pass null
// where the pool carries none (the Japanese pages). `isFin` mirrors the page's own gating of the
// Inversion section, so the strip can never cite a panel the page withholds.
const { company, lang = null, isFin = false } = Astro.props;

const items = [];

// 1. The named registers — the same firedRegisters() the /flags pages run, so "what fired here"
// and "who else did this" can never disagree. Each line links out to its register.
const fired = firedRegisters(company, lang);
for (const f of fired) {
  items.push({ label: REGISTER_BY_SLUG[f.slug].title, figure: f.figure, href: `/flags/${f.slug}` });
}

// 2. Flagged inversion checks, only where the page runs the Inversion panel: the operating reads
// are category errors on a financial, and the page withholds that section there.
const inv = !isFin ? inversionChecks(company) : null;
for (const c of (inv?.checks || []).filter((x) => x.flagged)) {
  items.push({ label: c.label, figure: c.value, href: "#sec-inversion" });
}

// 3. Graham's defensive tests, failed — stated as a count against the testable, never a score.
// Same gate as the Scorecard, where the panel lives: the US pool and the ADRs, non-financials.
// Only when the record carries enough testable criteria for the count to mean anything.
const g = company.market !== "JP" && !financialKind(company) ? grahamTests(company) : null;
const gFail = g ? g.testable - g.passes : 0;
if (g && g.testable >= 5 && gFail > 0) {
  items.push({
    label: "Graham's defensive tests",
    figure: `fails ${gFail} of ${g.testable} testable defensive criteria`,
    href: "#sec-scorecard",
  });
}

// 4. A candor low the registers did not carry: promotional or non-GAAP-steering language elevated
// on one measure but below the sells-hard register's two-figure threshold. Only when that register
// did NOT fire, so the same read is never stated twice.
const cd = lang?.mdna?.candor || null;
if (!fired.some((f) => f.slug === "sells-hard") && cd && ((cd.promo || 0) >= 0.8 || (cd.adjusted || 0) >= 4.8)) {
  const parts = [];
  if (cd.promo != null) parts.push(`promotional language at ${cd.promo.toFixed(1)}`);
  if (cd.adjusted != null) parts.push(`non-GAAP references at ${cd.adjusted.toFixed(1)}`);
  items.push({
    label: "The candor read",
    figure: `${parts.join(" and ")} per thousand words of MD&A`,
    href: "#sec-changes",
  });
}
---

<aside class={items.length ? "caseAgainst" : "caseAgainst clean"}>
  <h3 class="caTitle">The case against</h3>
  {items.length ? (
    <ul class="caList">
      {items.map((it) => (
        <li>
          <a class="caLabel" href={it.href}>{it.label}</a>
          <span class="caSep" aria-hidden="true">·</span>
          <span class="caFig">{it.figure}</span>
        </li>
      ))}
    </ul>
  ) : (
    <p class="caNone">No disqualifier fired on the cheap checks. The two tests that remain, understanding and price, are yours.</p>
  )}
</aside>

<style>
  /* A quiet strip: the muted warn border marks where the disconfirming lines live, and the words
     carry the meaning. When nothing fired the border goes neutral — a plain sentence, no praise. */
  .caseAgainst { margin: 16px 0 0; border-left: 3px solid var(--warn, #b4690e); background: var(--warn-tint, var(--accent-tint)); padding: 10px 14px 11px; max-width: 78ch; }
  .caseAgainst.clean { border-left-color: var(--rule-strong); background: transparent; padding: 10px 14px 11px; }
  .caTitle { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 0; }
  .caList { list-style: none; padding: 0; margin: 6px 0 0; }
  .caList li { padding: 4px 0; font-size: 13.5px; line-height: 1.55; }
  .caLabel { font-family: var(--sans); font-weight: 600; font-size: 12.5px; color: var(--ink); }
  .caLabel:hover { color: var(--accent); }
  .caSep { color: var(--muted); margin: 0 5px; }
  .caFig { font-family: var(--serif); color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .caNone { font-family: var(--serif); font-size: 13.5px; line-height: 1.55; color: var(--ink-soft); margin: 6px 0 0; }
</style>
