---
// "Cite this page": one line of citation text and a copy button, at the foot of scorecards and
// Notes. Citations by readers (forums, blogs, newsletters) are inbound links, and inbound links
// are what teach search and answer engines that this is the source. The affordance itself also
// signals the page expects to be cited. Canonical host always, never the serving host.
const { citation } = Astro.props;
---

<div class="cite">
  <span class="citeLabel">Cite:</span>
  <span class="citeText">{citation}</span>
  <button type="button" class="citeCopy" data-cite={citation} aria-label="Copy citation">Copy</button>
</div>

<style>
  .cite {
    display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
    margin-top: 28px; padding-top: 12px; border-top: 1px solid var(--rule);
    font-size: 12.5px; color: var(--muted);
  }
  .citeLabel { font-family: var(--sans); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; font-size: 10.5px; }
  .citeText { font-family: var(--serif); font-style: italic; }
  .citeCopy {
    font-family: var(--sans); font-size: 11px; font-weight: 600; cursor: pointer;
    background: none; border: 1px solid var(--rule-strong); color: var(--ink-dim);
    border-radius: 4px; padding: 2px 8px;
  }
  .citeCopy:hover { border-color: var(--accent); color: var(--accent); }
  @media print { .citeCopy { display: none; } }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll(".citeCopy").forEach(function (b) {
      b.addEventListener("click", function () {
        navigator.clipboard.writeText(b.getAttribute("data-cite") || "").then(function () {
          var t = b.textContent; b.textContent = "Copied";
          setTimeout(function () { b.textContent = t; }, 1600);
        }).catch(function () {});
      });
    });
  })();
</script>
