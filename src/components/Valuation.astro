  .cmpSpark { margin-top: 6px; opacity: 0.9; }

  .dials { margin: 16px 0 0; }
  .dialsLbl { font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .dials label { display: flex; align-items: center; gap: 10px; margin: 9px 0 0; font-size: 13.5px; color: var(--ink-dim); }
  .dials output { font-weight: 700; font-variant-numeric: tabular-nums; min-width: 44px; color: var(--ink); }
  .dials input[type="range"] { flex: 1 1 auto; max-width: 320px; accent-color: var(--accent); }
  .dialsNote { font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--muted); margin: 10px 0 0; line-height: 1.5; max-width: 70ch; }

  /* The operating picture behind a price: implied market cap and the multiples it is, the owner
     earnings it must reach, and — at a margin you set — the revenue that demands. */
  .ops { background: var(--surface-2); border-left: 2px solid var(--accent); padding: 12px 15px; margin: 14px 0 0; max-width: 80ch; }
  .ops[hidden] { display: none; }
  .opsMc, .impOps, .reqRev { font-family: var(--serif); font-size: 14px; line-height: 1.55; color: var(--ink-soft); margin: 0; }
  .impOps, .reqRev, .marginRow { margin-top: 9px; }
  .opsMc[hidden], .impOps[hidden], .reqRev[hidden], .marginRow[hidden] { display: none; }
  .ops b { font-weight: 600; color: var(--ink); }
  .ops b.hot { color: var(--accent); }
  .marginRow label { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--ink-dim); font-family: var(--sans); flex-wrap: wrap; }
  .marginRow output { font-weight: 700; font-variant-numeric: tabular-nums; min-width: 40px; color: var(--ink); }
  .marginRow input[type="range"] { flex: 1 1 200px; max-width: 280px; accent-color: var(--accent); }

  /* The multiples schedule: what a growth belief costs, in owner-earnings multiples, across
     discount rates. The delivered rate is one labeled row of a general table; no cell is ever
     highlighted as fair. */
  .sens { margin: 18px 0 0; }
  .sens[hidden] { display: none; }
  .sensLbl { font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .sensWrap { overflow-x: auto; margin: 10px 0 0; }
  .sensTbl { border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: 13px; }
  .sensTbl th, .sensTbl td { border: 1px solid var(--rule); padding: 5px 13px; text-align: right; white-space: nowrap; }
  .sensTbl thead th { color: var(--muted); font-weight: 600; font-size: 11px; letter-spacing: 0.03em; }
  .sensTbl tbody th { color: var(--muted); font-weight: 600; }
  .sensTbl td { color: var(--ink-dim); }
  .sensTbl tbody tr.deliv th { color: var(--ink); }
  /* The implied-growth ladder, price-gated: return rungs down, the growth each requires beside.
     The delivered rate is a labeled marker line among the rungs; the crossing is never highlighted. */
  .ladder { margin: 18px 0 0; }
  .ladder[hidden] { display: none; }
  .sensTbl tr.marker th, .sensTbl tr.marker td { color: var(--ink); font-style: italic; border-top: 2px solid var(--rule-strong); border-bottom: 2px solid var(--rule-strong); }
  .sensLoc { font-family: var(--serif); font-size: 13px; color: var(--ink-dim); margin: 9px 0 0; line-height: 1.5; max-width: 72ch; }
  .sensNote { font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--muted); margin: 9px 0 0; line-height: 1.5; max-width: 72ch; }

  .gatenote { font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--muted); margin: 8px 0 0; line-height: 1.5; max-width: 70ch; }

  /* The price memory's dated line, under the price row: the reader's own saved price named
     with its day — staleness stated, never worn as currency. Quiet, like .gatenote/.bondAsOf. */
  .pxMem { font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--muted); margin: 8px 0 0; line-height: 1.5; max-width: 70ch; }
  .pxMem[hidden] { display: none; }

  /* Graham's bond yardstick: the owner-earnings yield against the bond the reader could hold instead. */
  .bondBox { margin: 18px 0 0; padding: 13px 0 0; border-top: 1px solid var(--rule); }
  .bondHead { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .bondTitle { font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .bondField { display: inline-flex; align-items: baseline; gap: 6px; }
  .bondLbl { font-size: 11.5px; color: var(--muted); letter-spacing: 0.02em; }
  .bondField input { width: 66px; padding: 5px 8px; border: 1px solid var(--rule-strong); font-family: var(--sans); font-size: 14px; font-variant-numeric: tabular-nums; background: var(--surface); }
  .bondPct { font-size: 16px; font-weight: 700; color: var(--ink); }
  .bondAsOf { font-size: 11.5px; color: var(--muted); margin: 8px 0 0; line-height: 1.5; max-width: 78ch; }
  .bondLede { font-family: var(--serif); font-size: 13.5px; line-height: 1.55; color: var(--ink-soft); margin: 8px 0 0; max-width: 78ch; }
  .bondCmp { margin-top: 12px; }

  .foot { font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--muted); margin: 14px 0 0; line-height: 1.5; max-width: 70ch; }

  /* On a phone the price input wraps under its label rather than overflowing, and each dial's
     slider takes the full width below its label instead of being squeezed beside a long one. */
  @media (max-width: 520px) {
    .dials label { flex-wrap: wrap; }
    .dials input[type="range"] { flex-basis: 100%; max-width: none; }
  }
</style>

<script>
  import { pv, solve } from "../lib/reverseDcf.mjs";
  import { wirePriceMemory } from "../lib/priceMemory.mjs";
  (function () {
    const box = document.getElementById("valBox");
    if (!box) return;
    const OE = parseFloat(box.dataset.oe), SH_DATA = parseFloat(box.dataset.shares), NAME = box.dataset.name || "this company";
    const SYM = box.dataset.sym || "$";
    const OE3 = parseFloat(box.dataset.oe3), SBC = parseFloat(box.dataset.sbc) || 0;
    const OEM = parseFloat(box.dataset.oemaint), OEM3 = parseFloat(box.dataset.oemaint3);
    // Two delivered/window families, one per capex treatment; the Steady-state toggle picks the
    // one the base actually runs on, so every comparison on the page shares the base's own
    // definition. Net-of-stock-comp has no per-year series here, so with SBC on the comparisons
    // are WITHHELD rather than run gross-vs-net (a mixed comparison is a quiet wrong number).
    const GD_T = parseFloat(box.dataset.gdelivTotal), GD_M = parseFloat(box.dataset.gdelivMaint);
    let WINS_T = null, WINS_M = null;
    try { WINS_T = JSON.parse(box.dataset.oewinsTotal || "null"); } catch (e) {}
    try { WINS_M = JSON.parse(box.dataset.oewinsMaint || "null"); } catch (e) {}
    const famMaintOn = () => { const el = document.getElementById("oeMaint"); return !!(el && el.checked); };
    const sbcOn = () => { const el = document.getElementById("oeSbc"); return !!(el && el.checked && SBC > 0); };
    const famG = () => (sbcOn() ? NaN : famMaintOn() ? GD_M : GD_T);
    const famWins = () => (sbcOn() ? null : famMaintOn() ? WINS_M : WINS_T);
    const famRows = () => document.querySelectorAll(".famRow").forEach((el) => { el.hidden = (el.dataset.fam === "maint") !== famMaintOn(); });
    const px = document.getElementById("px");
    // When the filing's share count is missing (Up-C / multi-class filers), the reader supplies it
    // in millions; otherwise SH comes straight from the record. Market cap can't be formed without it.
    const shInput = document.getElementById("shInput");
    const curSH = () => { if (SH_DATA > 0) return SH_DATA; const v = shInput ? parseFloat(shInput.value) : NaN; return v > 0 ? v * 1e6 : NaN; };
    const r = document.getElementById("r"), n = document.getElementById("n"), g = document.getElementById("g");
    const rOut = document.getElementById("rOut"), nOut = document.getElementById("nOut"), gOut = document.getElementById("gOut");
    const lede = document.getElementById("lede"), impG = document.getElementById("impG"), oeY = document.getElementById("oeY");
    const pe = document.getElementById("pe"), pb = document.getElementById("pb"), ggate = document.getElementById("ggate");
    // Graham's bond yardstick: the reader's high-grade bond yield, the owner-earnings yield set against it.
    const bondY = document.getElementById("bondY"), bondLede = document.getElementById("bondLede"), bondCmp = document.getElementById("bondCmp");
    const eyB = document.getElementById("eyB"), bondYOut = document.getElementById("bondYOut"), spreadB = document.getElementById("spreadB");
    const oeNorm = document.getElementById("oeNorm"), oeSbc = document.getElementById("oeSbc"), oeMaint = document.getElementById("oeMaint");
    const cushionLine = document.getElementById("cushionLine");
    const EPS3 = parseFloat(box.dataset.eps3), BVPS = parseFloat(box.dataset.bvps);
    const REV = parseFloat(box.dataset.rev), GREV = parseFloat(box.dataset.grev), NI = parseFloat(box.dataset.ni);
    const sens = document.getElementById("sens"), sensTbl = document.getElementById("sensTbl"), sensNote = document.getElementById("sensNote"), sensLoc = document.getElementById("sensLoc");
    const ladder = document.getElementById("ladder"), ladderTbl = document.getElementById("ladderTbl"), ladderNote = document.getElementById("ladderNote");
    const baseRates = document.getElementById("baseRates");
    const baseUsed = document.getElementById("baseUsed");
    const ops = document.getElementById("ops"), opsMc = document.getElementById("opsMc"), impOps = document.getElementById("impOps");
    const marginRow = document.getElementById("marginRow"), mmDial = document.getElementById("mmDial"), mmOut = document.getElementById("mmOut"), reqRev = document.getElementById("reqRev");

    const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]));
    const pcs = (v) => (v < 0 ? "−" : "") + Math.abs(v * 100).toFixed(1) + "%";
    const usd = (v) => { const a = Math.abs(v); const s = a >= 1e12 ? SYM + (a / 1e12).toFixed(2) + "T" : a >= 1e9 ? SYM + (a / 1e9).toFixed(1) + "B" : a >= 1e6 ? SYM + Math.round(a / 1e6) + "M" : SYM + Math.round(a); return v < 0 ? "(" + s + ")" : s; };

    // The multiples schedule, the page's centerpiece: what a growth belief costs, in owner-earnings
    // multiples — growth beliefs down, discount rates across, the horizon and terminal rate following
    // the dials. The delivered rate appears as one labeled row of a general table, never as the
    // company's own number, and no cell is ever highlighted as fair; once a price is typed, the paid
    // multiple is located in prose, by the reader's own dials.
    // The balance-sheet toggle: Graham's arithmetic that a buyer gets the cash and assumes the
    // debt. ND = net debt as filed (negative = net cash); evAdj is what the toggle currently
    // adds to the equity outlay (0 when off or immaterial), read by every priced figure and by
    // the bond yardstick.
    const ND = parseFloat(box.dataset.netdebt);
    const BALOK = box.dataset.balanceok === "1";
    const evTog = document.getElementById("evTog"), evOn = document.getElementById("evOn"), evLbl = document.getElementById("evLbl"), evNote = document.getElementById("evNote");
    let evAdj = 0;
    if (evOn) evOn.addEventListener("change", update);

    const R_COLS = [0.06, 0.08, 0.1, 0.12];
    const gLbl = (g, dp) => (g < 0 ? "−" : "") + Math.abs(g * 100).toFixed(dp) + "%";
    let SCHED_ROWS = [];
    function schedRows() {
      let rows = [0, 0.05, 0.15, 0.2].map((g) => ({ g, lbl: gLbl(g, 0) + "/yr", pl: gLbl(g, 0) + "/yr", deliv: false }));
      const GD = famG();
      if (!isNaN(GD) && GD >= -0.05 && GD <= 0.30) {
        rows = rows.filter((r) => Math.abs(r.g - GD) >= 0.0025);
        rows.push({ g: GD, lbl: gLbl(GD, 1) + "/yr · delivered", pl: gLbl(GD, 1) + "/yr (delivered)", deliv: true });
      }
      return rows.sort((a, b) => a.g - b.g);
    }
    function renderSens(gT, N) {
      if (!sens || !sensTbl) return;
      SCHED_ROWS = schedRows();
      let html = "<thead><tr><th>growth · return</th>" + R_COLS.map((rr) => "<th>" + (rr * 100).toFixed(0) + "%</th>").join("") + "</tr></thead><tbody>";
      for (const row of SCHED_ROWS) {
        html += "<tr" + (row.deliv ? ' class="deliv"' : "") + "><th>" + row.lbl + "</th>";
        for (const rr of R_COLS) {
          const m = rr > gT ? pv(row.g, rr, N, gT) : null;
          html += "<td>" + (m != null ? m.toFixed(1) + "×" : "—") + "</td>";
        }
        html += "</tr>";
      }
      sensTbl.innerHTML = html + "</tbody>";
      sens.hidden = false;
      if (sensNote) sensNote.textContent = "Each cell is the owner-earnings multiple that growth belief justifies at that required return, held " + N + " years, then " + (gT * 100).toFixed(1) + "% forever; the horizon and terminal rate follow the dials above." + (SCHED_ROWS.some((r) => r.deliv) ? " The row marked delivered is the rate this record actually compounded at; the other rows are anyone's beliefs." : "");
    }

    // The base the whole tool runs on, made honest by the toggles: a 3-year average instead of
    // one noisy year; the steady-state base that subtracts maintenance capex (≈ depreciation)
    // instead of total capex, for a business mid-build-out; and/or net of the stock comp that
    // is a real cost to owners.
    function effOE() {
      const maint = oeMaint && oeMaint.checked && !isNaN(OEM);
      const norm = oeNorm && oeNorm.checked;
      let base = maint ? ((norm && OEM3 > 0) ? OEM3 : OEM) : ((norm && OE3 > 0) ? OE3 : OE);
      if (oeSbc && oeSbc.checked && SBC > 0) base -= SBC;
      return base;
    }

    function dials() {
      const rr = parseFloat(r.value) / 100, N = parseInt(n.value, 10), gT = parseFloat(g.value) / 100;
      rOut.textContent = r.value + "%"; nOut.textContent = N; gOut.textContent = parseFloat(g.value) + "%";
      // The live decomposition beside the dial: whatever the dial says, restated as the dated
      // bond plus an explicit premium — arithmetic in the open, so the resting 9% is never a
      // laundered house number and a reader-set rate always balances to the printed digit.
      const rd = document.getElementById("rDecomp");
      const BD = parseFloat(box.dataset.bonddefault);
      if (rd && !isNaN(BD)) {
        const prem = rr * 100 - BD;
        const bname = box.dataset.bondname || "long bond", basof = box.dataset.bondasof;
        rd.textContent = `${(rr * 100).toFixed(1)}% = the ${BD}% ${bname}${basof ? " (" + basof + ")" : ""} ${prem >= 0 ? "+ " + prem.toFixed(2) + " points of equity premium" : "− " + Math.abs(prem).toFixed(2) + " points below the bond"}. The rate you require is yours to set.`;
      }
      return { rr, N, gT };
    }
    function setURL(v) { try { const u = new URL(location.href); v ? u.searchParams.set("px", v) : u.searchParams.delete("px"); history.replaceState(null, "", u); } catch (e) {} }

    // Graham's central test, made live: the owner-earnings yield (the equity yield a price buys) set
    // against the high-grade bond yield the reader supplies — the bond you could hold instead. The
    // margin between them is the margin of safety Graham measured in yield terms; and the discount
    // rate reads as that bond plus the premium you demand, Buffett's "interest rates are gravity."
    function bondView() {
      if (!bondY || !bondCmp || !bondLede) return;
      const BOND = parseFloat(bondY.value) / 100;
      const price = parseFloat(px.value), SH = curSH(), base = effOE();
      const haveEY = price > 0 && base > 0 && SH > 0;
      const EY = haveEY ? base / (price * SH + evAdj) : null; // the toggle's outlay basis carries into the bond yardstick
      if (!(BOND > 0) || !haveEY) {
        bondCmp.hidden = true;
        const accEl0 = document.getElementById("accSpread");
        if (accEl0) accEl0.textContent = "";
        bondLede.textContent = !(BOND > 0)
          ? "Graham measured a stock against the bond you could own instead, the heart of his margin of safety. Enter today’s high-grade bond yield (the 10-year government bond, or a AAA corporate) to weigh the owner-earnings yield against it. Nothing is stored unless you enter it in your notebook."
          : "Enter a price above to set the owner-earnings yield, then this weighs it against the bond.";
        return;
      }
      const rr = parseFloat(r.value) / 100;
      bondCmp.hidden = false;
      eyB.textContent = pcs(EY);
      bondYOut.textContent = (BOND * 100).toFixed(2) + "%";
      const spread = EY - BOND;
      spreadB.textContent = (spread >= 0 ? "+" : "−") + Math.abs(spread * 100).toFixed(1) + " pts";
      spreadB.style.color = spread >= 0 ? "var(--good)" : "var(--bad)";
      // Graham's ch.20 accumulation: the yield spread, held ten years, as a share of the price
      // paid — his own worked arithmetic ran to roughly half the purchase price. Dated inputs,
      // no adjective; it takes the slot the redundant "Multiple paid" readout used to fill.
      const accEl = document.getElementById("accSpread");
      if (accEl) accEl.textContent = `Held ten years, that spread accumulates to about ${(spread >= 0 ? "" : "−") + Math.abs(spread * 1000).toFixed(0)}% of ${evAdj !== 0 ? "the outlay" : "the price paid"}, before any change in the business — Graham’s margin, expressed as arithmetic.`;
      const ratio = EY / BOND;
      let s;
      if (EY >= 2 * BOND) s = `The owner-earnings yield is about ${ratio.toFixed(1)}× the bond, comfortably above it: the wide cushion Graham looked for. You are paid far more to own the business than to hold the bond.`;
      else if (EY >= BOND) s = `The owner-earnings yield sits above the bond, but short of the roughly 2× cushion Graham’s defensive rule asked for. The margin over the bond is your pay for the equity’s risk; weigh whether it is enough.`;
      else s = `The owner-earnings yield is below the bond: today, the riskless bond pays more. The equity has to grow into that gap to earn its risk, which is exactly the growth the reverse-DCF above asks you to believe.`;
      const prem = rr - BOND;
      if (prem > 0.001) s += ` Your ${(rr * 100).toFixed(1)}% required return is this ${(BOND * 100).toFixed(2)}% bond plus a ${(prem * 100).toFixed(2)}-point premium for the risk.`;
      bondLede.textContent = s;
    }

    function update() {
      famRows();
      bondView();
      const { rr, N, gT } = dials();
      const base = effOE();
      const SH = curSH();

      // Name the figure the model is actually running on, and update it as the toggles change, so
      // "Normalize" / "Steady-state" / "Net of stock comp" are never a black box: you see the number.
      if (baseUsed) {
        const maint = oeMaint && oeMaint.checked && !isNaN(OEM);
        const norm = oeNorm && oeNorm.checked;
        const sbc = oeSbc && oeSbc.checked && SBC > 0;
        const kind = maint ? (norm ? "steady-state owner earnings, 3-year average" : "steady-state owner earnings (maintenance capex)") : (norm ? "through-cycle (normalized) owner earnings" : "latest-year owner earnings");
        // Material stock comp is named even with the toggle OFF: operating cash adds it back, so
        // the unchecked box is the flattering default, and the flattering default does not get
        // to be silent (Buffett, 1998: if options aren't compensation, what are they?). The
        // exact-dollar "includes" claim is true only for a latest-year base — an averaged or
        // normalized base embeds averaged SBC, so those get the looser (and true) wording.
        const sbcClause = sbc ? ", net of " + usd(SBC) + " stock comp"
          : (base > 0 && SBC > 0.05 * base
            ? (norm
              ? "; stock comp (" + usd(SBC) + " last year) is added back in the cash flow behind this base — the toggle above expenses it"
              : "; includes " + usd(SBC) + " of stock comp the cash flow adds back — the toggle above expenses it")
            : "");
        baseUsed.innerHTML = "Base in use: <b>" + usd(base) + "</b>" + (SH > 0 && isFinite(base / SH) ? " · <b>" + SYM + (base / SH).toFixed(2) + "</b>/share" : "") + ", " + kind + sbcClause + ".";
      }

      // The multiples schedule renders before any price: general arithmetic anyone may apply,
      // its assumptions worn on the row and column labels. No dollar value is computed here —
      // the publication does not publish what a share is "worth"; the reader may multiply a
      // multiple by the per-share base themselves, and the figure will be theirs
      // (see docs/valuation-doctrine-review.md).
      renderSens(gT, N);

      const price = parseFloat(px.value);
      if (!(price > 0)) {
        lede.textContent = "Enter a price above to run it."; impG.textContent = "—"; oeY.textContent = "—";
        if (ops) ops.hidden = true;
        if (cushionLine) cushionLine.hidden = true;
        if (sensLoc) sensLoc.hidden = true;
        if (ladder) ladder.hidden = true;
        if (baseRates) baseRates.hidden = true;
        if (evTog) evTog.hidden = true; if (evNote) evNote.hidden = true; evAdj = 0;
        if (pe) pe.textContent = "—"; if (pb) pb.textContent = "—"; if (ggate) { ggate.textContent = "—"; ggate.style.color = ""; }
        setURL(""); return;
      }
      if (!(SH > 0)) {
        lede.textContent = "Enter the shares outstanding above to run it."; impG.textContent = "—"; oeY.textContent = "—";
        if (ops) ops.hidden = true;
        if (cushionLine) cushionLine.hidden = true;
        if (sensLoc) sensLoc.hidden = true;
        if (ladder) ladder.hidden = true;
        if (baseRates) baseRates.hidden = true;
        if (evTog) evTog.hidden = true; if (evNote) evNote.hidden = true; evAdj = 0;
        if (pe) pe.textContent = "—"; if (pb) pb.textContent = "—"; if (ggate) { ggate.textContent = "—"; ggate.style.color = ""; }
        return;
      }
      const mc = price * SH;
      // Materiality is judged against the price actually being paid: the toggle appears only
      // when the net position is at least a twentieth of the implied market cap (and the debt
      // tagging is reliable). When on, the outlay becomes market cap plus net debt — net cash
      // enters negative and credits the price; net debt is assumed by the buyer and charges it.
      const evMaterial = BALOK && isFinite(ND) && ND !== 0 && Math.abs(ND) / mc >= 0.05;
      const evOnNow = evMaterial && evOn && evOn.checked;
      evAdj = evOnNow ? ND : 0;
      if (evTog) {
        evTog.hidden = !evMaterial;
        if (evMaterial && evLbl) evLbl.textContent = ND < 0
          ? "Count the " + usd(-ND) + " net cash: it comes with the purchase"
          : "Count the " + usd(ND) + " net debt: the buyer assumes it";
      }
      if (evNote) {
        if (evOnNow) {
          evNote.hidden = false;
          evNote.textContent = ND < 0
            ? "Net of " + usd(-ND) + " in cash and investments beyond all debt, the operating business is priced at " + usd(mc + ND) + "; every figure below reads on that outlay."
            : "With the " + usd(ND) + " of net debt a buyer assumes, the whole business costs " + usd(mc + ND) + "; every figure below reads on that outlay.";
        } else evNote.hidden = true;
      }
      const mcEff = mc + evAdj;
      const res = solve(mcEff / base, rr, N, gT);
      oeY.textContent = pcs(base / mcEff);
      if (pe || pb || ggate) {
        const peV = EPS3 > 0 ? price / EPS3 : null, pbV = BVPS > 0 ? price / BVPS : null;
        if (pe) pe.textContent = peV != null ? peV.toFixed(1) + "×" : "n/m";
        if (pb) pb.textContent = pbV != null ? pbV.toFixed(1) + "×" : "n/m";
        if (ggate) {
          if (peV != null && pbV != null) { const ok = peV <= 15 && peV * pbV <= 22.5; ggate.textContent = ok ? "Clears" : "Above his line"; ggate.style.color = ok ? "var(--good)" : "var(--muted)"; }
          else { ggate.textContent = "n/m"; ggate.style.color = ""; }
        }
      }
      if (!res) { impG.textContent = "—"; lede.textContent = "Set the required return above the terminal rate to run it."; if (ops) ops.hidden = true; if (cushionLine) cushionLine.hidden = true; if (sensLoc) sensLoc.hidden = true; if (ladder) ladder.hidden = true; if (baseRates) baseRates.hidden = true; bondView(); return; }
      impG.textContent = res.cap ? "100%+/yr" : pcs(res.g) + "/yr";
      const P = SYM + price.toFixed(2);
      if (res.cap) lede.innerHTML = `At <b>${P}</b>, even <b class="hot">100%+/yr</b> growth for a decade can't justify the price on owner earnings alone.`;
      else if (res.g < 0) lede.innerHTML = `At <b>${P}</b>, the market is pricing owner earnings to <b>shrink ${pcs(res.g)}/yr</b> for ${N} years, priced for decline.`;
      else lede.innerHTML = `At <b>${P}</b>, the market is pricing <b>${esc(NAME)}</b> to grow owner earnings about <b class="hot">${pcs(res.g)}</b>/yr for ${N} years, then ${(gT * 100).toFixed(1)}% forever, discounted at ${(rr * 100).toFixed(1)}%.`;
      // The base rate against the requirement: how often the record's own rolling five-year
      // windows delivered what the price implies. A count, symmetric whether flattering or
      // damning; no adjective attached.
      if (baseRates) {
        const WINS = famWins();
        if (sbcOn() && baseRates) {
          baseRates.hidden = false;
          baseRates.textContent = "With the base net of stock comp, the delivered comparisons are withheld: the record's series is gross of stock comp, and a net base against a gross record would be a quiet mismatch.";
        } else if (WINS && WINS.length >= 3 && !res.cap && isFinite(res.g)) {
          const k = WINS.filter((w) => w > res.g).length;
          baseRates.textContent = `Across its filed record, ${NAME} grew owner earnings above ${pcs(res.g)}/yr in ${k} of its ${WINS.length} rolling five-year windows.`;
          baseRates.hidden = false;
        } else baseRates.hidden = true;
      }
      // Margin of safety, as Graham used it: a discipline the buyer applies to their own price,
      // shown as what a one-third cushion buys in belief-space. No second dollar is printed.
      if (cushionLine) {
        // A third below the PRICE: the equity outlay falls 30%; the balance-sheet position the
        // toggle counts does not move with the quote, so it carries over unchanged.
        const cres = !res.cap ? solve((0.7 * mc + evAdj) / base, rr, N, gT) : null;
        if (cres && !cres.cap && isFinite(cres.g)) {
          const GD = famG();
          cushionLine.hidden = false;
          cushionLine.textContent = `A third below your price, the implied growth falls to ${pcs(cres.g)}/yr` + (!isNaN(GD) ? `, against ${pcs(GD)}/yr delivered` : "") + ".";
        } else cushionLine.hidden = true;
      }
      // Locate the paid multiple in the schedule, in prose and by the reader's own dials —
      // never by highlighting a cell as fair.
      if (sensLoc) {
        if (base > 0 && SCHED_ROWS.length) {
          const mult = (mcEff / base).toFixed(1);
          let wh;
          if (res.cap || res.g > SCHED_ROWS[SCHED_ROWS.length - 1].g) wh = `above the ${SCHED_ROWS[SCHED_ROWS.length - 1].pl} row`;
          else if (res.g < SCHED_ROWS[0].g) wh = `below the ${SCHED_ROWS[0].pl} row`;
          else { let i = 1; while (i < SCHED_ROWS.length && SCHED_ROWS[i].g < res.g) i++; wh = `between the ${SCHED_ROWS[i - 1].pl} and ${SCHED_ROWS[i].pl} rows`; }
          sensLoc.textContent = `At your required return and horizon, the ${mult}× you are paying sits ${wh} of the schedule.`;
          sensLoc.hidden = false;
        } else sensLoc.hidden = true;
      }
      // The implied-growth ladder: what earning each return from here would require believing,
      // every rung at once. Price-gated; the delivered rate is a labeled marker line among the
      // rungs, never a highlight — the reader who finds the crossing has derived their own
      // expected return without the page stating one.
      if (ladder && ladderTbl) {
        const RUNGS = [0.06, 0.08, 0.1, 0.12];
        const rungs = base > 0 ? RUNGS.map((rq) => ({ rq, r: solve(mcEff / base, rq, N, gT) })).filter((x) => x.r) : [];
        if (rungs.length === RUNGS.length) {
          const GD = famG();
          const marker = '<tr class="marker"><th>delivered</th><td>' + pcs(GD) + "/yr</td></tr>";
          let placed = isNaN(GD);
          let html = "<thead><tr><th>return required</th><th>growth to believe</th></tr></thead><tbody>";
          for (const x of rungs) {
            if (!placed && !x.r.cap && GD <= x.r.g) { html += marker; placed = true; }
            html += "<tr><th>" + (x.rq * 100).toFixed(0) + "%/yr</th><td>" + (x.r.cap ? "100%+/yr" : pcs(x.r.g) + "/yr") + "</td></tr>";
          }
          if (!placed && !isNaN(GD)) html += marker;
          ladderTbl.innerHTML = html + "</tbody>";
          ladder.hidden = false;
          if (ladderNote) ladderNote.textContent = "Each rung is the owner-earnings growth " + NAME + " must compound for " + N + " years (then " + (gT * 100).toFixed(1) + "% forever) for " + SYM + price.toFixed(2) + " to return that rate." + (!isNaN(GD) ? " The delivered line is the rate the record actually compounded at." : "");
        } else ladder.hidden = true;
      }
      // The operating picture behind the price.
      if (ops) {
        ops.hidden = false;
        // Implied market cap, and the multiples that price is on each trailing figure an owner watches.
        // No revenue multiple here for a business with positive owner earnings — a promoter's
        // denominator (Buffett, 2000, on metric-shopping). Revenue stays where it is load-bearing:
        // the implied-margin arithmetic below, and the negative mode, which has nothing else.
        let mcs = `At <b>${P}</b>, the implied market cap is <b class="hot">${usd(mc)}</b>: <b>${(mc / base).toFixed(1)}×</b> owner earnings`;
        if (NI > 0) mcs += `, <b>${(mc / NI).toFixed(1)}×</b> earnings`;
        if (opsMc) opsMc.innerHTML = mcs + ".";

        // Owner earnings the price implies by the terminal year, and what revenue must do to deliver
        // them — read both ways: at the delivered revenue growth, the margin it forces; and at a
        // margin you set, the revenue (and its growth) it forces. The capped/decline cases have no
        // honest end-state to read, so the operating lines fold away and only the multiples remain.
        const solved = !res.cap && res.g != null && isFinite(res.g) && res.g > 0;
        const oeN = solved ? base * Math.pow(1 + res.g, N) : null;
        if (solved && impOps) {
          let s = `To justify it, owner earnings would compound to about <b class="hot">${usd(oeN)}</b> by year ${N}, <b>${(oeN / base).toFixed(1)}×</b> today’s.`;
          if (REV > 0 && !isNaN(GREV) && GREV > -0.5) {
            const revN = REV * Math.pow(1 + GREV, N), margN = oeN / revN, margNow = base / REV;
            s += ` On revenue grown at its delivered ${pcs(GREV)}/yr to ${usd(revN)}, that is an owner-earnings margin near <b class="hot">${pcs(margN)}</b> (about ${pcs(margNow)} today).`;
          }
          impOps.innerHTML = s; impOps.hidden = false;
        } else if (impOps) impOps.hidden = true;

        // One gate on the margin machinery, not two (Graham 1958: precise formulas with
        // imprecise assumptions justify any value one wishes): the derived revenue requirement
        // prints only after the reader has set the dial — the reader's belief must be the
        // reader's, and the 25% rest is a resting place that computes nothing untouched. The
        // DIAL itself is always offered with a priced reading. It briefly shipped gated on
        // "the price demands a margin above today's," which locked the control away on exactly
        // the fast growers a reader most wants to test a mature margin against (the founder's
        // Chipotle catch, 2026-07-16): high delivered revenue growth makes the implied margin
        // fall below today's, but whether a price is defensible at the margin the READER would
        // credit is the reader's question at any price.
        if (solved && REV > 0 && marginRow && reqRev) {
          marginRow.hidden = false;
          const mm = mmDial ? parseFloat(mmDial.value) / 100 : 0.25;
          if (mmOut) mmOut.textContent = (mm * 100).toFixed(0) + "%";
          if (mmMainTouched) {
            const revReq = oeN / mm, grReq = Math.pow(revReq / REV, 1 / N) - 1;
            reqRev.innerHTML = `At a <b>${(mm * 100).toFixed(0)}%</b> mature owner-earnings margin, revenue must reach <b class="hot">${usd(revReq)}</b> by year ${N}: a <b class="hot">${pcs(grReq)}/yr</b> climb` + (!isNaN(GREV) && GREV > -0.5 ? ` (it has delivered ${pcs(GREV)}/yr)` : "") + ".";
            reqRev.hidden = false;
          } else reqRev.hidden = true;
        } else { if (marginRow) marginRow.hidden = true; if (reqRev) reqRev.hidden = true; }
      }
      bondView(); // re-render the yardstick on this tick's outlay basis (evAdj was set above)
      setURL(px.value);
    }
    // The reader's belief must be the reader's: the requirement line renders only after the
    // margin dial has actually been set (the same touched-gate the negative mode has always had).
    let mmMainTouched = false;
    if (mmDial) mmDial.addEventListener("input", () => { mmMainTouched = true; });
    [px, r, n, g, shInput, mmDial].forEach((el) => el && el.addEventListener("input", update));
    [oeNorm, oeSbc, oeMaint].forEach((el) => el && el.addEventListener("change", update));
    // The bond yield carries in the URL (like the price), so a shared link keeps the whole comparison.
    if (bondY) bondY.addEventListener("input", () => {
      try { const u = new URL(location.href); bondY.value ? u.searchParams.set("by", bondY.value) : u.searchParams.delete("by"); history.replaceState(null, "", u); } catch (e) {}
      bondView();
    });
    try {
      const q = new URL(location.href).searchParams.get("px"); if (q) px.value = q;
      // The bond field opens on the build-time Treasury default (set programmatically, so it stays out
      // of the URL until the reader overrides it); an explicit ?by= in the URL wins.
      const qb = new URL(location.href).searchParams.get("by");
      if (bondY) bondY.value = qb || box.dataset.bonddefault || "";
    } catch (e) {}
    // The price memory: when the URL brought no price, the reader's own saved price returns,
    // dated, and every valid edit is saved on their device; ?px= keeps precedence.
    wirePriceMemory(box.dataset.ticker, px, document.getElementById("pxMem"));
    update();
  })();
</script>

<script>
  import { gordonMultiple } from "../lib/reverseDcf.mjs";
  import { wirePriceMemory } from "../lib/priceMemory.mjs";
  (function () {
    const box = document.getElementById("valBoxNeg");
    if (!box) return;
    const REV = parseFloat(box.dataset.rev), SH = parseFloat(box.dataset.shares), NAME = box.dataset.name || "this company";
    const PROFIT = box.dataset.profitable === "1";
    const FROM = PROFIT ? "from negative free cash flow today" : "from a loss today";
    const SYM = box.dataset.sym || "$";
    const px = document.getElementById("pxn");
    const r = document.getElementById("rN"), n = document.getElementById("nN"), gr = document.getElementById("grN"), mm = document.getElementById("mmN");
    const rOut = document.getElementById("rOutN"), nOut = document.getElementById("nOutN"), grOut = document.getElementById("grOutN"), mmOut = document.getElementById("mmOutN");
    const lede = document.getElementById("ledeN"), reqOE = document.getElementById("reqOE"), reqM = document.getElementById("reqM");

    const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]));
    const pcs = (v) => (v < 0 ? "−" : "") + Math.abs(v * 100).toFixed(0) + "%";
    const usd = (v) => { const a = Math.abs(v); const s = a >= 1e12 ? SYM + (a / 1e12).toFixed(2) + "T" : a >= 1e9 ? SYM + (a / 1e9).toFixed(1) + "B" : a >= 1e6 ? SYM + Math.round(a / 1e6) + "M" : SYM + Math.round(a); return v < 0 ? "(" + s + ")" : s; };
    function setURL(v) { try { const u = new URL(location.href); v ? u.searchParams.set("px", v) : u.searchParams.delete("px"); history.replaceState(null, "", u); } catch (e) {} }

    function update() {
      const rr = parseFloat(r.value) / 100, N = parseInt(n.value, 10), g = parseFloat(gr.value) / 100, mgn = parseFloat(mm.value) / 100;
      rOut.textContent = r.value + "%"; nOut.textContent = N; grOut.textContent = gr.value + "%"; mmOut.textContent = mm.value + "%";
      const M = gordonMultiple(rr, 0.025) || 0; // mature owner-earnings multiple at this discount rate (2.5% terminal)
      const revN = REV * Math.pow(1 + g, N);  // revenue grown at your rate

      // No reference value is computed: the belief side lives in the dial, and the lede compares
      // the margin the price demands against the margin the reader credits — a relationship, not
      // a published worth (see docs/valuation-doctrine-review.md).
      const price = parseFloat(px.value);
      if (!(price > 0)) { lede.textContent = "Enter a price to run it."; reqOE.textContent = "—"; reqM.textContent = "—"; setURL(""); return; }
      const mc = price * SH;
      const valN = mc * Math.pow(1 + rr, N);  // equity value it must reach in year N to return rr
      const requiredOE = valN / M;
      const reqMargin = requiredOE / revN;
      reqOE.textContent = usd(requiredOE);
      reqM.textContent = reqMargin > 3 ? ">300%" : pcs(reqMargin);
      const P = SYM + price.toFixed(2);
      let verdict;
      if (reqMargin > 1) verdict = `, more owner earnings than the business would have revenue: a margin above 100%, which is arithmetically unreachable.`;
      else if (reqMargin > 0.45) verdict = `, a margin above 45% of revenue, sustained; the filings and its peers’ records are where you weigh whether this business can hold one, ${FROM}.`;
      else if (reqMargin > 0.3) verdict = `, a margin above 30% of revenue, sustained; the record and its peers are where you weigh it, ${FROM}.`;
      else if (!mmTouched) verdict = `, ${FROM}. The margin dial above asks what you would credit at maturity; that comparison is yours to make.`;
      else if (reqMargin > mgn) verdict = `, above the ${mm.value}% margin you set above; the price implies more than your own input credits.`;
      else verdict = `, at or below the ${mm.value}% you would credit, ${FROM}.`;
      lede.innerHTML = `At <b>${P}</b>, to earn you ${r.value}% a year, ${esc(NAME)} must be worth ${usd(valN)} in ${N} years. At ~${M.toFixed(0)}× owner earnings, that is <b class="hot">${usd(requiredOE)}</b> a year, on revenue grown ${g > 0 ? "at " + gr.value + "%/yr" : "flat"} to ${usd(revN)}: an owner-earnings margin of <b class="hot">${reqMargin > 3 ? ">300%" : pcs(reqMargin)}</b>${verdict}`;
      setURL(px.value);
    }
    // The reader's belief must be the reader's: the dial has to rest somewhere, so the
    // demanded-vs-credited comparison enters the lede only after the dial has been touched.
    let mmTouched = false;
    mm.addEventListener("input", () => { mmTouched = true; });
    [px, r, n, gr, mm].forEach((el) => el.addEventListener("input", update));
    try { const q = new URL(location.href).searchParams.get("px"); if (q) px.value = q; } catch (e) {}
    // The price memory: the reader's own saved price returns dated when the URL brought none.
    wirePriceMemory(box.dataset.ticker, px, document.getElementById("pxMemN"));
    update();
  })();
</script>

<script>
  import { justifiedBookMultiple } from "../lib/reverseDcf.mjs";
  import { wirePriceMemory } from "../lib/priceMemory.mjs";
  (function () {
    const box = document.getElementById("valBoxBank");
    if (!box) return;
    const TBVPS = parseFloat(box.dataset.tbvps), BVPS = parseFloat(box.dataset.bvps), ROTCE = parseFloat(box.dataset.rotce);
    const EPS = parseFloat(box.dataset.eps), NAME = box.dataset.name || "this company", CYCLE = box.dataset.cycle || "credit cycle";
    const SYM = box.dataset.sym || "$";
    const px = document.getElementById("pxb");
    const coe = document.getElementById("coeB"), gB = document.getElementById("gB");
    const coeOut = document.getElementById("coeOut"), gOutB = document.getElementById("gOutB");
    const lede = document.getElementById("ledeB"), ptbv = document.getElementById("ptbv"), just = document.getElementById("justptbv");
    const pbB = document.getElementById("pbBank"), eyB = document.getElementById("eyBank"), peB = document.getElementById("peBank");
    const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]));

    function setURL(v) { try { const u = new URL(location.href); v ? u.searchParams.set("px", v) : u.searchParams.delete("px"); history.replaceState(null, "", u); } catch (e) {} }

    function update() {
      const c = parseFloat(coe.value) / 100, g = parseFloat(gB.value) / 100;
      coeOut.textContent = coe.value + "%"; gOutB.textContent = gB.value + "%";
      // The justified MULTIPLE is a schedule value (general arithmetic on the dials) and stands
      // on its own. No dollar reference value is computed — the reader may multiply the multiple
      // by tangible book per share themselves (see docs/valuation-doctrine-review.md).
      const justified = justifiedBookMultiple(ROTCE, c, g);
      just.textContent = justified != null ? justified.toFixed(1) + "×" : "—";
      const price = parseFloat(px.value);
      if (!(price > 0)) { lede.textContent = "Enter a price above to run it."; [ptbv, pbB, eyB, peB].forEach((e) => (e.textContent = "—")); const gg0 = document.getElementById("ggateBank"); if (gg0) { gg0.textContent = "—"; gg0.style.color = ""; } setURL(""); return; }
      const ptb = price / TBVPS;
      ptbv.textContent = ptb.toFixed(2) + "×";
      pbB.textContent = (price / BVPS).toFixed(2) + "×";
      if (EPS > 0) { eyB.textContent = ((EPS / price) * 100).toFixed(1) + "%"; peB.textContent = (price / EPS).toFixed(1) + "×"; }
      else { eyB.textContent = "n/m"; peB.textContent = "n/m"; }
      // Graham's ch.14 gate, extended to financial enterprises: 15x the averaged earnings, and
      // PE x PB no more than 22.5. Rendered exactly as the main-mode gate renders it — the two
      // gates must never speak in different registers about the same standard.
      const ggB = document.getElementById("ggateBank");
      if (ggB) {
        if (EPS > 0 && BVPS > 0) {
          const peV = price / EPS, pbV = price / BVPS;
          const ok = peV <= 15 && peV * pbV <= 22.5;
          ggB.textContent = ok ? "Clears" : "Above his line"; ggB.style.color = ok ? "var(--good)" : "var(--muted)";
        } else { ggB.textContent = "n/m"; ggB.style.color = ""; }
      }
      const P = SYM + price.toFixed(2), R = (ROTCE * 100).toFixed(0);
      if (justified == null) { lede.textContent = "Set the cost of equity above the growth rate."; setURL(px.value); return; }
      // Two multiples, stated plainly: the one the reader is paying, and the one the dials
      // justify. No band, no adjective — which is larger is the reader's own reading.
      lede.innerHTML = `At <b>${P}</b>, you pay <b class="hot">${ptb.toFixed(2)}×</b> tangible book for ${esc(NAME)}; at the cost of equity and growth you set, a ${R}% return on tangible equity supports about <b>${justified.toFixed(1)}×</b>. Whether that return holds past the ${CYCLE} is what the record and the 10-K decide.`;
      setURL(px.value);
    }
    [px, coe, gB].forEach((el) => el.addEventListener("input", update));
    try { const q = new URL(location.href).searchParams.get("px"); if (q) px.value = q; } catch (e) {}
    // The price memory: the reader's own saved price returns dated when the URL brought none.
    wirePriceMemory(box.dataset.ticker, px, document.getElementById("pxMemB"));
    update();
  })();
</script>

<script>
  import { gordonMultiple } from "../lib/reverseDcf.mjs";
  import { wirePriceMemory } from "../lib/priceMemory.mjs";
  (function () {
    const box = document.getElementById("valBoxReit");
    if (!box) return;
    const FFOPS = parseFloat(box.dataset.ffops), DPS = parseFloat(box.dataset.dps), NAME = box.dataset.name || "this REIT";
    const SYM = box.dataset.sym || "$";
    const px = document.getElementById("pxr");
    const r = document.getElementById("rR"), g = document.getElementById("gR");
    const rOut = document.getElementById("rOutR"), gOut = document.getElementById("gOutR");
    const lede = document.getElementById("ledeR"), pffo = document.getElementById("pffo"), just = document.getElementById("justpffo"), dyR = document.getElementById("dyR");
    const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]));
    function setURL(v) { try { const u = new URL(location.href); v ? u.searchParams.set("px", v) : u.searchParams.delete("px"); history.replaceState(null, "", u); } catch (e) {} }

    function update() {
      const rr = parseFloat(r.value) / 100, gg = parseFloat(g.value) / 100;
      rOut.textContent = r.value + "%"; gOut.textContent = g.value + "%";
      // The justified MULTIPLE is a schedule value and stands on its own. No dollar reference
      // value is computed — the reader may multiply the multiple by FFO per share themselves
      // (see docs/valuation-doctrine-review.md).
      const justified = gordonMultiple(rr, gg);
      just.textContent = justified != null ? justified.toFixed(1) + "×" : "—";
      const price = parseFloat(px.value);
      if (!(price > 0)) { lede.textContent = "Enter a price above to run it."; [pffo, dyR].forEach((e) => (e.textContent = "—")); setURL(""); return; }
      const pf = price / FFOPS;
      pffo.textContent = pf.toFixed(1) + "×";
      const dy = DPS > 0 ? DPS / price : null;
      dyR.textContent = dy != null ? (dy * 100).toFixed(1) + "%" : "—";
      const P = SYM + price.toFixed(2);
      if (justified == null) { lede.textContent = "Set the required return above the growth rate."; setURL(px.value); return; }
      // Two multiples, stated plainly; which is larger is the reader's own reading.
      const income = dy != null ? ` The income alone is a ${(dy * 100).toFixed(1)}% yield.` : "";
      lede.innerHTML = `At <b>${P}</b>, you pay <b class="hot">${pf.toFixed(1)}×</b> funds from operations for ${esc(NAME)}; ${g.value}% FFO growth at a required return of ${r.value}% supports about <b>${justified.toFixed(1)}×</b>.${income}`;
      setURL(px.value);
    }
    [px, r, g].forEach((el) => el.addEventListener("input", update));
    try { const q = new URL(location.href).searchParams.get("px"); if (q) px.value = q; } catch (e) {}
    // The price memory: the reader's own saved price returns dated when the URL brought none.
    wirePriceMemory(box.dataset.ticker, px, document.getElementById("pxMemR"));
    update();
  })();
</script>
