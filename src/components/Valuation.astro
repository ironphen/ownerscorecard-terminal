---
// "What the price implies", a reader-supplied-price reverse-DCF. We pull no price
// feed and send nothing anywhere: you bring the quote (off any broker), we do the math in
// your browser. The one thing remembered is the price you typed, kept on your own device
// and returned dated on the next visit (the price memory, lib/priceMemory.mjs; an explicit
// ?px= in the URL still wins). That sidesteps every market-data licence and keeps the page
// honest, the only number we'd ever "redistribute" is the one you typed in. Never a price
// target: it shows the owner-earnings growth a price implies, set against the record.
import { classify, financialKind, financialSubtype } from "../lib/archetype.mjs";
import { moatReport } from "../lib/durability.mjs";
import { fmtMoney, currencySymbol, liquidAssets, maintenanceCapex, maintenanceCapexFor, ownerEarningsAbs, debtReliable } from "../lib/fundamentals.mjs";
import { tangibleEquity } from "../lib/financials.mjs";
import { ffoPerShare } from "../lib/reits.mjs";
import { earningsPower } from "../lib/normalize.mjs";
import NotebookCapture from "./NotebookCapture.astro";
import NotebookStrip from "./NotebookStrip.astro";
import { trendGrowth } from "../lib/valuationInputs.mjs";
import rates from "../data/rates.json";
import adrRatios from "../data/adrRatios.json";
import { adrBasis } from "../lib/adrBasis.mjs";
import DeliveredGrowth from "./DeliveredGrowth.astro";
import Sparkline from "./Sparkline.astro";

// The series behind a delivered-growth anchor: the same window the CAGR above is read over
// (the last `maxSpan` years, with the latest figure as the final point), so the rate, the
// sparkline and the "N-yr record" label all agree. null when the record is too short.
const sparkWin = (vals, maxSpan, latest) => {
  const xs = (vals || []).filter((v) => v != null);
  if (xs.length < 3) return null;
  const span = Math.min(maxSpan, xs.length - 1);
  const win = xs.slice(xs.length - 1 - span);
  if (latest != null) win[win.length - 1] = latest;
  return win;
};

const { company } = Astro.props;
// ---- ADR basis conversion (shared lib: lib/adrBasis.mjs; compare columns use the same) --------
// Convert once — every monetary figure × FX, share count ÷ ADS ratio — so everything downstream
// is USD per ADS, the exact basis of the quote the reader types. Warn mode when terms are missing.
const ab = adrBasis(company, adrRatios, rates);
const { co, auto: adrAuto, isADR: isADRRaw, homeCcy, basis: adsBasis, quote: adsQuote, fxUsd } = ab;
const fxDisp = fxUsd != null && homeCcy !== "USD" ? `${homeCcy} 1 = $${fxUsd.toFixed(homeCcy === "JPY" || homeCcy === "KRW" ? 4 : 3)}` : null;
const fxAsOfDisp = ab.fxAsOf;
// ----------------------------------------------------------------------------------------------
// Currency-aware: the reader brings the price (in the listing currency), and the tool does
// the math in their browser. The symbol travels into each interactive box via data-sym.
const ccy = co.currency || "USD";
const sym = currencySymbol(ccy);
const $ = (v) => fmtMoney(v, ccy);
const { sector, overlays } = classify(co);
// A lender, an insurer and a REIT are not read on an owner-earnings DCF; each routes to
// its own balance-sheet or FFO lens. Asset managers, exchanges, brokers and health plans
// are capital-light cash generators, so they keep the owner-earnings reverse-DCF, the
// right lens for a business whose value is the cash it throws off, not its book.
const fk = financialKind(co);
const isInsurer = fk === "insurer";
const offModel = fk === "bank" || fk === "insurer" || fk === "reit";
// ADR fallback: when the ADS ratio or the FX rate is missing, the conversion above didn't run,
// and the only honest instruction is the old one — enter the home-market ordinary-share price.
const isADR = isADRRaw && !adrAuto;
const cyclical = overlays.some((o) => o.key === "cyclical");
const median = (xs) => { if (!xs.length) return null; const s = [...xs].sort((a, b) => a - b); const m = Math.floor(s.length / 2); return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };
// A fiscal year as a two-digit tick (’25), and the inclusive span of a delivered-growth window —
// the last `n` points its CAGR and sparkline are read over — labelled ’20→’25, so every record
// anchor names the years it covers rather than leaving a bare count's start year to guess.
const yy = (fy) => (fy == null ? "" : `’${String(fy).slice(-2)}`);
const winRangeYrs = (pairs, n = 6) => { const w = (pairs || []).slice(-n); return w.length >= 2 ? `${yy(w[0].fy)}→${yy(w[w.length - 1].fy)}` : null; };
// Delivered growth (trendGrowth) and the reverse-DCF math (pv/solve/justified multiples) live in
// shared libs — lib/valuationInputs.mjs and lib/reverseDcf.mjs — so this page and the head-to-head
// compare view read a business through identical arithmetic. trendGrowth is imported above.

const L = co.ttm?.lines || co.lines || {};
// Share count turns the price into a market cap, and the right count for that job is the dated
// INSTANTANEOUS one — sharesForValue, the filing cover's count under a guarded chain in the
// pipeline — not the weighted-average diluted count, which remains the per-share denominator in
// the record tables but overstates a convertible issuer's real outstanding count (GameStop's
// if-converted average ran a third above its actual shares). Fall back through the old chain
// for records not yet refreshed; and when every source is missing (Up-C structures, multiple
// share classes — Planet Fitness, Shopify), run the owner-earnings mode anyway and let the
// reader bring the share count, the same way they bring the price.
const sfv = co.sharesForValue && co.sharesForValue.val > 0 ? co.sharesForValue : null;
const shares = sfv?.val ?? L.sharesDiluted ?? co.lines?.sharesDiluted ?? null;
const haveShares = shares != null && shares > 0;
// The if-converted overhang a buyer inherits (convertibles, options): shown when material, so
// the dilution stays visible even though it no longer inflates the market-cap arithmetic.
const dilutedCount = L.sharesDiluted ?? co.lines?.sharesDiluted ?? null;
const overhangPct = sfv && dilutedCount && dilutedCount / sfv.val > 1.03
  ? Math.round((dilutedCount / sfv.val - 1) * 100) : null;
const cfo = L.cashFromOps, capex = L.capex;
const ownerEarnings = cfo != null && capex != null ? cfo - Math.abs(capex) : null;
const netDebt = (L.totalDebt || 0) - (liquidAssets(L) || 0);
// Whether the balance-sheet toggle may show at all: an under-captured debt line (a filer whose
// interest bill proves debt the tags don't carry) would make "net cash" a fiction, so the
// toggle requires the same reliability read the record table applies.
const balanceOk = debtReliable(L);
// `runnable` is decided below, once the normalized and steady-state bases are known: the latest
// year can be negative on total capex (a build-out) while a through-cycle or maintenance-capex
// base is solidly positive, and that should still run the owner-earnings tool, not the loss read.

// Graham's price-gate inputs: 3-year average earnings (his method, to avoid paying
// for a peak) and current book value, both per share.
const niH3 = (co.history || []).filter((h) => h?.lines?.netIncome != null).slice(-3);
const niH = niH3.map((h) => h.lines.netIncome);
const eps3 = niH.length >= 2 && shares ? niH.reduce((a, b) => a + b, 0) / niH.length / shares : null;
// The averaging window's actual fiscal years, named on the label — a bare "3-yr" leaves the
// reader to guess which years the average was read over.
const eps3Span = niH3.length >= 2 ? `’${String(niH3[0].fy).slice(-2)}–’${String(niH3[niH3.length - 1].fy).slice(-2)}` : null;
const bvps = L.stockholdersEquity != null && shares ? L.stockholdersEquity / shares : null;

// An honest base, on demand: a 3-year average of owner earnings (Graham's normalization,
// to avoid anchoring on one noisy year) and the latest stock comp (so it can be treated as
// the expense Munger insisted it is). Both are toggles in the tool.
const oeHist = (co.history || []).map((h) => (h.lines.cashFromOps != null && h.lines.capex != null ? h.lines.cashFromOps - Math.abs(h.lines.capex) : null));
const oe3vals = [...oeHist].reverse().filter((v) => v != null).slice(0, 3);
const oe3 = oe3vals.length >= 2 ? oe3vals.reduce((a, b) => a + b, 0) / oe3vals.length : ownerEarnings;
// The normalized base, Graham's through-cycle figure: the average owner-earnings margin of the
// record applied to today's revenue. Falls back to a 3-year average where the record is too short.
const ep = earningsPower(co);
const oeNormalized = ep?.normOE ?? oe3;
// Graham's through-cycle (peak-vs-trough) read, surfaced here at the point of valuation rather than in
// a separate "earnings power" section: where the latest year's owner-earnings margin sits against its
// own through-cycle median, so a price typed on a peak year is flagged as one. Only when the
// normalization is stable (a positive, meaningful through-cycle figure).
const cycleRead = ep && ep.normOE != null && ep.cyclePos && !ep.normUnstable && !ep.structuralBreak ? ep.cyclePos : null;
const sbcLatest = L.stockBasedComp ?? co.lines?.stockBasedComp ?? 0;
// Steady-state owner earnings: Buffett's definition subtracts maintenance capex, not total
// capex. For a business in a build-out (the AI capex wave most of all) total capex understates
// the cash it would throw off at rest, so we offer a base that swaps capex for depreciation,
// the standard maintenance-capex proxy. Offered only when it differs enough to matter.
const dep = L.depreciation;
// Maintenance capex (Buffett's owner earnings base) instead of total: the same per-company estimate
// the owner-earnings bridge uses, so the steady-state lens here and the bridge never disagree. It
// carves growth capex out only for a business spending above depreciation while it grows.
const maintCx = maintenanceCapex(co);
const ownerEarningsMaint = cfo != null && maintCx != null ? cfo - maintCx : null;
// The steady-state history reads the SAME per-year maintenance definition the whole site reads
// (ownerEarningsAbs = CFO − maintenanceCapexFor), never raw depreciation — a third quiet variant
// of "owner earnings" was exactly the mixing the 1986 appendix was written against. Where a year
// can't support the maintenance estimate, the year is withheld from the average, never blended.
const oeHistMaint = (co.history || []).map((h) => ownerEarningsAbs(h.lines, company));
const oem3vals = [...oeHistMaint].reverse().filter((v) => v != null).slice(0, 3);
const oe3Maint = oem3vals.length >= 2 ? oem3vals.reduce((a, b) => a + b, 0) / oem3vals.length : ownerEarningsMaint;
// Show the steady-state toggle only where it actually differs — a real builder whose growth capex
// the maintenance estimate carves out; when maintenance ≈ total capex it would just be a dial for
// its own sake.
const offerMaint = ownerEarningsMaint != null && ownerEarnings != null && maintCx != null && capex != null && maintCx < Math.abs(capex) * 0.9;
// The owner-earnings growth the business actually delivered, as a number, to anchor a
// reference value against (never a target): what the record would be worth on its own record.
const oeSeries = oeHist.filter((v) => v != null);
// The delivered-growth fallback and the sparkline both read the MAINTENANCE-based series — the
// same family as gDeliv5, the windows, and the durability card — so the delivered row is one
// definition top to bottom. The old fallback quietly dropped to the total-capex series when the
// five-point window was short, mixing families inside a single readout; and the sparkline drew
// the total-capex shape beside a maintenance-based number. (The remaining cross-family seam —
// this maintenance-based delivered row against the free-cash-flow interactive base — is the
// design doc's A1 part 2: both families precomputed, swapped with the Steady-state toggle.)
const oeMaintSeries = oeHistMaint.filter((v) => v != null);
const gDeliv = trendGrowth(oeMaintSeries.slice(-8));
const oeWin = sparkWin(oeMaintSeries, 7, null);

// A positive base to anchor the reverse-DCF can come from the latest year, the through-cycle
// normalization, or — for a business mid-build-out whose total capex buries the cash it throws
// off at rest — the steady-state (maintenance-capex) figure. When the latest year is negative on
// total capex but a normalized or steady-state base is positive (Air Products, a cyclical at a
// trough), we still run the owner-earnings tool and open it on that base with the toggle
// pre-checked, so the normalize controls are right there — rather than dropping to the loss read.
const maintBasePos = offerMaint && (((ownerEarningsMaint ?? -1) > 0) || ((oe3Maint ?? -1) > 0));
const normBasePos = (oeNormalized ?? -1) > 0;
const defaultMaint = !(ownerEarnings > 0) && maintBasePos;
// Symmetric by rule, not by convenience: the through-cycle base pre-checks when the latest year
// is a trough (rescuing the tool, the long-standing case) AND when it is a peak — Graham's
// averaging exists precisely to avoid pricing on a flattering year (Intelligent Investor ch.14),
// and a default that corrects the record only in the direction that raises the base is the tool
// quietly pronouncing in the price's favor. Clearing the toggle reads the year as filed.
const defaultNorm = (!(ownerEarnings > 0) && !defaultMaint && normBasePos) || (cycleRead === "above" && normBasePos);
const runnable = (ownerEarnings != null && ownerEarnings > 0) || defaultMaint || defaultNorm;

// Book-value valuation: a bank or an insurer is worth a multiple of tangible book set
// by the return it earns on that book. Same math for both; only the wording differs,
// since an insurer's cycle is underwriting, not credit. Normalize over the record.
const isBank = fk === "bank" || fk === "insurer";
const isMReit = financialSubtype(co) === "mortgage-reit";
const finKind = isInsurer ? "insurer" : isMReit ? "mortgage REIT" : "bank";
const bankRisk = isInsurer
  ? "an underwriting cycle, a reserve shortfall or a bad year on the float"
  : isMReit
  ? "a rate shock, a spread that compresses or a credit cycle"
  : "a credit cycle, a rate shock or a bad acquisition";
const tEq = tangibleEquity(L);
const tbvps = tEq != null && shares ? tEq / shares : null;
const bvpsB = L.stockholdersEquity != null && shares ? L.stockholdersEquity / shares : null;
// A bank's P/E and earnings yield read on the 3-year average, never the latest year alone: a
// bank at a credit-cycle peak is the canonical flattering single-year multiple (reserve releases
// and benign charge-offs inflate exactly the year a buyer is shown), and Intelligent Investor
// ch.14 applies the same averaged standard to financial enterprises. The label carries the span.
const niB3 = (co.history || []).filter((h) => h?.lines?.netIncome != null).slice(-3);
const epsB = niB3.length >= 2 && shares ? niB3.reduce((a, b) => a + b.lines.netIncome, 0) / niB3.length / shares
  : (L.netIncome != null && shares ? L.netIncome / shares : null);
const epsBSpan = niB3.length >= 2 ? `’${String(niB3[0].fy).slice(-2)}–’${String(niB3[niB3.length - 1].fy).slice(-2)}` : null;
const rotceH = (co.history || [])
  .map((h) => { const t = tangibleEquity(h.lines); return h.lines.netIncome != null && t && t > 0 ? h.lines.netIncome / t : null; })
  .filter((v) => v != null);
const rotceMed = rotceH.length >= 3 ? median(rotceH) : null;
const bankRunnable = isBank && tbvps != null && tbvps > 0 && rotceMed != null;
// Delivered tangible-book-per-share growth, the record anchor for the bank/insurer growth dial.
const tbvpsPairs = (co.history || [])
  .map((h) => { const t = tangibleEquity(h.lines); const s = h.lines.sharesDiluted; return { fy: h.fy, v: t != null && s ? t / s : null }; })
  .filter((p) => p.v != null);
const tbvpsH = tbvpsPairs.map((p) => p.v);
const tbvGrowthRaw = trendGrowth(tbvpsH.slice(-6));
const tbvWin = sparkWin(tbvpsH, 5, tbvps);
const tbvRange = winRangeYrs(tbvpsPairs);

// REIT valuation: a property trust is priced on a multiple of funds from operations,
// its cash earnings once property depreciation is added back.
const isReit = fk === "reit";
const ffops = ffoPerShare(L);
const dpsReit = L.dividendsPaid != null && shares ? Math.abs(L.dividendsPaid) / shares : null;
const ffopsPairs = (co.history || []).map((h) => ({ fy: h.fy, v: ffoPerShare(h.lines) })).filter((p) => p.v != null);
const ffopsH = ffopsPairs.map((p) => p.v);
const ffoGrowthRaw = trendGrowth(ffopsH.slice(-6));
const ffoWin = sparkWin(ffopsH, 5, ffops);
const ffoRange = winRangeYrs(ffopsPairs);
// The growth dial rests at a fixed neutral value, never at the delivered rate: presetting a dial
// to the record's own growth quietly asserts the past continues — the projection Security
// Analysis ch.37 warns against. The delivered rate stays exactly where it belongs, as the labeled
// anchor beside the dial, one fact among the reader's choices.
const reitGrowthPct = 3;
const reitRunnable = isReit && ffops != null && ffops > 0 && shares != null && shares > 0;

// Negative-owner-earnings mode: a reverse-DCF can't grow a negative base, so we flip
// the question to the future profitability the price demands. Inputs: revenue and its
// recent growth, the only honest base when there are no earnings yet.
const rev = L.revenue;
const revPairs = (co.history || []).map((h) => ({ fy: h.fy, v: h.lines.revenue })).filter((p) => p.v != null);
const revH = revPairs.map((p) => p.v);
const gRevRaw = trendGrowth(revH.slice(-6));
const revWin = sparkWin(revH, 5, co.ttm?.lines?.revenue);
const revRange = winRangeYrs(revPairs);
const negMode = !runnable && !offModel && rev != null && rev > 0 && shares != null && shares > 0;
// Same rule as the REIT dial: the revenue dial rests flat (0%), never at the delivered rate —
// the lede already words a zero rest honestly ("on revenue grown flat"), and the delivered rate
// remains the labeled anchor beside the dial for the reader to adopt or reject.
const gRevPct = 0;
const oeMarginNow = ownerEarnings != null && rev ? ownerEarnings / rev : null;
// Negative owner earnings come in two very different kinds: a genuine loss, and a
// profitable business whose capital spending currently outruns its operating cash (a
// build-out, common to utilities, railroads, telecoms). The tool must not call the second
// a "loss"; net income sets which framing is honest.
const niNow = L.netIncome ?? co.lines?.netIncome ?? null;
const profitableNeg = niNow != null && niNow > 0;

const report = moatReport(co);
const oeGrowth = report?.facts.find((f) => f.label === "Owner earnings growth")?.value ?? null;
// Delivered owner-earnings growth over a recent 5-year window, beside the full record: a
// full-record CAGR can smooth over a recent acceleration or fade, so the shorter read sits next
// to it. Same maintenance-based owner-earnings series (ownerEarningsAbs) and the same
// 2-year-averaged-endpoint method the durability card's figure uses, read over each window, so the
// two compare cleanly. Only shown when the record runs past five years, else it just repeats it.
const oeAbsHist = (co.history || [])
  .filter((h) => h?.lines?.revenue != null)
  .map((h) => ({ fy: h.fy, v: ownerEarningsAbs(h.lines, company) }))
  .filter((p) => p.v != null);
const deliveredOe = (pts) => {
  if (pts.length < 4) return null;
  const early = (pts[0].v + pts[1].v) / 2;
  const late = (pts[pts.length - 1].v + pts[pts.length - 2].v) / 2;
  const yrs = pts[pts.length - 1].fy - pts[0].fy;
  return early > 0 && late > 0 && yrs > 0 ? Math.pow(late / early, 1 / yrs) - 1 : null;
};
const recYrs = report?.years?.length ?? oeAbsHist.length;
const gDeliv5 = oeAbsHist.length > 5 ? deliveredOe(oeAbsHist.slice(-5)) : null;
// Base rates for the reverse read: the record's own rolling five-year owner-earnings growth
// rates, so the page can count how often this business actually delivered what a typed price
// implies. Exact five-year spans with both endpoints positive (a CAGR exists for no other kind),
// and only for records of eight-plus years — a short record has no base rate worth counting.
// Rendered client-side as a count, symmetric whether flattering or damning.
const oeWins = (() => {
  if (oeAbsHist.length < 8) return null;
  const out = [];
  for (let i = 0; i + 5 < oeAbsHist.length; i++) {
    const a = oeAbsHist[i], b = oeAbsHist[i + 5];
    if (b.fy - a.fy === 5 && a.v > 0 && b.v > 0) out.push(+(Math.pow(b.v / a.v, 1 / 5) - 1).toFixed(4));
  }
  return out.length >= 3 ? out : null;
})();
const gFmt = (v) => (v == null ? "—" : `${v >= 0 ? "+" : "−"}${Math.abs(v * 100).toFixed(0)}%/yr`);
// A turnaround the CAGRs can't read: when owner earnings cross from losses to profit there's no
// full-record (or 5-year) CAGR to take — you can't annualize a move from negative to positive. But
// a business whose owner earnings have turned positive and are climbing (Unity: a loss through 2022,
// then $179M → $463M) has delivered something worth showing, not a blank. So when no CAGR exists we
// read the growth over the most recent unbroken run of positive years and label it from where it
// began, so the turn reads as a turn. It is not fed into the reference value: a rate off a low,
// just-positive base isn't one it's honest to extrapolate ten years out, which the 30% cap there enforces.
const recentOe = (oeGrowth == null) ? (() => {
  let i = oeAbsHist.length - 1;
  while (i >= 0 && oeAbsHist[i].v > 0) i--;
  const run = oeAbsHist.slice(i + 1);
  if (run.length < 2) return null;
  const yrs = run[run.length - 1].fy - run[0].fy;
  return yrs > 0 ? { g: Math.pow(run[run.length - 1].v / run[0].v, 1 / yrs) - 1, fromFy: run[0].fy } : null;
})() : null;
// The actual fiscal-year endpoints behind each delivered-growth window, shown in place of a bare
// "5 yr" / "10 yr" so the reader sees exactly which years the CAGR was read over (e.g. ’16→’25),
// rather than a trailing count whose start year is left to guess. Each range is the inclusive span
// of the same window its CAGR is computed over: the recent five-point window, and the full record.
const range5 = gDeliv5 != null && oeAbsHist.length >= 5
  ? `${yy(oeAbsHist[oeAbsHist.length - 5].fy)}→${yy(oeAbsHist[oeAbsHist.length - 1].fy)}`
  : null;
const recRange = oeGrowth != null && oeAbsHist.length >= 2
  ? `${yy(oeAbsHist[0].fy)}→${yy(oeAbsHist[oeAbsHist.length - 1].fy)}`
  : null;
// Label and value for the delivered-growth row: the full record where a CAGR exists, else the
// recent positive run for a turnaround, else withheld.
const dLabel = oeGrowth != null
  ? (recRange ? `Owner-earnings growth · ${recRange}`
     : gDeliv5 != null ? `Owner-earnings growth · ${recYrs} yr`
     : "Owner-earnings growth, delivered")
  : recentOe != null ? `Owner-earnings growth · since FY${recentOe.fromFy}`
  : "Owner-earnings growth, delivered";
const dValue = oeGrowth != null ? `${oeGrowth.replace("/yr", "")}/yr`
  : recentOe != null ? gFmt(recentOe.g)
  : "—";

// ---- the TOTAL-capex (free-cash-flow) family, precomputed beside the maintenance family ----
// The interactive base opens on CFO − total capex; the delivered row, the sparkline, the rolling
// windows and the ladder marker must read the SAME capex treatment as the base in use, or the
// comparison is apples against oranges (a maintenance-based delivered series systematically beats
// a free-cash-flow implied requirement — the exact bias the 1986 appendix was written against).
// Both families are computed here and swapped client-side with the Steady-state toggle; each is
// internally consistent, and neither ever borrows the other's years.
const oeFcfPts = (co.history || [])
  .filter((h) => h?.lines?.revenue != null)
  .map((h) => ({ fy: h.fy, v: h.lines.cashFromOps != null && h.lines.capex != null ? h.lines.cashFromOps - Math.abs(h.lines.capex) : null }))
  .filter((p) => p.v != null);
const famOf = (pts) => {
  const gFull = deliveredOe(pts);
  const g5 = pts.length > 5 ? deliveredOe(pts.slice(-5)) : null;
  let recent = null;
  if (gFull == null) {
    let i = pts.length - 1;
    while (i >= 0 && pts[i].v > 0) i--;
    const run = pts.slice(i + 1);
    if (run.length >= 2) {
      const yrs = run[run.length - 1].fy - run[0].fy;
      if (yrs > 0) recent = { g: Math.pow(run[run.length - 1].v / run[0].v, 1 / yrs) - 1, fromFy: run[0].fy };
    }
  }
  const wins = (() => {
    if (pts.length < 8) return null;
    const out = [];
    for (let i = 0; i + 5 < pts.length; i++) {
      const a = pts[i], b = pts[i + 5];
      if (b.fy - a.fy === 5 && a.v > 0 && b.v > 0) out.push(+(Math.pow(b.v / a.v, 1 / 5) - 1).toFixed(4));
    }
    return out.length >= 3 ? out : null;
  })();
  const fullRange = pts.length >= 2 ? `${yy(pts[0].fy)}→${yy(pts[pts.length - 1].fy)}` : null;
  const label = gFull != null
    ? (fullRange ? `Owner-earnings growth · ${fullRange}` : "Owner-earnings growth, delivered")
    : recent != null ? `Owner-earnings growth · since FY${recent.fromFy}`
    : "Owner-earnings growth, delivered";
  const value = gFull != null ? gFmt(gFull) : recent != null ? gFmt(recent.g) : "—";
  // The single rate comparisons run against: the full-record read where it exists, else the
  // recent five-point window, else the turnaround run. One number per family, stated on the row.
  const gCmp = gFull ?? g5 ?? recent?.g ?? null;
  return { gCmp, wins, label, value, spark: sparkWin(pts.map((p) => p.v), 7, null) };
};
const famTotal = famOf(oeFcfPts);
// The maintenance family keeps the durability card's own figure where it exists (same
// 2-year-averaged-endpoint method; the two surfaces must never disagree), with the row's label
// and value as already assembled above.
const maintFullG = (() => {
  if (oeGrowth == null) return null;
  const p = parseFloat(String(oeGrowth).replace("−", "-")) / 100;
  return Number.isFinite(p) ? p : null;
})();
const famMaint = {
  gCmp: maintFullG ?? gDeliv5 ?? recentOe?.g ?? null,
  wins: oeWins,
  label: dLabel,
  value: dValue,
  spark: oeWin,
};
const name = co.name || co.ticker;
const pctS = (v, dp = 0) => (v == null ? "—" : `${v < 0 ? "−" : ""}${Math.abs(v * 100).toFixed(dp)}%`);
// The risk-free anchor for Graham's bond test, fetched on the daily refresh (public-domain
// government data), prefilled as an editable default and dated so it never reads as live.
// ONE risk-free yardstick for every market, the 10-year US Treasury: the reader's alternative
// to any equity here — US, Japanese, or European — is the same riskless bond, and a per-market
// anchor would make the same implied growth read differently across borders (arrangement is a
// pronouncement). The JGB anchor was considered and dropped for exactly that reason.
const bondDefault = rates?.tenYear != null ? rates.tenYear : null;
const bondName = "10-year Treasury";
// The required-return dial rests at 9% — the founder's call (2026-07-16), reverting the
// bond-snap rest the same day it shipped: resting on the bond alone made every price read
// soft, and 4.5% is no equity buyer's hurdle. The honesty the reform was after is carried
// instead by the decomposition line below the dial, which restates whatever the dial says as
// the dated Treasury plus an explicit premium — arithmetic in the open, never a laundered
// house number. The rename, the dated-bond reference, and the terminal-rest safeguard stay.
const rFloor = 4;
const rRest = 9;
// The terminal-growth rest sits at least a point below the required-return rest, by
// construction: a perpetuity growing at or above the discount rate has no finite value, so a
// resting state that collides would greet the first price typed with an error instead of an
// answer. Inert at the 9% rest; insurance against any future rest change resurrecting r = g.
const gTermRest = Math.min(2.5, Math.max(0, rRest - 1));
const bondRawAsOf = rates?.asOf;
const bondAsOf = bondRawAsOf ? new Date(bondRawAsOf).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }) : null;
---

<section class="val">
  <div class="head">
    <h3 class="secTitle">What the price implies</h3>
    <span class="tag">{bankRunnable ? "price / tangible book" : reitRunnable ? "price / FFO" : "reverse-DCF"}</span>
  </div>

  {adrAuto ? (
    <p class="adrWarn adrBasis">
      <b>Enter the US price, in dollars</b>: the NYSE/Nasdaq quote you hold.
      {adsBasis === "ads" ? (
        <> Per the filing's own cover, “{adsQuote}”; {name} reports in {homeCcy}, so every figure in
        this tool is stated per ADS{fxDisp ? <> and translated at {fxDisp} ({fxAsOfDisp}, reference rate)</> : null} so your
        dollar quote reconciles exactly.</>
      ) : (
        <> {name}'s US listing is the ordinary share itself{fxDisp ? <>; figures in this tool are translated
        at {fxDisp} ({fxAsOfDisp}, reference rate); the dollar quote then reconciles exactly</> : null}.</>
      )}
      {" "}The record tables elsewhere on this page remain as filed{homeCcy === "USD" ? "" : `, in ${homeCcy}`}.
    </p>
  ) : isADR ? (
    <p class="adrWarn">
      <b>Enter the home-market price, not the US ADR quote.</b> {name} reports in <b>{ccy}</b>,
      and every figure here (owner earnings, book value, the share count) is on that
      {ccy === "USD" ? " ordinary-share" : ` ${ccy}, ordinary-share`} basis. Enter the price on the
      same basis: the local-exchange quote per ordinary share{ccy === "USD" ? "" : ` in ${ccy}`}.
      {ccy === "GBP" ? " London quotes print in pence; 364.30p is £3.643. Enter pounds." : ""}
      A US ADR price in dollars bundles the ADR-to-ordinary ratio{ccy === "USD" ? "" : " and the exchange rate"},
      so it will not reconcile with these figures and would throw the multiple off.
    </p>
  ) : null}

  {offModel ? (
    reitRunnable ? (
      <div id="valBoxReit" data-ffops={ffops} data-dps={dpsReit ?? ""} data-name={name} data-ticker={co.ticker} data-sym={sym}>
        <p class="intro">A REIT is priced on a multiple of its <b>funds from operations</b> (FFO), the cash it earns once the depreciation on its buildings is added back. Type today&rsquo;s price; we show the multiple you would pay and the income and growth it implies.</p>
        <div class="priceRow">
          <label for="pxr">Today&rsquo;s price</label>
          <span class="dollar">{sym}</span>
          <input id="pxr" type="number" inputmode="decimal" step="0.01" min="0" placeholder="e.g. 55.00" />
        </div>
        <p class="pxMem" id="pxMemR" hidden></p>
        {/* Assumptions before the answer, in every mode alike (design doc §2: the four modes
            move together — divergent arrangement between modes would itself pronounce). */}
        <div class="dials">
          <span class="dialsLbl">The assumptions</span>
          <label>Required return <output id="rOutR">8%</output><input id="rR" type="range" min="5" max="12" step="0.5" value="8" /></label>
          <label>FFO / share growth <output id="gOutR">{reitGrowthPct}%</output><input id="gR" type="range" min="0" max="8" step="0.5" value={reitGrowthPct} /></label>
          <DeliveredGrowth cagr={ffoGrowthRaw} series={ffoWin} label="FFO / share, delivered" range={ffoRange} />
        </div>
        <p class="dialsNote">The justified multiple is 1 ÷ (required return − growth), a perpetuity on FFO. At an 8% required return and 3% growth, a REIT is worth about 20× FFO. </p>
        <p class="lede" id="ledeR">Enter a price above to run it.</p>
        <div class="compare">
          <div class="cmp"><span class="cl">Price / FFO</span><span class="cv hot" id="pffo">—</span></div>
          <div class="cmp"><span class="cl">Justified by growth</span><span class="cv" id="justpffo">—</span></div>
          <div class="cmp"><span class="cl">Dividend yield</span><span class="cv" id="dyR">—</span></div>
        </div>
        <NotebookCapture ticker={co.ticker} mode="reit" bondDefault={bondDefault} bondName={bondName} bondAsOf={bondAsOf} fy={co.fy} periodEnd={co.periodEnd} form={co.form} />
        <p class="foot">FFO about ${ffops.toFixed(2)} per share on {(shares / 1e6).toFixed(0)}M shares. The dials set the multiple they justify; your price sets the multiple you are paying. FFO here adds back depreciation and removes property-sale gains, the NAREIT method; it does not net out maintenance capex (AFFO), occupancy or lease terms, which the 10-K does.</p>
      </div>
    ) : bankRunnable ? (
      <div id="valBoxBank" data-tbvps={tbvps} data-bvps={bvpsB} data-rotce={rotceMed} data-eps={epsB ?? ""} data-name={name} data-ticker={co.ticker} data-cycle={isInsurer ? "underwriting cycle" : "credit cycle"} data-sym={sym}>
        <p class="intro">{isInsurer ? "An" : "A"} {finKind} is worth a multiple of its <b>tangible book value</b>, and the multiple it deserves is set by the return it earns on that book. Type today&rsquo;s price; we show what you would be paying against what {name}&rsquo;s record justifies.</p>
        <div class="priceRow">
          <label for="pxb">Today&rsquo;s price</label>
          <span class="dollar">{sym}</span>
          <input id="pxb" type="number" inputmode="decimal" step="0.01" min="0" placeholder="e.g. 250.00" />
        </div>
        <p class="pxMem" id="pxMemB" hidden></p>
        <div class="dials">
          <span class="dialsLbl">The assumptions</span>
          <label>Cost of equity <output id="coeOut">10%</output><input id="coeB" type="range" min="8" max="14" step="0.5" value="10" /></label>
          <label>Long-term growth <output id="gOutB">3%</output><input id="gB" type="range" min="0" max="6" step="0.5" value="3" /></label>
          <DeliveredGrowth cagr={tbvGrowthRaw} series={tbvWin} label="Tangible book / share, delivered" range={tbvRange} />
          <p class="dialsNote">The justified multiple is (return on tangible equity − growth) ÷ (cost of equity − growth). {isInsurer ? "An" : "A"} {finKind} earning exactly its cost of equity is worth about one times tangible book; the premium above that prices each point of durable excess return. A higher cost of equity lowers the justified multiple for {isInsurer ? "an" : "a"} {finKind}.</p>
        </div>
        <p class="lede" id="ledeB">Enter a price above to run it.</p>
        <div class="compare">
          <div class="cmp"><span class="cl">Price / tangible book</span><span class="cv hot" id="ptbv">—</span></div>
          <div class="cmp"><span class="cl">Justified by the return</span><span class="cv" id="justptbv">—</span></div>
          <div class="cmp"><span class="cl">Normalized return on tangible equity</span><span class="cv">{pctS(rotceMed)}</span></div>
        </div>        <div class="compare gate">
          <div class="cmp"><span class="cl">Price / book</span><span class="cv" id="pbBank">—</span></div>
          <div class="cmp"><span class="cl">Earnings yield</span><span class="cv" id="eyBank">—</span></div>
          <div class="cmp"><span class="cl">P/E ({epsBSpan ? `${niB3.length}-yr avg ${epsBSpan}` : "earnings"})</span><span class="cv" id="peBank">—</span></div>
          <div class="cmp"><span class="cl">Graham’s price gate</span><span class="cv" id="ggateBank">—</span></div>
        </div>
        <p class="gatenote">Graham applied the same standards to financial enterprises (Intelligent Investor ch.14): the 15× multiple cap on averaged earnings, and P/E times price-to-book at most 22.5. The gate marks the bargain-hunter&rsquo;s floor, not a verdict.</p>
        <NotebookCapture ticker={co.ticker} mode="bank" bondDefault={bondDefault} bondName={bondName} bondAsOf={bondAsOf} fy={co.fy} periodEnd={co.periodEnd} form={co.form} />
        <p class="foot">Tangible book {$(tEq)} on {(shares / 1e6).toFixed(0)}M shares, a {pctS(rotceMed)} normalized return on it. The dials set the multiple such a return would justify; your price sets the multiple you are paying. It assumes the {finKind} keeps earning that return; {bankRisk} changes it, which is what the record and the 10-K are for.</p>
      </div>
    ) : (
      <p class="note">A {sector.label.toLowerCase()} isn't read on an owner-earnings DCF; its economics live on the balance sheet (book value, the return earned on it, and the cash the assets throw off).</p>
    )
  ) : !runnable ? (
    negMode ? (
      <div id="valBoxNeg" data-rev={rev} data-shares={shares} data-netdebt={netDebt} data-name={name} data-ticker={co.ticker} data-oem={oeMarginNow ?? ""} data-profitable={profitableNeg ? "1" : "0"} data-sym={sym}>
        {profitableNeg ? (
          <p class="intro">{name} is <b>profitable</b>, but owner earnings are <b>negative</b> this year because capital spending currently outruns operating cash, a build-out, so the owner-earnings reverse-DCF has no positive base to grow. We read the price from both ends instead: type a price to see the steady-state profitability it <b>demands</b>, then set the mature margin you would <b>believe</b> and weigh the two against each other. Nothing leaves your browser unless you enter it in your notebook.</p>
        ) : (
          <p class="intro">Owner earnings are <b>negative</b> today, so the usual reverse-DCF has nothing to grow. That is exactly when a price makes its boldest promise, so we read it from both ends: type a price to see the future profitability it <b>demands</b>, then set the mature margin you would <b>believe</b> and weigh the two against each other. Nothing leaves your browser unless you enter it in your notebook.</p>
        )}
        <div class="priceRow">
          <label for="pxn">Today&rsquo;s price</label>
          <span class="dollar">{sym}</span>
          <input id="pxn" type="number" inputmode="decimal" step="0.01" min="0" placeholder="e.g. 30.00" />
        </div>
        <p class="pxMem" id="pxMemN" hidden></p>
        <div class="dials">
          <span class="dialsLbl">The assumptions</span>
          <label>Required return <output id="rOutN">9%</output><input id="rN" type="range" min="4" max="15" step="0.5" value="9" /></label>
          <label>Years to get there <output id="nOutN">10</output><input id="nN" type="range" min="5" max="15" step="1" value="10" /></label>
          <label>Revenue growth <output id="grOutN">{gRevPct}%</output><input id="grN" type="range" min="0" max="45" step="5" value={gRevPct} /></label>
          <DeliveredGrowth cagr={gRevRaw} series={revWin} label="Revenue, delivered" range={revRange} />
          <label>Mature owner-earnings margin <output id="mmOutN">15%</output><input id="mmN" type="range" min="3" max="40" step="1" value="15" /></label>
        </div>
        <p class="lede" id="ledeN">Enter a price to run it.</p>
        <div class="compare">
          <div class="cmp"><span class="cl">Owner earnings it must reach</span><span class="cv hot" id="reqOE">—</span></div>
          <div class="cmp"><span class="cl">Margin the price demands</span><span class="cv hot" id="reqM">—</span></div>
          <div class="cmp"><span class="cl">Owner-earnings margin today</span><span class="cv neg">{pctS(oeMarginNow)}</span></div>
        </div>
        <NotebookCapture ticker={co.ticker} mode="neg" bondDefault={bondDefault} bondName={bondName} bondAsOf={bondAsOf} fy={co.fy} periodEnd={co.periodEnd} form={co.form} />
        <p class="foot">Two reads of one future. From your price: the owner earnings the company must reach, valued at a mature multiple and discounted back at your rate, expressed as the margin it implies on revenue grown at your rate. From your belief: the mature margin you would credit, set on the dial above. When the margin the price demands runs above the one you would believe, you are paying for a future taken on faith. For a deep cyclical at a trough, normalized through-cycle earnings are the better lens; this mode is for the genuinely unprofitable, and for the profitable business whose capital spending currently outruns its cash.</p>
      </div>
    ) : (
      <p class="note">A reverse-DCF needs positive owner earnings, or at least revenue, to anchor to, there's no clean base here. Judge this one on assets or normalized earnings, not a growth model.</p>
    )
  ) : (
    <div id="valBox" data-oe={ownerEarnings} data-oe3={oeNormalized ?? ""} data-oemaint={ownerEarningsMaint ?? ""} data-oemaint3={oe3Maint ?? ""} data-sbc={sbcLatest ?? ""} data-gdeliv-total={famTotal.gCmp ?? ""} data-gdeliv-maint={famMaint.gCmp ?? ""} data-netdebt={netDebt} data-balanceok={balanceOk ? "1" : "0"} data-shares={shares} data-haveshares={haveShares ? "1" : "0"} data-name={name} data-ticker={co.ticker} data-eps3={eps3 ?? ""} data-bvps={bvps ?? ""} data-rev={rev ?? ""} data-grev={gRevRaw ?? ""} data-ni={niNow ?? ""} data-sym={sym} data-bonddefault={bondDefault ?? ""} data-bondname={bondName} data-bondasof={bondAsOf ?? ""} data-oewins-total={famTotal.wins ? JSON.stringify(famTotal.wins) : ""} data-oewins-maint={famMaint.wins ? JSON.stringify(famMaint.wins) : ""}>
      <p class="intro">
        Type today's close and see the
        owner-earnings growth you'd have to believe to justify it, beside what {name} has delivered.
      </p>

      {/* The banner states WHY the base opens normalized, and the reason must match the record:
          a build-out (negative latest on total capex), a trough (negative latest), or a PEAK
          (latest margin above the through-cycle median — §1.2's symmetric default). The peak
          branch was missing when §1.2 shipped, so peak-defaulted pages (Netflix) falsely
          claimed negative owner earnings — the founder's catch, 2026-07-17. */}
      {(defaultMaint || defaultNorm) ? (
        <p class="basenote">
          {defaultMaint ? (
            <>{name}&rsquo;s latest year shows <b>negative owner earnings</b>, the mark of a build-out: total capital spending outruns the cash the business throws off today. So the tool opens on the steady-state base (maintenance capex in place of the build-out spend), the cash it would earn at rest; clear the toggle below to read the latest year exactly as reported.</>
          ) : ownerEarnings != null && ownerEarnings < 0 ? (
            <>{name}&rsquo;s latest year shows <b>negative owner earnings</b>, a cyclical trough. So the tool opens on the through-cycle base, the cash it would earn at rest; clear the toggle below to read the latest year exactly as reported.</>
          ) : (
            <>{name}&rsquo;s latest year runs <b>above its own through-cycle margin</b> — the reported figure may flatter a peak. So the tool opens on the through-cycle base, Graham&rsquo;s averaging cutting both ways; clear the toggle below to read the latest year exactly as reported.</>
          )}
        </p>
      ) : null}

      <div class="priceRow">
        <label for="px">Today&rsquo;s price</label>
        <span class="dollar">{sym}</span>
        <input id="px" type="number" inputmode="decimal" step="0.01" min="0" placeholder="e.g. 220.50" />
      </div>
      <p class="pxMem" id="pxMem" hidden></p>

      {!haveShares ? (
        <div class="priceRow shRow">
          <label for="shInput">Shares outstanding</label>
          <input id="shInput" type="number" inputmode="decimal" step="0.1" min="0" placeholder="e.g. 87.5" />
          <span class="unit">million</span>
          <span class="shWhy">The share count isn&rsquo;t tagged in a form this tool can read; enter it too (any quote page lists it). The rest is from the record.</span>
        </div>
      ) : null}

      {cycleRead ? (
        <p class="cyclenote">
          Through the cycle, {name} earns about <b>{$(ep.normOE)}</b> on its {pctS(ep.normOeMargin, 1)} median
          owner-earnings margin. This year&rsquo;s {pctS(ep.latestOeMargin, 1)} margin runs <b>{cycleRead === "at" ? "in line with" : cycleRead}</b> that{cycleRead === "above" ? "; the reported figure may flatter a peak you'd be paying on" : cycleRead === "below" ? "; the reported figure may understate a lean year" : ""}. <b>Normalize</b>, below, values the price on that through-cycle figure rather than the latest year.{cycleRead === "above" && defaultNorm ? " It comes pre-checked here for that reason, the same rule that already normalizes a trough; clear it to price the year as filed." : ""}
        </p>
      ) : null}

      <div class="bases" role="group" aria-label="Adjust the owner-earnings base">
        <span class="basesLbl">Base</span>
        <label class="tog"><input type="checkbox" id="oeNorm" checked={defaultNorm} /> Normalize · through-cycle{oeNormalized != null ? <> (<b>{$(oeNormalized)}</b>)</> : null}</label>
        <label class="tog"><input type="checkbox" id="oeSbc" /> Net of stock comp{sbcLatest > 0 ? <> (−<b>{$(sbcLatest)}</b>)</> : null}</label>
        {offerMaint ? <label class="tog"><input type="checkbox" id="oeMaint" checked={defaultMaint} /> Steady-state · maintenance capex{ownerEarningsMaint != null ? <> (<b>{$(ownerEarningsMaint)}</b>)</> : null}</label> : null}
      </div>
      <p class="baseUsed" id="baseUsed" aria-live="polite">—</p>

      {/* The balance-sheet toggle (owner directive): shown only when the net cash or net debt
          position is material against the price actually typed — Graham's arithmetic that a
          buyer gets the cash and assumes the debt. One switch, symmetric by construction:
          crediting cash and charging debt are the same lens, never a flattering-only one. */}
      <label class="tog evTog" id="evTog" hidden><input type="checkbox" id="evOn" /> <span id="evLbl">Count the balance sheet</span></label>
      <p class="gatenote evNote" id="evNote" hidden></p>

      {/* The declaration cluster, completed: your price, your base (the toggles above), your
          required return, your horizon — everything the reader asserts, stated before anything
          is answered. Dials-last was inherited layout, never a ratified decision; the other
          three modes moved with it (§2: the four modes move together, because divergent
          arrangement between modes would itself pronounce). The dials-above-everything version was
          rejected (the page's identity is price in, implied assumptions out), but assumptions
          BESIDE the price is Graham's own discipline: write it down before you watch the tape. */}
      <div class="dials">
        <span class="dialsLbl">The assumptions</span>
        <label>Required return <output id="rOut">{rRest}%</output><input id="r" type="range" min={rFloor} max="15" step="0.5" value={rRest} /></label>
        <label>Years of high growth <output id="nOut">10</output><input id="n" type="range" min="5" max="15" step="1" value="10" /></label>
        <label>Terminal growth <output id="gOut">{gTermRest}%</output><input id="g" type="range" min="0" max="4" step="0.25" value={gTermRest} /></label>
        <p class="dialsNote" id="rDecomp">{bondDefault != null ? <>{rRest.toFixed(1)}% = the {bondDefault}% {bondName}{bondAsOf ? ` (${bondAsOf})` : ""}{rRest >= bondDefault ? ` + ${(rRest - bondDefault).toFixed(2)} points of equity premium` : ` − ${(bondDefault - rRest).toFixed(2)} points below the bond`}. The rate you require is yours to set.</> : <>The required return is anchored to the long government-bond yield, plus the premium you demand for risk.</>}</p>
      </div>

      <p class="lede" id="lede">Enter a price above to run it.</p>
      <p class="gatenote baseRates" id="baseRates" hidden></p>
      <NotebookCapture ticker={co.ticker} mode="main" bondDefault={bondDefault} bondName={bondName} bondAsOf={bondAsOf} fy={co.fy} periodEnd={co.periodEnd} form={co.form} />

      <div class="compare">
        <div class="cmp"><span class="cl">Implied by the price</span><span class="cv hot" id="impG">—</span></div>
        {gDeliv5 != null ? <div class="cmp"><span class="cl">Owner-earnings growth · {range5 ?? "5 yr"}</span><span class="cv">{gFmt(gDeliv5)}</span></div> : null}
        {/* The delivered row, once per capex family: the Steady-state toggle decides which one
            shows, so the label, the rate, and the sparkline always share the base's own capex
            treatment — never a maintenance-based number beside a free-cash-flow base. */}
        <div class="cmp famRow" data-fam="total" hidden={defaultMaint}><span class="cl">{famTotal.label}</span><span class="cv">{famTotal.value}</span>{famTotal.spark ? <Sparkline series={famTotal.spark} klass="cmpSpark" /> : null}</div>
        <div class="cmp famRow" data-fam="maint" hidden={!defaultMaint}><span class="cl">{famMaint.label}</span><span class="cv">{famMaint.value}</span>{famMaint.spark ? <Sparkline series={famMaint.spark} klass="cmpSpark" /> : null}</div>
        {/* "Multiple paid" removed: the exact reciprocal of the owner-earnings yield two cells
            away, and the multiple survives in the schedule-location prose and the ops line —
            each redundant readout dilutes the one comparison that carries the tool. Its slot
            goes to Graham's ch.20 accumulated-spread arithmetic, in the bond yardstick below. */}
        <div class="cmp"><span class="cl">Owner-earnings yield</span><span class="cv" id="oeY">—</span></div>
      </div>

      <div class="ops" id="ops" hidden>
        <p class="opsMc" id="opsMc"></p>
        <p class="impOps" id="impOps" hidden></p>
        <div class="marginRow" id="marginRow" hidden>
          <label>If the owner-earnings margin matured to <output id="mmOut">25%</output><input id="mmDial" type="range" min="3" max="50" step="1" value="25" aria-label="Mature owner-earnings margin" /></label>
        </div>
        <p class="reqRev" id="reqRev" hidden></p>
      </div>

      <p class="gatenote cushion" id="cushionLine" hidden></p>

      <div class="sens" id="sens" hidden>
        <span class="sensLbl">What a growth belief costs, in multiples</span>
        <div class="sensWrap"><table class="sensTbl" id="sensTbl" aria-label="Owner-earnings multiple a growth belief justifies, by required return"></table></div>
        <p class="sensLoc" id="sensLoc" hidden></p>
        <p class="sensNote" id="sensNote"></p>
      </div>

      <div class="ladder" id="ladder" hidden>
        <span class="sensLbl">The growth each return requires, at your price</span>
        <div class="sensWrap"><table class="sensTbl" id="ladderTbl" aria-label="Owner-earnings growth the typed price implies, by required return"></table></div>
        <p class="sensNote" id="ladderNote"></p>
      </div>

      {eps3 != null && bvps != null ? (
        <>
          <div class="compare gate">
            <div class="cmp"><span class="cl">P/E ({niH3.length}-yr earnings{eps3Span ? ` ${eps3Span}` : ""})</span><span class="cv" id="pe">—</span></div>
            <div class="cmp"><span class="cl">P/B</span><span class="cv" id="pb">—</span></div>
            <div class="cmp"><span class="cl">Graham’s price gate</span><span class="cv" id="ggate">—</span></div>
          </div>
          <p class="gatenote">Graham capped the multiple at 15×; Buffett and Munger let that rule go: a wonderful business can deserve 50× if the thesis holds. The gate marks the bargain-hunter's floor.</p>
        </>
      ) : null}

      <div class="bondBox">
        <div class="bondHead">
          <span class="bondTitle">Against a high-grade bond: Graham’s yardstick</span>
          <span class="bondField"><span class="bondLbl">bond yield</span><input id="bondY" type="number" inputmode="decimal" step="0.1" min="0" placeholder="e.g. 4.5" aria-label="High-grade bond yield, percent" /><span class="bondPct">%</span></span>
        </div>
        {bondAsOf ? <p class="bondAsOf">Prefilled with the {bondName} ({bondDefault}%, as of {bondAsOf}). Edit it for today’s exact figure, or a AAA corporate yield.</p> : null}
        <p class="bondLede" id="bondLede">Graham measured a stock against the bond you could own instead, the heart of his margin of safety. Enter a price above to weigh the owner-earnings yield against this bond.</p>
        <div class="compare bondCmp" id="bondCmp" hidden>
          <div class="cmp"><span class="cl">Owner-earnings yield</span><span class="cv hot" id="eyB">—</span></div>
          <div class="cmp"><span class="cl">High-grade bond yield</span><span class="cv" id="bondYOut">—</span></div>
          <div class="cmp"><span class="cl">Margin over the bond</span><span class="cv" id="spreadB">—</span></div>
        </div>
        <p class="gatenote" id="accSpread"></p>
      </div>

      <p class="foot">
        {offerMaint ? "Free cash flow" : "Owner earnings"} {$(ownerEarnings)} {haveShares
          ? (sfv
            ? `on ${(shares / 1e6).toFixed(0)}M shares outstanding${
                sfv.basis === "cover" ? `, per the ${sfv.form || "filing"} cover, as of ${sfv.asOf}`
                : sfv.basis === "instant" ? `, the balance-sheet count at ${sfv.asOf}`
                : ` (a weighted ${sfv.basis}, the only count this filer tags)`}`
            : `on ${(shares / 1e6).toFixed(0)}M diluted shares`)
          : "on the share count you enter above"}; net {netDebt >= 0 ? `debt ${$(netDebt)}` : `cash ${$(-netDebt)}`}.{overhangPct != null ? ` The if-converted diluted count is ${(dilutedCount / 1e6).toFixed(0)}M, ${overhangPct}% above the shares outstanding: the dilution overhang (convertibles, options) a buyer inherits.` : ""}
        {defaultNorm ? <>The base opens on the through-cycle figure (the latest year sits {cycleRead === "above" ? "above" : "off"} the record&rsquo;s own median, and Graham&rsquo;s averaging cuts both ways); clear <b>Normalize</b> to use the year as filed.</> : defaultMaint ? <>The base opens on the steady-state figure (the latest year is negative on total capex mid-build-out); clear <b>Steady-state</b> to use the year as filed.</> : <>The base is the latest year by default; <b>Normalize</b> values it on the through-cycle median owner-earnings margin (to avoid paying on a peak year).</>} <b>Net of stock comp</b> treats option pay as the expense it is.{offerMaint ? (<> Capex ({$(Math.abs(capex))}) runs well above depreciation ({$(dep)}), so this is a build-out; <b>Steady-state</b> swaps total capex for maintenance (≈ depreciation), lifting the base to about {$(ownerEarningsMaint)}, the cash it would throw off if it stopped expanding.</>) : null}
        The dials set the multiple a growth belief justifies; the price, and every dollar on this page, is yours.
      </p>
    </div>
  )}
  <NotebookStrip ticker={co.ticker} />
</section>

<style>
  .val { margin: 24px 0; }
  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; border-bottom: 1px solid var(--rule-strong); padding-bottom: 6px; }
