---
// "The year, in the company's words" — the MD&A sentences where the company explains the
// year's moves, verbatim, each one anchored to a record line or reportable segment and checked
// against the same filing's XBRL figures before it is allowed here (see scripts/fetchDrivers.mjs).
// We add the arithmetic; the company supplies every word. A company with nothing verified shows
// nothing: silence over filler.
import driversData from "../data/drivers.json";
const { company } = Astro.props;
const D = driversData?.companies?.[String(company?.ticker || "").toUpperCase()] || null;

const rows = D
  ? [
      ...(D.consolidated || []).map((x) => ({ chip: x.label, key: x.key, pct: x.pct, sentence: x.sentence, check: x.check })),
      ...(D.segments || []).map((x) => ({ chip: x.segment, pct: x.pct, sentence: x.sentence, check: x.check, metric: x.metric })),
    ]
  : [];

// A provision is a reserve line, not a result: a rise can be prudence and a fall a release, and
// coloring either as good or bad would be a verdict (the record table's provision row is neutral
// for the same reason). And past ~1000% the base is a sliver — a −$46k prior-year credit printed
// +9,745.7% — so the ratio carries nothing beyond "≈ divide by zero"; the tied sentence still
// shows, the chip just declines to dress noise as a figure (the record's own n/m law).
const neutralChip = (r) => r.key === "provisionForCreditLosses";
const fmtPct = (p) => (Math.abs(p) > 1000 ? "n/m" : `${p > 0 ? "+" : ""}${p.toFixed(1)}%`);
const checkNote = (c) =>
  c === "pct" || c === "dollar"
    ? "figure matches the filed record"
    : "direction matches the filed record";
const mdnaUrl = D?.sourceUrl || null;
---

{rows.length ? (
  <section class="drivers">
    <div class="head">
      <h3 class="secTitle">The year, in the company's words</h3>
      {mdnaUrl ? <a class="src" href={mdnaUrl} target="_blank" rel="noopener">the filing →</a> : null}
    </div>
    <p class="lede">
      Verbatim from the 10-K's management discussion. Each sentence is shown only because its
      subject, direction{rows.some((r) => r.check !== "direction") ? ", and stated figures" : ""} check
      out against the filed numbers on this page. The words are the company's; the arithmetic is the record's.
    </p>
    <ul class="list">
      {rows.map((r) => (
        <li class="row">
          <span class="chip">
            <span class="chipName">{r.chip}</span>
            <span class={`chipPct ${neutralChip(r) || Math.abs(r.pct) > 1000 ? "flat" : r.pct < 0 ? "neg" : "pos"}`}>{fmtPct(r.pct)}</span>
            {r.metric === "operatingIncome" ? <span class="chipMetric">op. income</span> : null}
          </span>
          <blockquote class="q">“{r.sentence}”</blockquote>
          <span class="check">✓ {checkNote(r.check)}</span>
        </li>
      ))}
    </ul>
  </section>
) : null}

<style>
  .drivers { margin: 26px 0 0; }
  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .src { font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; flex: 0 0 auto; }
  .lede { font-family: var(--serif); font-style: italic; font-size: 13.5px; color: var(--muted); margin: 8px 0 0; max-width: 70ch; line-height: 1.5; }
  .list { list-style: none; margin: 14px 0 0; padding: 0; }
  .row { padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .chip { display: inline-flex; align-items: baseline; gap: 8px; }
  .chipName { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); }
  .chipPct { font-family: var(--sans); font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .chipPct.pos { color: var(--good); }
  .chipPct.neg { color: var(--bad); }
  .chipPct.flat { color: var(--muted); }
  .chipMetric { font-family: var(--sans); font-size: 10.5px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .q { font-family: var(--serif); font-size: 15px; line-height: 1.55; color: var(--ink-soft); margin: 6px 0 4px; padding: 0 0 0 14px; border-left: 2px solid var(--rule-strong); max-width: 78ch; }
  .check { font-family: var(--sans); font-size: 11px; letter-spacing: 0.03em; color: var(--muted); }
</style>
