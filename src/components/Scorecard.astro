  /* The cockroach banner: a material weakness / restatement is a disclosed FACT, elevated so it can't
     be missed, but restrained — a border and a colored label, not a shouting box. Present, never pronounce. */
  .cockroach { border: 1px solid var(--warn); border-left-width: 3px; padding: 11px 14px; margin: 14px 0 0; }
  .cockroach .ck { margin: 0 0 7px; }
