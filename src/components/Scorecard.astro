  .ckNote { font-size: 12.5px; color: var(--ink-dim); margin: 6px 0 0; line-height: 1.5; max-width: 78ch; }
  .ckNote a { color: var(--accent); white-space: nowrap; }

  .section { margin-top: 18px; }
  /* The subhead idiom. */
  .secHead {
    font-family: var(--sans); font-weight: 600;
    margin: 0; font-size: 11.5px; letter-spacing: 0.09em; text-transform: uppercase;
