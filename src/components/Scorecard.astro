---
import fundamentals from "../data/fundamentals.json";
import { buildScorecard, TONE_COLOR, roicValue, ownerEarningsMargin, operatingMargin, earningsQuality, earningsQualityReconciliation, forensicScreen } from "../lib/fundamentals.mjs";
import { selectPeers, peerMedian } from "../lib/peers.mjs";
import { buildFinancialScorecard, returnOnEquity, returnOnTangibleEquity, efficiencyRatio } from "../lib/financials.mjs";
import { buildReitScorecard, cashPayout, debtToAssets, ebitdaCoverage } from "../lib/reits.mjs";
import { buildInsurerScorecard, combinedRatio } from "../lib/insurers.mjs";
import { buildFeeScorecard } from "../lib/feeFinancials.mjs";
import { buildManagedCareScorecard, medicalLossRatio, mlrTrendTie } from "../lib/managedCare.mjs";
import { buildUtilityScorecard } from "../lib/utilities.mjs";
import { moatReport } from "../lib/durability.mjs";
import { grahamTests } from "../lib/graham.mjs";
import { financialKind, financialSubtype } from "../lib/archetype.mjs";
import language from "../data/language.json";
import Term from "./Term.astro";

const { company, sample = false, peers: peersProp } = Astro.props;
// Graham's defensive tests live inside the scorecard, so "is it safe" reads in one place
// instead of split across a separate section. Run for the US pool and the ADRs, but not the
// Japanese pool or the financials (the tests are industrial-shaped — a current-ratio and
// working-capital frame the banks/insurers/REITs don't fit). The one dollar-denominated test,
// the $2B size floor, shows the figure but withholds a verdict for a non-dollar filer rather
// than fake an exchange rate (see graham.mjs); the rest are ratios that read in any currency.
const GTONE = { pass: "good", near: "warn", fail: "bad", na: "none" };
const GLABEL = { pass: "Pass", near: "Near", fail: "Miss", na: "—" };
// Each financial kind is read on different statements, so each gets its own scorecard
// and skips the ROIC-based durability block, which applies to none of them: a lender on
// return on equity and credit cost, an insurer on the combined ratio and float, a REIT
// on the cash its properties produce, an asset manager or exchange on fee margins, a health plan on its medical loss
// ratio.
const fk = financialKind(company);
const isFin = !!fk;
// A rate-regulated utility (the pipeline's own gate, never SIC alone) is read on the regulated
// questions — the earned return against the allowed one, the growing invested base, the AFUDC
// credit, the regulatory ledger — instead of the industrial quality checks a commission-capped
// return would flunk by design. Graham's tests still run below: his 1972 utility substitution
// lives inside grahamTests itself.
const { sections } =
  fk === "reit" ? buildReitScorecard(company)
  : fk === "insurer" ? buildInsurerScorecard(company, financialSubtype(company))
  : fk === "managedCare" ? buildManagedCareScorecard(company)
  : fk === "fee" ? buildFeeScorecard(company, financialSubtype(company))
  : fk === "bank" ? buildFinancialScorecard(company, financialSubtype(company))
  : company.rateRegulated ? buildUtilityScorecard(company)
  : buildScorecard(company);
// The filing's own pricing words, threaded into the moat report so the margin/pricing-power line
// reads the number and the company's language together. Withheld for financials (where "pricing
// power" and "input costs" are the wrong lens) — and moatReport runs for non-financials only anyway.
const pricingLang = isFin ? null : (language?.companies?.[company.ticker]?.buffettRead?.pricing || null);
// The candor register (owner vs promoter vocabulary), threaded into the moat report's closing read so
// "how management talks" is reconciled with whether the business is actually compounding.
const candorLang = isFin ? null : (language?.companies?.[company.ticker]?.mdna?.candor || null);
const report = isFin ? null : moatReport(company, { pricing: pricingLang, candor: candorLang });
// The cockroach: the single most disconfirming fact a filing can carry — a declared material weakness
// in internal controls, or a restatement of past figures. Elevated to a prominent banner at the top of
// the Scorecard (Graham's honesty test comes before any ratio) rather than buried in the earnings-
// quality note. Verbatim, with a pointer to verify; present, never pronounce.
const cockroach = language?.companies?.[company.ticker]?.buffettRead?.integrity || null;
// The reserve-development sentence (qualitative survey Build 4): management's own narration of
// prior-year development, welded at extraction time to the same filed number the insurer /
// managed-care "Reserve development" check shows. Rendered only while the filed number still
// equals the one the sentence was welded to — if the quant desk heals or restates the line, the
// quote retires rather than sit beside a number it no longer ties. A conflict record (the
// narrative and the filed number disagree on direction) renders as a stated withhold that
// quotes neither as the fact.
const devRead = (fk === "insurer" || fk === "managedCare") ? (language?.companies?.[company.ticker]?.reserveDevelopment || null) : null;
const devTie = devRead && String(devRead.fy) === String(company.fy) && company?.lines?.reserveDevelopmentPriorYear === devRead.stored
  ? devRead : null;
// The software NRR + customer-ladder read (qualitative survey Build 7): the filer's own
// retention and customer-count sentences, every rendered figure a verbatim substring of the
// quoted sentence — asserted at extraction time and RE-CHECKED here, so a record that drifts
// from its quote retires rather than render. fy-gated like the Build 4 weld: a stale record
// never sits beside a newer scorecard year. Rendered beside the RPO band check because
// retention answers the same question, read through the customers' own behavior.
const swReadRaw = !isFin ? (language?.companies?.[company.ticker]?.softwareRead || null) : null;
const swRead = (() => {
  if (!swReadRaw || String(swReadRaw.fy) !== String(company.fy)) return null;
  const nrr = (swReadRaw.nrr || []).filter((r) => r.sentence && r.figure && r.sentence.includes(r.figure));
  const ladder = (swReadRaw.ladder || []).filter((r) => r.sentence && r.count && r.sentence.includes(r.count) && (!r.threshold || r.sentence.includes(r.threshold)));
  const withheld = swReadRaw.withheld || [];
  const tripwire = (swReadRaw.tripwire || []).filter((t) => t.current && t.prior);
  if (!nrr.length && !ladder.length && !withheld.length && !tripwire.length) return null;
  return { nrr, ladder, withheld, tripwire };
})();
// The reserve-block provenance line (qualitative survey Build 8, O&G): who stands behind the
// proved-reserve figures the section below reads — the Item 1202 attribution in the filer's
// own words. Verb fidelity is absolute: the verb shown is the filer's own token from the
// quoted sentence ("reviewed" is never rendered as "audited"), and any coverage share is the
// sentence's own percent with its verbatim object phrase. All three are welded at extraction
// and RE-CHECKED here as substrings of the stored sentence; the fiscal year must tie the
// scorecard's, so a stale attribution never sits under a fresher record. Internal-only filers
// (Exxon's class) render their own internal-process sentence; a dictionary miss renders nothing.
const OG_HEADING = "The reserves, and what it costs to keep them";
const ogProv = (() => {
  const a = language?.companies?.[company.ticker]?.reserveAttribution || null;
  if (!a || String(a.fy) !== String(company.fy)) return null;
  if (a.internal) return a.sentence ? { internal: true, sentence: a.sentence } : null;
  const firms = (a.firms || []).filter((f) =>
    f.sentence && f.verb && f.sentence.includes(f.verb) &&
    (!f.coverage || f.sentence.includes(`${f.coverage.pct} ${f.coverage.object}`)));
  return firms.length ? { firms } : null;
})();
// The REIT re-leasing spreads + occupancy read (qualitative survey Build 9): the landlord's
// own pricing sentence — rent spreads, rent change, rent recapture — and the dated occupancy
// sentence(s), every rendered figure a verbatim substring of its quoted sentence, asserted at
// extraction time and RE-CHECKED here so a record that drifts from its quote retires rather
// than render. The one computed value, the recapture tie, re-checks both of its dollar
// halves as the sentence's own characters. fy-gated like every weld: a stale read never sits
// beside a newer scorecard year. The spread block is the sector's pricing surface (the
// generic pricing facet is withheld for SIC 6798 by the financials gate), rendered on the
// yield-on-cost check; occupancy renders beside the cash-payout check it physically drives.
const reitReadRaw = fk === "reit" ? (language?.companies?.[company.ticker]?.reitLeasing || null) : null;
const reitRead = (() => {
  if (!reitReadRaw || String(reitReadRaw.fy) !== String(company.fy)) return null;
  const sub = (r) => r.sentence && (r.figures || []).every((f) => r.sentence.includes(f));
  const spreads = (reitReadRaw.spreads || []).filter((r) => sub(r) && (!r.tie || (r.sentence.includes(r.tie.a) && r.sentence.includes(r.tie.b))));
  const occupancy = (reitReadRaw.occupancy || []).filter(sub);
  const spreadsWithheld = reitReadRaw.spreadsWithheld || [];
  const occupancyWithheld = reitReadRaw.occupancyWithheld || [];
  if (!spreads.length && !occupancy.length && !spreadsWithheld.length && !occupancyWithheld.length) return null;
  return { spreads, occupancy, spreadsWithheld, occupancyWithheld, asOf: reitReadRaw.asOf || null };
})();
// The managed-care MLR cost-trend read (qualitative survey Build 11): the filer's own
// cost-trend sentence, tiered at extraction against the desk's computed medical loss ratio
// and RE-VERIFIED here by mlrTrendTie — the fiscal year must tie, the recomputed ratio must
// still equal the one the sentence was tiered against, every stated figure must still be the
// sentence's own characters, and a level badge must still match at the sentence's declared
// precision; a record that drifts retires rather than render. This is the sector's pricing
// surface (the generic pricing facet is withheld for SIC 6324 by the financials wall — the
// managed-care desk's stand-in, the Build 9 REIT precedent), rendered on the medical-loss-
// ratio check the tier was computed against.
const mcMlr = fk === "managedCare"
  ? mlrTrendTie(company, language?.companies?.[company.ticker]?.mlrTrend || null)
  : null;
const toneWord = (t) => (t === "favorable" ? "favorable" : "unfavorable");
const ckTrim = (s) => { s = String(s || "").replace(/\s+/g, " ").trim(); return s.length > 260 ? s.slice(0, 260).replace(/\s+\S*$/, "") + "…" : s; };
const graham = company.market !== "JP" && !isFin ? grahamTests(company) : null;

// Peer context on the two quality reads that are otherwise judged against an absolute band: a number
// means something only beside its peers — 18% ROIC is wonderful for a grocer and ordinary for software.
// The same economic-engine peers the table below uses, each read through its own cycle, so the median is
// the line this company's figure is set against. Factual context, never a verdict; shown only when the
// industry has enough peers carrying the metric (peerMedian withholds otherwise). Every archetype is read
// on its own measures — the operator on ROIC and owner earnings, a bank on ROE/ROTCE/efficiency, a REIT on
// payout, leverage and coverage against its property subsector.
const peerCtx = (() => {
  const peers = peersProp || selectPeers(company, fundamentals.companies || []).peers;
  const ctx = {};
  // Add peer context to a check by its title: the median of the metric across the same-engine peers,
  // each read through its own cycle. Withheld (no line) when too few peers carry it. Most metrics are
  // percentages; an optional formatter handles the few that aren't (interest coverage, a multiple).
  const pctFmt = (m) => `${(m * 100).toFixed(0)}%`;
  const add = (title, fn, fmt = pctFmt) => { const m = peerMedian(peers, fn); if (m != null) ctx[title] = `Industry peers: median ${fmt(m)}`; };
  if (!isFin) {
    add("Return on invested capital", (L) => roicValue(L));
    add("Owner-earnings margin", (L, c) => ownerEarningsMargin(L, c));
  } else if (fk === "reit") {
    // A REIT's peers are now its property subsector (net-lease beside net-lease), so the payout,
    // leverage and coverage read against a like property model — not a grab-bag of "real estate".
    // FFO-per-share stays off the peer line (it's a per-share figure, not a comparable ratio).
    add("Dividend / operating cash", (L) => cashPayout(L));
    add("Debt / assets", (L) => debtToAssets(L));
    add("Interest coverage (EBITDA)", (L) => ebitdaCoverage(L), (m) => `${m.toFixed(1)}×`);
  } else if (fk === "bank") {
    add("Return on equity", (L) => returnOnEquity(L));
    add("Return on tangible equity", (L) => returnOnTangibleEquity(L));
    add("Efficiency ratio", (L) => efficiencyRatio(L));
  } else if (fk === "insurer") {
    add("Return on equity", (L) => returnOnEquity(L));
    add("Combined ratio", (L) => combinedRatio(L));
  } else if (fk === "managedCare") {
    add("Return on equity", (L) => returnOnEquity(L));
    add("Operating margin", (L) => operatingMargin(L));
    add("Medical loss ratio", (L) => medicalLossRatio(L));
  } else if (fk === "fee") {
    add("Operating margin", (L) => operatingMargin(L));
    add("Return on equity", (L) => returnOnEquity(L));
  }
  return ctx;
})();

// The earnings-reliability tie: the filing's own language about whether the numbers can be trusted,
// brought to the judgment it bears on. Integrity admissions — a material weakness in financial
// controls, a restatement of past figures — are Graham's honesty test, the question that comes
// before any ratio. For an operator we also read heavy "look past GAAP" steering against whether
// cash actually backs the GAAP profit; for a financial, read on a balance sheet rather than a
// cash-conversion ratio, only the integrity admission speaks. Present, never pronounce.
const eqTie = (() => {
  const lc = language?.companies?.[company.ticker] || null;
  const integ = lc?.buffettRead?.integrity || null;
  if (isFin) {
    // A bank, insurer or REIT is read on the soundness of its balance sheet, so a deficient control
    // system or a restatement undercuts the whole read. The non-GAAP/cash-conversion lens is the
    // wrong one here (a financial's "adjusted" is a different animal; pricing/cost language is
    // withheld for them too), so we pass no adjusted density and let only the integrity branch speak.
    if (!integ) return null;
    return earningsQualityReconciliation("none", { adjusted: null, materialWeakness: !!integ.materialWeakness, restatement: !!integ.restatement });
  }
  const adjusted = lc?.mdna?.candor?.adjusted ?? null;
  if (!integ && adjusted == null) return null;
  const q = earningsQuality(company);
  return earningsQualityReconciliation(q?.tone || "none", {
    adjusted,
    materialWeakness: !!integ?.materialWeakness,
    restatement: !!integ?.restatement,
  }, forensicScreen(company));
})();

// Where the tie attaches: the cash-backing check for an operator, and — for a financial, which has
// no such check — the first, most prominent check of its scorecard (ROE, the combined ratio, FFO),
// because the soundness of the numbers is the question that comes before the ratio. Matched by object
// identity, so the anchor is unambiguous whatever its title.
const eqAnchor = isFin
  ? (sections[0]?.checks?.[0] || null)
  : sections.flatMap((s) => s.checks).find((c) => c.title === "Are earnings backed by cash?") || null;

// Where the software read attaches: the RPO band check (the desk's "how much of next year is
// already sold"), falling back to the first check of the software section when a filer tags
// no RPO band — the survey placed the lane beside the RPO bands, and this is that slot.
const swAnchor = swRead
  ? (sections.flatMap((s) => s.checks).find((c) => c.concept === "remaining-performance-obligations")
    || sections.find((s) => s.heading === "The promise and the pay packet")?.checks?.[0]
    || null)
  : null;

// Enrich each check with the context it earns: the peer median where the metric is peer-comparable,
// and — on the anchor check — the filing's own language about the reliability of the numbers.
const enrich = (sec) => ({
  ...sec,
  // The provenance line rides the O&G reserves block itself — the figures it stands behind.
  ...(ogProv && sec.heading === OG_HEADING ? { ogProv } : {}),
  checks: sec.checks.map((c) => {
    let cc = peerCtx[c.title] ? { ...c, peer: peerCtx[c.title] } : c;
    if (eqTie && c === eqAnchor) cc = { ...cc, lang: eqTie.text, langTone: eqTie.tone };
    if (devTie && c.title === "Reserve development" && c.value !== "—") cc = { ...cc, dev: devTie };
    if (swRead && c === swAnchor) cc = { ...cc, sw: swRead };
    // The REIT read's two slots, matched by concept (titles vary with the data-missing
    // fallbacks): spreads on the yield-on-cost check — the pricing stand-in — and
    // occupancy beside the cash-payout check.
    if (reitRead && (reitRead.spreads.length || reitRead.spreadsWithheld.length) && c.concept === "roic") cc = { ...cc, reitSp: reitRead };
    if (reitRead && (reitRead.occupancy.length || reitRead.occupancyWithheld.length) && c.concept === "free-cash-flow") cc = { ...cc, reitOcc: reitRead };
    // The managed-care pricing slot: the MLR check itself (matched by title — the desk's
    // sibling checks share the medical-loss-ratio concept id).
    if (mcMlr && c.title === "Medical loss ratio") cc = { ...cc, mcMlr };
    return cc;
  }),
});
---

<section class="scorecard">
  <div class="head">
    <h3 class="secTitle">Owner’s Scorecard</h3>
    <div class="src">
      FY{company.fy} {company.form}
      {company.sourceUrl ? (
        <> · <a href={company.sourceUrl} target="_blank" rel="noopener">source on {company.market === "JP" ? "EDINET" : "SEC EDGAR"} →</a></>
      ) : null}
    </div>
  </div>

  {cockroach && (cockroach.materialWeakness || cockroach.restatement) ? (
    <div class="cockroach">
      {cockroach.materialWeakness ? <div class="ck"><span class="ckLabel">Material weakness in financial controls</span><blockquote class="ckq">“{ckTrim(cockroach.materialWeakness)}”</blockquote></div> : null}
      {cockroach.restatement ? <div class="ck"><span class="ckLabel">Restated past financials</span><blockquote class="ckq">“{ckTrim(cockroach.restatement)}”</blockquote></div> : null}
      <p class="ckNote">The figures below are only as sound as the controls that produced them.{company.sourceUrl ? <> <a href={company.sourceUrl} target="_blank" rel="noopener">read the note →</a></> : null}</p>
    </div>
  ) : null}

  {sample ? (
    <div class="sample">
      <strong>Sample data.</strong> Illustrative placeholders until the EDGAR pipeline runs.
      The “source” link is live.
    </div>
  ) : null}

  {sections.map(enrich).map((sec) => (
    <div class="section">
      <h4 class="secHead">{sec.heading}</h4>
      <ul class="checks">
        {sec.checks.map((c) => (
          <li>
            <div class="row">
              <span class="title">{c.concept ? <Term id={c.concept}>{c.title}</Term> : c.href ? <a href={c.href}>{c.title}</a> : c.title}</span>
              <span class="value" style={`color:${TONE_COLOR[c.tone]}`}>{c.value}</span>
            </div>
            <div class="label" style={`color:${TONE_COLOR[c.tone]}`}>{c.label}</div>
            {c.formula ? <div class="formula">{c.formula}</div> : null}
            {c.peer ? <div class="peer">{c.peer}</div> : null}
            {c.lang ? <p class="langTie" style={`border-color:${TONE_COLOR[c.langTone]}`}><span class="langMark" style={`color:${TONE_COLOR[c.langTone]}`}>In the filing’s words</span> {c.lang}</p> : null}
            {c.sw ? (
              <div class="devTie swTie">
                <span class="devMark">Retention and the customer ladder, in the filing’s words</span>
                {c.sw.nrr.map((r) => (
                  <div class="swRow">
                    <div class="swHead"><span class="swLabel">{r.label}</span><span class="swFig">{r.figure}</span></div>
                    <blockquote class="devQ">“{r.sentence}”</blockquote>
                    <span class="devCheck">✓ the figure is the sentence’s own characters{r.corroborated ? " · the prior filing’s figure agrees" : ""}</span>
                  </div>
                ))}
                {c.sw.withheld.map((w) => (
                  <p class="swWithheld">This filing and last year’s state different {w.year} figures for {w.label}, so neither is quoted as the fact here. Read both filings, linked above.</p>
                ))}
                {c.sw.ladder.map((r) => (
                  <div class="swRow">
                    <div class="swHead"><span class="swLabel">{r.cohort || (r.threshold ? "Customers from " + r.threshold : "Customer count")}</span><span class="swFig">{r.count}</span></div>
                    <blockquote class="devQ">“{r.sentence}”</blockquote>
                  </div>
                ))}
                {c.sw.tripwire.map((t) => (
                  <div class="swTrip">
                    <span class="swTripFlag">{t.flag === "REDEFINED" ? "This metric’s definition changed between filings" : "This metric’s precision changed between filings"}</span>
                    <blockquote class="devQ">“{t.current}”</blockquote>
                    <blockquote class="devQ swPriorQ">Last year’s filing: “{t.prior}”</blockquote>
                  </div>
                ))}
              </div>
            ) : null}
            {c.reitSp ? (
              <div class="devTie swTie">
                <span class="devMark">Re-leasing economics, in the filing’s words</span>
                {c.reitSp.spreads.map((r) => (
                  <div class="swRow">
                    <div class="swHead"><span class="swLabel">The landlord’s own pricing line</span><span class="swFig">{r.figures.join(" · ")}</span></div>
                    <blockquote class="devQ">“{r.sentence}”</blockquote>
                    <span class="devCheck">✓ every figure is the sentence’s own characters{r.tie ? ` · the sentence’s dollar pair ${r.tie.a} ÷ ${r.tie.b} computes to ${r.tie.computed}, tying the stated rate` : ""}</span>
                  </div>
                ))}
                {c.reitSp.spreadsWithheld.map((w) => (
                  <p class="swWithheld">A re-leasing sentence was withheld: {w.reason} (stated {w.stated}, computed {w.computed}). Neither figure is quoted as the fact — read the filing linked above.</p>
                ))}
              </div>
            ) : null}
            {c.reitOcc ? (
              <div class="devTie swTie">
                <span class="devMark">Occupancy at fiscal year end, in the filing’s words</span>
                {c.reitOcc.occupancy.map((r) => (
                  <div class="swRow">
                    <div class="swHead"><span class="swLabel">Occupancy, as filed — the scope is the sentence’s own words</span><span class="swFig">{r.figures.join(" · ")}</span></div>
                    <blockquote class="devQ">“{r.sentence}”</blockquote>
                  </div>
                ))}
                {c.reitOcc.occupancyWithheld.map((w) => (
                  <p class="swWithheld">Two same-scope occupancy sentences in this filing disagree, so neither is quoted as the fact here. Read the filing linked above.</p>
                ))}
                <span class="devCheck">✓ each figure is its sentence’s own characters, dated to the fiscal year end inside the sentence</span>
              </div>
            ) : null}
            {c.mcMlr ? (
              <div class="devTie swTie">
                <span class="devMark">Pricing against the trend, in the filing’s words</span>
                <div class="swRow">
                  {c.mcMlr.figs.length ? <div class="swHead"><span class="swLabel">{c.mcMlr.label}</span><span class="swFig">{c.mcMlr.figs.join(" · ")}</span></div> : null}
                  <blockquote class="devQ">“{c.mcMlr.sentence}”</blockquote>
                  <span class="devCheck">✓ {c.mcMlr.check}</span>
                </div>
              </div>
            ) : null}
            {c.dev ? (c.dev.conflict ? (
              <p class="devTie">
                <span class="devMark">In the filing’s words</span>
                Management’s narrative describes the year’s prior-year development as {toneWord(c.dev.narrativeTone)}, while the development line filed in the structured data is signed {toneWord(c.dev.filedTone)}. The two disagree, so neither is quoted as the fact here — read the filing linked above.
              </p>
            ) : (
              <div class="devTie">
                <span class="devMark">In the filing’s words</span>
                <blockquote class="devQ">“{c.dev.sentence}”</blockquote>
                <span class="devCheck">✓ {c.dev.check === "dollar" ? (c.dev.gapPct >= 0.5 ? `the narrated ${c.dev.narrated} sits ${c.dev.gapPct.toFixed(1)}% from the filed figure` : `the narrated ${c.dev.narrated} ties the filed figure`) : "direction matches the filed record"} · the words are the company’s</span>
              </div>
            )) : null}
            <details class="why"><summary>What this means</summary><p class="note">{c.note}</p></details>
          </li>
        ))}
      </ul>
      {sec.ogProv ? (
        <div class="devTie ogProv">
          <span class="devMark">Who stands behind these figures</span>
          {sec.ogProv.internal ? (
            <blockquote class="devQ">“{sec.ogProv.sentence}”</blockquote>
          ) : (
            sec.ogProv.firms.map((f) => (
              <div class="swRow">
                <span class="swLabel">{f.firm} — the filing’s word: “{f.verb}”{f.coverage ? <> — “{f.coverage.pct} {f.coverage.object}”</> : null}</span>
                <blockquote class="devQ">“{f.sentence}”</blockquote>
              </div>
            ))
          )}
          <span class="devCheck">{sec.ogProv.internal ? "✓ no independent petroleum engineering firm is named in the filing — the sentence is the filer’s own" : "✓ the verb and any coverage share are the sentence’s own characters — never normalized"}{company.sourceUrl ? <> · <a href={company.sourceUrl} target="_blank" rel="noopener">verify →</a></> : null}</span>
        </div>
      ) : null}
    </div>
  ))}

  {graham ? (
    <div class="section">
      <h4 class="secHead">Graham’s defensive tests{graham.testable ? ` · ${graham.passes} of ${graham.testable} met` : ""}</h4>
      <p class="durNote">Graham’s numerical criteria for the defensive investor (<em>The Intelligent Investor</em>, ch. 14), run on the filings. A floor of safety, not a buy signal; many fine modern businesses fail his strictest liquidity rules by design.</p>
      <ul class="report">
        {graham.tests.map((t) => (
          <li>
            <div class="factRow">
              <span class="factLabel">{t.name}</span>
              <span class="gbadge" style={`color:${TONE_COLOR[GTONE[t.status]]}; border-color:${TONE_COLOR[GTONE[t.status]]}`}>{GLABEL[t.status]}</span>
            </div>
            <div class="gcrit">{t.criterion} · <b>{t.value}</b></div>
            <details class="why"><summary>What this means</summary><p class="factNote">{t.note}</p></details>
          </li>
        ))}
      </ul>
    </div>
  ) : null}

  {report ? (
    <div class="section">
      <h4 class="secHead">Durability &amp; moat, {report.years[0]}–{report.years[report.years.length - 1]}</h4>
      <p class="durNote">Whether the record’s returns held, and what the capital reinvested earned.</p>
      <ul class="report">
        {report.facts.map((ft) => (
          <li>
            <div class="factRow">
              <span class="factLabel">{ft.label}</span>
              <span class="factValue" style={`color:${TONE_COLOR[ft.tone]}`}>{ft.value}</span>
            </div>
            {ft.lang ? <p class="langTie" style={`border-color:${TONE_COLOR[ft.langTone]}`}><span class="langMark" style={`color:${TONE_COLOR[ft.langTone]}`}>In the filing’s words</span> {ft.lang}</p> : null}
            <details class="why"><summary>What this means</summary><p class="factNote">{ft.note}</p></details>
          </li>
        ))}
      </ul>
    </div>
  ) : null}

  {/* CUT 2026-07-31 (owner ruling): the "Does AI threaten the moat?" panel — mostly noise. The
      aiRead extraction stays in the data for any future surface; the panel does not return
      without the owner. */}
  <p class="foot">
    All figures as filed; the source filing is linked above.
  </p>
</section>

<style>
