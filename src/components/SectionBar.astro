---
// The sticky company bar with section jump-nav, extracted verbatim from the US company page
// (UX survey 2026-07-31, item 16) so the JP and EU pages inherit the same orientation. Links
// whose target section rendered nothing prune themselves; the scroll-spy underlines the act in
// view and keeps the active tab scrolled into sight. Two additions over the original, both
// ruled in the survey: a right-edge fade signalling clipped tabs on a narrow screen (the record
// table's own affordance, mirrored), and a taller tap height on coarse pointers.
const { id = "top", label, sub = "", links = [] } = Astro.props;
---

<div class="cbar">
  <a class="cbar-id" href={`#${id}`}>{label}<span class="cbar-nm">{sub ? ` · ${sub}` : ""}</span></a>
  <nav class="secnav" aria-label="Sections">
    {links.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
  </nav>
  <div class="cbarFadeR" aria-hidden="true"></div>
</div>

<style>
  /* Sticky company bar, ticker always in view, plus section jump-nav. */
  .cbar {
    position: sticky; top: 0; z-index: 40; background: var(--paper);
    display: flex; align-items: center; gap: 12px;
    border-bottom: 1px solid var(--rule-strong); padding: 8px 0; margin: 12px 0 0;
  }
  .cbar-id { font-family: var(--sans); font-weight: 700; font-size: 14px; color: var(--ink); flex: 0 0 auto; }
  .cbar-id:hover { color: var(--accent); text-decoration: none; }
  .cbar-nm { font-weight: 500; color: var(--muted); font-size: 12.5px; }
  .secnav { display: flex; gap: 2px; overflow-x: auto; flex: 1 1 auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .secnav::-webkit-scrollbar { display: none; }
  .secnav a { flex: 0 0 auto; font-family: var(--sans); font-size: 11.5px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); padding: 4px 9px; white-space: nowrap; border-bottom: 2px solid transparent; }
  .secnav a:hover { color: var(--ink); text-decoration: none; }
  .secnav a.active { color: var(--ink); border-bottom-color: var(--accent); }
  /* The affordance that more tabs continue rightward off-screen (the record table's left-edge
     fade, mirrored). The script hides it when the tabs fit or the reader reaches the end. */
  .cbarFadeR { position: absolute; top: 0; bottom: 1px; right: 0; width: 26px; pointer-events: none; background: linear-gradient(to left, var(--paper), transparent); opacity: 0; transition: opacity 0.15s; }
  .cbarFadeR.on { opacity: 1; }
  /* Coarse pointers get a ~34px tap height on the tabs without changing the type. */
  @media (pointer: coarse) {
    .secnav a { padding: 9px 9px; }
  }
  @media (max-width: 560px) {
    .cbar-nm { display: none; }
  }
</style>

<script is:inline>
  (function () {
    const bar = document.querySelector(".cbar");
    if (!bar) return;
    const nav = bar.querySelector(".secnav");
    // Drop nav links whose section rendered nothing (e.g. a company with no proxy or filing data).
    nav.querySelectorAll("a").forEach((a) => {
      const el = document.getElementById(a.getAttribute("href").slice(1));
      if (!el || el.children.length === 0) a.remove();
    });
    const links = Array.from(nav.querySelectorAll("a"));
    const byId = {}; links.forEach((a) => (byId[a.getAttribute("href").slice(1)] = a));
    const targets = links.map((a) => document.getElementById(a.getAttribute("href").slice(1))).filter(Boolean);
    // The right-edge fade: visible only while tabs overflow and the reader hasn't reached the end.
    const fade = bar.querySelector(".cbarFadeR");
    if (fade) {
      const judge = () => fade.classList.toggle("on", nav.scrollWidth - nav.clientWidth - nav.scrollLeft > 4);
      judge();
      nav.addEventListener("scroll", judge, { passive: true });
      window.addEventListener("resize", judge, { passive: true });
    }
    if (!("IntersectionObserver" in window) || !targets.length) return;
    let active = null;
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const a = byId[e.target.id];
        if (!a || a === active) return;
        if (active) active.classList.remove("active");
        a.classList.add("active"); active = a;
        const l = a.offsetLeft, r = l + a.offsetWidth;
        if (l < nav.scrollLeft) nav.scrollLeft = l - 12;
        else if (r > nav.scrollLeft + nav.clientWidth) nav.scrollLeft = r - nav.clientWidth + 12;
      });
    }, { rootMargin: "-15% 0px -75% 0px", threshold: 0 });
    targets.forEach((t) => obs.observe(t));
  })();
</script>
