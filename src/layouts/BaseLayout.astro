---
import SiteSearch from "../components/SiteSearch.astro";
import { dataAsOf, fmtAsOf } from "../lib/freshness.mjs";
import { SITE_NAME, DEFAULT_DESCRIPTION } from "../lib/seo.mjs";
import { GROUPINGS } from "../lib/groupingColumns.mjs";
// The random door's targets: the 28 grouping slugs, serialized into the inline script below.
const groupingSlugs = GROUPINGS.map((g) => g.slug);
const {
  title = "Owner Scorecard",
  description = DEFAULT_DESCRIPTION,
  ogType = "website",
  jsonLd = null,
  noindex = false,
  // A page may carry its own 1200×630 link-preview card (the company pages point at their
  // build-time card in /og/ — scripts/buildOgImages.mjs); everything else shares the default.
  // A path only: the layout resolves it against the site host like the canonical above.
  ogImage = "/og-default.png",
  ogImageAlt = null,
} = Astro.props;
// The masthead carries the DATA's vintage (the pipeline's own as-of stamps), not the build clock, so
// stale data shows as stale rather than wearing today's date. Falls back to nothing if unstamped.
const refreshed = fmtAsOf(dataAsOf);
// Canonical points at the configured site host, which must be the host that actually serves the
// content. Pages pass jsonLd (an object or array) for structured data; the layout only serializes.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" id="themeColorMeta" content="#15161a" />
    <script is:inline>
      /* Set the theme before first paint to avoid a flash. Dark is the default;
         a reader's saved choice (light) is honored. The theme-color meta (declared above, so
         it exists when this runs) is synced here too, not just in the end-of-body script, so a
         light-theme reader never sees dark browser chrome while the page parses. */
      (function () {
        try {
          var t = localStorage.getItem("oss-theme");
          var light = t === "light";
          document.documentElement.dataset.theme = light ? "light" : "dark";
          var m = document.querySelector('meta[name="theme-color"]');
          if (m && light) m.setAttribute("content", "#fcfcfa");
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogImageAlt ? <meta property="og:image:alt" content={ogImageAlt} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
    ))}
    <link rel="alternate" type="application/rss+xml" title="Owner Scorecard" href="/rss.xml" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />

    <style is:global>
      /* Self-hosted variable fonts (OFL licensed): no third-party request, no reader IP reported
         to Google, no render-blocking cross-origin stylesheet. One file per family covers the
         weight range; latin subset (the fallback stack covers anything outside it). */
      @font-face {
        font-family: "Fraunces"; font-style: normal; font-weight: 500 600; font-display: swap;
        src: url(/fonts/fraunces.woff2) format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Fraunces"; font-style: italic; font-weight: 500; font-display: swap;
        src: url(/fonts/fraunces-italic.woff2) format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Inter"; font-style: normal; font-weight: 400 700; font-display: swap;
        src: url(/fonts/inter.woff2) format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      :root {
        --serif: "Fraunces", Georgia, "Times New Roman", serif;
        --sans: "Inter", system-ui, -apple-system, Segoe UI, Roboto, sans-serif;

        /* Light theme (the toggle's alternate; dark is the default below). */
        --paper: #fcfcfa;
        --surface: #ffffff;       /* cards, inputs, sticky backgrounds */
        --surface-2: #f6f5f1;     /* row hover, subtle fills */
        --ink: #18191d;
        --ink-soft: #2c2f36;      /* body text */
        --ink-dim: #3a3e46;       /* secondary body text */
        --muted: #5b616c;
        --faint: #8b909a;
        --rule: #e4e3dd;
        --rule-soft: #eeede7;
        --rule-strong: #16181d;

        --accent: #1b3b6f;        /* ink blue — links, brand marks */
        --accent-tint: #eef2f8;
        --accent-ink: #ffffff;    /* text on a solid accent fill */
        --solid: #18191d;         /* a selected chip's fill */
        --solid-ink: #ffffff;     /* text on the solid fill */
        --good: #1a7a3c;
        --bad: #8b1a1a;
        --warn: #9a6a00;
        --info: #1b3b6f;
        --tag-bg: #f0efe9;
        --tag-ink: #565961;
        --warn-bg: #fff7e6;
        --warn-border: #e0c98a;
        --warn-ink: #7a5b00;
        --shadow: rgba(20, 22, 28, 0.06);
        /* Categorical data-viz fills (allocation bars, segment mix). */
        --viz-1: #2c3038; --viz-2: #2e7d6b; --viz-3: #a86b52; --viz-4: #9c8f6e;
        --viz-5: #5f7355; --viz-6: #5a6b7a; --viz-muted: #cfcec8;
      }

      /* Dark theme — the default. Warm near-black, off-white ink: an editorial,
         terminal-grade reading surface, not pure black on pure white inverted. */
      :root[data-theme="dark"] {
        --paper: #15161a;
        --surface: #1c1e23;
        --surface-2: #24262c;
        --ink: #ecebe4;
        --ink-soft: #cfcec6;
        --ink-dim: #a9a8a0;
        --muted: #8c8b84;
        --faint: #67665f;
        --rule: #2c2e34;
        --rule-soft: #232429;
        --rule-strong: #474851;

        --accent: #8aabe0;
        --accent-tint: #1b2431;
        --accent-ink: #0f1218;
        --solid: #ecebe4;
        --solid-ink: #15161a;
        --good: #57c47e;
        --bad: #e67f77;
        --warn: #dcb052;
        --info: #8aabe0;
        --tag-bg: #292b31;
        --tag-ink: #b6b5ad;
        --warn-bg: #28220f;
        --warn-border: #564a2b;
        --warn-ink: #dcb052;
        --shadow: rgba(0, 0, 0, 0.35);
        --viz-1: #c9ced7; --viz-2: #5cc1a1; --viz-3: #d29c80; --viz-4: #c4b68e;
        --viz-5: #95b285; --viz-6: #8ca5bf; --viz-muted: #494b51;
      }

      :root { color-scheme: light; }
      :root[data-theme="dark"] { color-scheme: dark; }

      * { box-sizing: border-box; }

      /* The hidden attribute always wins. Without this, any element styled display:flex/grid
         silently overrides the browser's [hidden] { display:none }, and a script toggling
         .hidden appears to do nothing — a class of bug this guard retires site-wide. */
      [hidden] { display: none !important; }

      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

      body {
        font-family: var(--sans);
        font-size: 17px;
        line-height: 1.6;
        color: var(--ink);
        background: var(--paper);
        max-width: 880px;
        margin: 0 auto;
        padding: 0 20px 64px;
        font-feature-settings: "kern" 1;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3, h4 {
        font-family: var(--serif);
        font-weight: 600;
        line-height: 1.15;
        letter-spacing: -0.01em;
        color: var(--ink);
        text-wrap: balance;
      }
      h1 { font-size: clamp(30px, 5vw, 42px); }
      h2 { font-size: clamp(22px, 3.4vw, 27px); }
      h3 { font-size: 20px; }

      /* In-act section heading: one consistent level below the act titles (the act h2s), so a
         company page reads act → section → detail. Components apply it to their main heading
         instead of styling a bare h2, which used to render as large as the act above it. */
      .secTitle { font-size: clamp(18px, 2.3vw, 21px); font-weight: 600; line-height: 1.2; margin: 0; }

      p { margin: 0 0 14px; }

      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 2px; }

      /* A visible, theme-aware focus ring for keyboard navigation. */
      :where(a, button, input, select, [tabindex]):focus-visible {
        outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px;
      }

      ::selection { background: var(--accent-tint); color: var(--ink); }

      .tnum { font-variant-numeric: tabular-nums; }

      /* ---- masthead ---- */
      .masthead { margin: 26px 0 22px; }
      .mastRule { border: 0; border-top: 1px solid var(--rule-strong); margin: 0; }
      .mastRuleThin { border: 0; border-top: 1px solid var(--rule); margin: 0; }

      .mastBar {
        display: flex; align-items: baseline; justify-content: space-between;
        gap: 16px; flex-wrap: wrap; padding: 14px 0 12px;
      }
      .brand {
        font-family: var(--serif);
        font-weight: 600;
        font-size: clamp(28px, 6vw, 38px);
        letter-spacing: -0.02em;
        color: var(--ink);
        line-height: 1;
      }
      .brand:hover { text-decoration: none; }
      .dateline {
        font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase;
        color: var(--muted); font-weight: 500;
      }

      .nav {
        display: flex; gap: 22px; flex-wrap: wrap;
        padding: 9px 0;
        font-size: 14px; letter-spacing: 0.02em;
      }
      .nav a {
        color: var(--ink); font-weight: 500; text-transform: uppercase;
        font-size: 12.5px; letter-spacing: 0.07em;
      }
      .nav a:hover { color: var(--accent); text-decoration: none; }

      /* The search affordance: a pill that reads as the primary action, sitting just left of the
         section links. Opens the site-wide search overlay (or, on the home page, its own box). */
      .navSearch {
        display: inline-flex; align-items: center; gap: 7px; cursor: pointer;
        font-family: var(--sans); color: var(--ink-dim); background: var(--surface);
        border: 1px solid var(--rule-strong); border-radius: 999px; padding: 5px 11px;
        font-size: 12px; letter-spacing: 0.04em; line-height: 1;
      }
      .navSearch:hover { border-color: var(--accent); color: var(--accent); }
      .navSearch svg { width: 14px; height: 14px; flex: 0 0 auto; }
      .navSearch .navSearchTxt { text-transform: uppercase; letter-spacing: 0.07em; font-weight: 600; font-size: 12px; }
      .navSearch kbd {
        font-family: var(--sans); font-size: 10.5px; font-weight: 600; color: var(--muted);
        border: 1px solid var(--rule); border-radius: 3px; padding: 1px 5px; line-height: 1.2; background: var(--paper);
      }
      @media (max-width: 520px) { .navSearch kbd { display: none; } .navSearch { padding: 5px 10px; } }

      .themeToggle {
        margin-left: auto; background: none; border: 1px solid var(--rule-strong);
        color: var(--ink); width: 32px; height: 26px; border-radius: 3px; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center; font-size: 13px;
        line-height: 1; padding: 0; align-self: center;
      }
      .themeToggle:hover { border-color: var(--accent); color: var(--accent); }
      .ttSun { display: none; } .ttMoon { display: inline; }
      :root[data-theme="dark"] .ttSun { display: inline; }
      :root[data-theme="dark"] .ttMoon { display: none; }

      main { margin-top: 22px; }

      /* ---- footer ---- */
      footer { border-top: 1px solid var(--rule-strong); margin-top: 48px; padding-top: 16px; }
      footer .colophon {
        font-family: var(--serif); font-size: 14px; color: var(--muted); margin: 0 0 10px;
      }
      footer small { display: block; color: var(--faint); font-size: 12px; line-height: 1.5; }

      @media (max-width: 520px) {
        body { font-size: 16px; padding: 0 14px 48px; }
        .nav { gap: 16px; }
      }

      /* Cross-document view transitions, CSS only: a soft cross-fade with the masthead held
         steady across navigations, in browsers that support it; others ignore it entirely.
         Deliberately NOT Astro's ClientRouter — the inline scripts assume full-page lifecycle. */
      @view-transition { navigation: auto; }
      .masthead { view-transition-name: masthead; }

      /* Skip link: the first focusable element on every page, visible only on focus, so a
         keyboard reader is not forced through the masthead's controls 3,550 times. */
      .skipLink {
        position: absolute; left: -9999px; top: 0; z-index: 100;
        background: var(--solid); color: var(--solid-ink);
        padding: 8px 14px; border-radius: 0 0 6px 0; font-family: var(--sans); font-size: 13px;
      }
      .skipLink:focus { left: 0; }

      /* Print: the record on paper. Dark is the site's default theme, and printed dark theme is
         near-white ink on white paper, so print forces the light palette and drops the chrome.
         The brand and the data-as-of dateline stay: a filed page should carry its provenance. */
      @media print {
        :root, :root[data-theme="dark"] {
          --paper: #ffffff; --surface: #ffffff; --surface-2: #f6f5f1;
          --ink: #18191d; --ink-soft: #2c2f36; --ink-dim: #3a3e46;
          --muted: #5b616c; --faint: #8b909a;
          --rule: #d8d7d1; --rule-soft: #e6e5df; --rule-strong: #16181d;
          --accent: #1b3b6f; --accent-tint: #ffffff; --accent-ink: #ffffff;
          --solid: #18191d; --solid-ink: #ffffff;
          --good: #1a7a3c; --bad: #8b1a1a; --warn: #9a6a00; --info: #1b3b6f;
          --tag-bg: #f0efe9; --tag-ink: #565961; --shadow: none;
        }
        body { background: #ffffff; color: #18191d; max-width: none; padding: 0; font-size: 12.5px; }
        .nav, .navSearch, .themeToggle, .skipLink, footer small { display: none !important; }
        .masthead { margin: 0 0 14px; }
        a { color: inherit; text-decoration: none; }
        main { margin-top: 0; }
      }
    </style>
  </head>

  <body>
    <a class="skipLink" href="#main">Skip to content</a>
    <header class="masthead">
      <hr class="mastRule" />
      <div class="mastBar">
        <a class="brand" href="/">Owner Scorecard</a>
        <div class="dateline">An independent research publication{refreshed ? ` · data as of ${refreshed}` : ""}</div>
      </div>
      <hr class="mastRuleThin" />
      <nav class="nav">
        <button id="siteSearchOpen" class="navSearch" type="button" aria-label="Search companies" title="Search companies  ( / )">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="navSearchTxt">Search</span>
          <kbd aria-hidden="true">/</kbd>
        </button>
        <a href="/catalog">Catalog</a>
        <a href="/groupings">Groupings</a>
        <a href="/compare">Compare</a>
        <a href="/concepts">Principles</a>
        <a href="/wire">Wire</a>
        <a href="/notes">Notes</a>
        <a href="/groupings" id="openAnywhere" title="A uniformly random grouping — one shelf's comparative table">Open anywhere</a>
        <a href="/account">Account</a>
        <button id="themeToggle" class="themeToggle" type="button" aria-label="Switch between light and dark theme" title="Switch theme">
          <span class="ttSun" aria-hidden="true">☀</span><span class="ttMoon" aria-hidden="true">☾</span>
        </button>
      </nav>
      <hr class="mastRule" />
    </header>

    <main id="main">
      <slot />
    </main>

    <SiteSearch />

    <footer>
      <p class="colophon">Owner Scorecard · <a href="/about">About this publication</a> · <a href="/docs/data">Data endpoints</a> · <a href="/rss.xml">RSS</a></p>
      <small>
        Owner Scorecard is an independent publisher of financial research and is not registered as an investment adviser or broker-dealer.
        This material is for informational and educational purposes only and does not constitute investment, tax, or legal advice, or a recommendation to buy or sell any security.
        Figures are drawn from public SEC filings and believed reliable, but accuracy and completeness are not guaranteed.
        Any positions or results mentioned are the author's own and may change at any time without notice.
        Past performance is not indicative of future results; do your own research and consult a qualified professional before investing.
      </small>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById("themeToggle");
        var meta = document.getElementById("themeColorMeta");
        function syncMeta() {
          if (!meta) return;
          var dark = document.documentElement.dataset.theme !== "light";
          meta.setAttribute("content", dark ? "#15161a" : "#fcfcfa");
        }
        syncMeta();
        if (!btn) return;
        btn.addEventListener("click", function () {
          var cur = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
          var next = cur === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem("oss-theme", next); } catch (e) {}
          syncMeta();
        });
      })();
    </script>

    <script is:inline define:vars={{ groupingSlugs }}>
      /* "Open anywhere": the uniform random door, opening a GROUPING — a shelf of comparables,
         not a lone security (the owner's call: the browse surface is the comparative table).
         The 28 slugs are serialized at build from the same stored list the /groupings pages are
         built from, so the door can never point at a route that doesn't exist. Uniform draw —
         weighting by size would be an implicit ranking. Without JS, the anchor's own href
         (/groupings) is the door. */
      (function () {
        var door = document.getElementById("openAnywhere");
        if (!door || !groupingSlugs || !groupingSlugs.length) return;
        door.addEventListener("click", function (e) {
          e.preventDefault();
          window.location.href = "/groupings/" + groupingSlugs[Math.floor(Math.random() * groupingSlugs.length)];
        });
      })();
    </script>
  </body>
</html>
